{
	"providerId": "mailbluster.com",
	"providerName": "MailBluster",
	"serviceId": "sender-verification-mailbluster-smtp",
	"serviceName": "MailBluster Email Sender Verification (MailBluster SMTP)",
	"version": 1,
	"logoUrl": "https://mailbluster.com/wp-content/themes/mailbluster/resources/assets/images/mailbluster-logo.svg",
	"description": "Configures DKIM, DMARC, Return Path, and Tracking DNS records for MailBluster email sender verification using MailBluster SMTP",
	"syncPubKeyDomain": "mailbluster.com",
	"syncRedirectDomain": "mailbluster.com",
	"syncBlock": false,
	"shared": false,
	"multiInstance": true,
	"hostRequired": false,
	"records": [
		{
			"groupId": "dkim",
			"type": "CNAME",
			"host": "%dkimSelector%._domainkey",
			"pointsTo": "dkim.%whitelabelDomain%",
			"ttl": 3600
		},
		{
			"groupId": "dmarc",
			"type": "TXT",
			"host": "_dmarc",
			"data": "v=DMARC1; p=none;",
			"txtConflictMatchingMode": "Prefix",
			"txtConflictMatchingPrefix": "v=DMARC1",
			"essential": "OnApply",
			"ttl": 3600
		},
		{
			"groupId": "returnpath",
			"type": "CNAME",
			"host": "%returnPathSelector%",
			"pointsTo": "return.%whitelabelDomain%",
			"ttl": 3600
		},
		{
			"groupId": "tracking",
			"type": "CNAME",
			"host": "%trackingHost%",
			"pointsTo": "track.%whitelabelDomain%",
			"ttl": 3600
		}
	]
}
