{
  "providerId": "gradientsites.com",
  "providerName": "GradientSites",
  "serviceId": "subdomain",
  "serviceName": "Website on a subdomain",
  "version": 1,
  "logoUrl": "https://app.gradientsites.com/images/logo.svg",
  "description": "Points a subdomain, such as shop.example.com, at a website hosted by GradientSites.",
