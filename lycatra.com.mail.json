{
  "providerId": "lycatra.com",
  "providerName": "Lycatra",
  "serviceId": "mail",
  "serviceName": "Lycatra Mail",
  "version": 1,
  "logoUrl": "https://lycatra.com/icon.svg",
  "description": "Connects a domain to Lycatra Mail: proves ownership, lets Lycatra send for the domain (DKIM and bounce domain), and optionally receive its mail.",
  "variableDescription": "verify: ownership token from Lycatra. dkim1-dkim3: Amazon SES Easy DKIM tokens for this domain. mxid: label of Lycatra's inbound endpoint (the part before .mail-manager-smtp.amazonaws.com). gsv: Google Postmaster Tools verification token.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.lycatra.com",
  "syncRedirectDomain": "lycatra.com",
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "_lycatra",
      "data": "lycatra-verify=%verify%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "lycatra-verify="
    },
    {
      "groupId": "send",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "send",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "send",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "send",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.eu-north-1.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "send",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "receive",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mxid%.mail-manager-smtp.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },
    {
      "groupId": "postmaster",
      "type": "TXT",
      "host": "@",
      "data": "google-site-verification=%gsv%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
