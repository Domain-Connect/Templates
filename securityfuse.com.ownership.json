{
  "providerId": "securityfuse.com",
  "providerName": "SecurityFuse",
  "serviceId": "ownership",
  "serviceName": "SecurityFuse ownership verification",
  "version": 1,
  "logoUrl": "https://securityfuse.com/assets/brand/securityfuse-mark.svg",
  "description": "Adds one TXT record that lets SecurityFuse confirm you control this domain before Deep scans. It does not change website, email or routing records.",
  "variableDescription": "verification: the SecurityFuse-issued verification value for this domain claim",
  "syncBlock": false,
  "syncPubKeyDomain": "securityfuse.com",
  "syncRedirectDomain": "app.securityfuse.com",
  "multiInstance": true,
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_securityfuse-verification",
      "data": "securityfuse-verification=%verification%",
      "ttl": 300,
      "txtConflictMatchingMode": "None"
    }
  ]
}
