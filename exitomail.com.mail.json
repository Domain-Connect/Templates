{
  "providerId": "exitomail.com",
  "providerName": "ExitoMail",
  "serviceId": "mail",
  "serviceName": "ExitoMail email hosting",
  "version": 1,
  "logoUrl": "https://exitomail.com/icon.svg",
  "description": "Connects a domain to ExitoMail hosted email: ownership proof, MX, SPF (merged with SPFM), two DKIM keys (RSA and Ed25519), optional DMARC, mail app autoconfiguration (autoconfig/autodiscover CNAMEs and SRV), and optional MTA-STS with TLS reporting. Groups: verify, outbound, mail, clients, dmarc, mtasts. The service applies 'mail' (MX) only once the customer is ready to switch incoming mail, and 'dmarc' only when the domain has no DMARC record.",
  "variableDescription": "token: per-domain ownership token (hex). dkimRsaSelector/dkimEdSelector: DKIM selectors generated by our mail server, e.g. v1-rsa-20261015. dkimRsa/dkimEd: base64 DKIM public keys (p= value; RSA SPKI, raw Ed25519 per RFC 8463). mtastsId: MTA-STS policy id (alphanumeric).",
  "syncBlock": false,
  "syncPubKeyDomain": "exitomail.com",
  "syncRedirectDomain": "exitomail.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "_exitomail",
      "data": "exitomail-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "exitomail-verification=",
      "essential": "OnApply"
    },
    {
      "groupId": "outbound",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.exitomail.com"
    },
    {
      "groupId": "outbound",
      "type": "TXT",
      "host": "%dkimRsaSelector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimRsa%",
      "ttl": 3600
    },
    {
      "groupId": "outbound",
      "type": "TXT",
      "host": "%dkimEdSelector%._domainkey",
      "data": "v=DKIM1; k=ed25519; p=%dkimEd%",
      "ttl": 3600
    },
    {
      "groupId": "mail",
      "type": "MX",
      "host": "@",
      "pointsTo": "mail.exitomail.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "clients",
      "type": "CNAME",
      "host": "autoconfig",
      "pointsTo": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "clients",
      "type": "CNAME",
      "host": "autodiscover",
      "pointsTo": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "clients",
      "type": "SRV",
      "name": "@",
      "service": "_imaps",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 993,
      "target": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "clients",
      "type": "SRV",
      "name": "@",
      "service": "_submissions",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 465,
      "target": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "clients",
      "type": "SRV",
      "name": "@",
      "service": "_submission",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 587,
      "target": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "mtasts",
      "type": "TXT",
      "host": "_mta-sts",
      "data": "v=STSv1; id=%mtastsId%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=STSv1",
      "essential": "OnApply"
    },
    {
      "groupId": "mtasts",
      "type": "CNAME",
      "host": "mta-sts",
      "pointsTo": "mail.exitomail.com",
      "ttl": 3600
    },
    {
      "groupId": "mtasts",
      "type": "TXT",
      "host": "_smtp._tls",
      "data": "v=TLSRPTv1; rua=mailto:tls-reports@exitomail.com",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=TLSRPTv1",
      "essential": "OnApply"
    }
  ]
}
