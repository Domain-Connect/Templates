{
  "providerId": "publisher.taibasoft.com",
  "providerName": "Taibasoft",
  "serviceId": "ses-dkim",
  "serviceName": "Smart Publisher Email",
  "version": 1,
  "description": "Authenticate email sending using Amazon SES Easy DKIM. Does not change MX or website records.",
  "syncPubKeyDomain": "dc-keys.publisher.taibasoft.com",
  "syncRedirectDomain": "publisher.taibasoft.com",
  "variableDescription": "dkim1, dkim2, dkim3: the three SES Easy DKIM selectors for the sender identity",
  "records": [
    { "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 }
  ]
}
