{
    "providerId": "your-webmail.de",
    "providerName": "your-webmail.de",
    "serviceId": "mail",
    "serviceName": "E-Mail Hosting",
    "version": 1,
    "logoUrl": "https://webmail.your-webmail.de/branding/custom/webmail-icon.svg",
    "description": "Connects a domain to your-webmail.de mail hosting: MX, SPF (merged), DKIM, DMARC, ownership verification, autoconfig/autodiscover and RFC 6186/8314 SRV records.",
    "variableDescription": "%verifytoken%: per-domain ownership token; %dkimselector%: DKIM selector label; %dkimkey%: base64 RSA public key (p= value of the DKIM record); %dmarcpolicy%: none, quarantine or reject",
    "sharedProviderName": true,
    "shared": true,
    "syncBlock": false,
    "syncPubKeyDomain": "your-webmail.de",
    "syncRedirectDomain": "resellingprovider.de,your-webmail.de",
    "records": [
        {
            "groupId": "verify",
            "type": "TXT",
            "host": "_your-webmail-verification",
            "data": "your-webmail-verification=%verifytoken%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "your-webmail-verification=",
            "essential": "OnApply"
        },
        {
            "groupId": "mx",
            "type": "MX",
            "host": "@",
            "pointsTo": "mx1.your-webmail.de",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mx",
            "type": "MX",
            "host": "@",
            "pointsTo": "mx2.your-webmail.de",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mx",
            "type": "MX",
            "host": "@",
            "pointsTo": "mx3.your-webmail.de",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mx",
            "type": "MX",
            "host": "@",
            "pointsTo": "mx4.your-webmail.de",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "spf",
            "type": "SPFM",
            "host": "@",
            "spfRules": "include:spf.your-webmail.de"
        },
        {
            "groupId": "dkim",
            "type": "TXT",
            "host": "%dkimselector%._domainkey",
            "data": "v=DKIM1; k=rsa; p=%dkimkey%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DKIM1"
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=%dmarcpolicy%; rua=mailto:postmaster@%fqdn%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        },
        {
            "groupId": "autoconfig",
            "type": "CNAME",
            "host": "autoconfig",
            "pointsTo": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "autoconfig",
            "type": "CNAME",
            "host": "autodiscover",
            "pointsTo": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "srv",
            "type": "SRV",
            "name": "@",
            "service": "_imaps",
            "protocol": "_tcp",
            "priority": 0,
            "weight": 1,
            "port": 993,
            "target": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "srv",
            "type": "SRV",
            "name": "@",
            "service": "_submissions",
            "protocol": "_tcp",
            "priority": 0,
            "weight": 1,
            "port": 465,
            "target": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "srv",
            "type": "SRV",
            "name": "@",
            "service": "_jmap",
            "protocol": "_tcp",
            "priority": 0,
            "weight": 1,
            "port": 443,
            "target": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "srv",
            "type": "SRV",
            "name": "@",
            "service": "_caldavs",
            "protocol": "_tcp",
            "priority": 0,
            "weight": 1,
            "port": 443,
            "target": "mail.your-webmail.de",
            "ttl": 3600
        },
        {
            "groupId": "srv",
            "type": "SRV",
            "name": "@",
            "service": "_carddavs",
            "protocol": "_tcp",
            "priority": 0,
            "weight": 1,
            "port": 443,
            "target": "mail.your-webmail.de",
            "ttl": 3600
        }
    ]
}
