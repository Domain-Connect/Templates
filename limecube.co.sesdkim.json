{
  "providerId": "limecube.co",
  "providerName": "Limecube",
  "serviceId": "sesdkim",
  "serviceName": "Limecube CRM email (Amazon SES)",
  "version": 1,
  "logoUrl": "https://storage.googleapis.com/limecube-live-adfcaef2/root%2FMisc%2FLimecube-logo.png",
  "description": "The three Easy DKIM CNAME records Amazon SES needs to verify a sending domain for Limecube CRM. Each value is a 32 character token from the customer's own Amazon SES.",
  "variableDescription": "dkim1, dkim2, dkim3: the three Easy DKIM tokens Amazon SES issued for this domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "limecube.co",
  "syncRedirectDomain": "crm.limecube.co",
  "hostRequired": false,
  "records": [
    { "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 }
  ]
}
