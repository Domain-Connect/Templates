{
  "providerId": "nuve.sh",
  "providerName": "nuve",
  "serviceId": "email",
  "serviceName": "nuve Email",
  "version": 1,
  "logoUrl": "https://nuve.sh/apple-icon.png",
  "description": "Send and receive email for this domain through the nuve mail platform: ownership verification, MX, SPF, DKIM and DMARC.",
  "variableDescription": "%verification%: ownership token issued by nuve for this domain; %dkim%: base64 DKIM public key generated by nuve for this domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "nuve.sh",
  "syncRedirectDomain": "nuve.sh",
  "records": [
    { "type": "TXT", "host": "@", "data": "nuve-mail-verification=%verification%", "ttl": 3600, "essential": "Always", "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "nuve-mail-verification=" },
    { "type": "MX", "host": "@", "pointsTo": "mail.nuve.sh", "priority": 10, "ttl": 3600, "essential": "Always" },
    { "type": "SPFM", "host": "@", "spfRules": "mx a:mail.nuve.sh" },
    { "type": "TXT", "host": "mail._domainkey", "data": "v=DKIM1; k=rsa; p=%dkim%", "ttl": 3600, "essential": "Always", "txtConflictMatchingMode": "All" },
    { "type": "TXT", "host": "_dmarc", "data": "v=DMARC1; p=quarantine; rua=mailto:postmaster@%domain%; fo=1", "ttl": 3600, "essential": "OnApply", "txtConflictMatchingMode": "All" }
  ]
}
