{
    "providerId": "waid.pro",
    "providerName": "Waid",
    "serviceId": "email-sender",
    "serviceName": "Waid - remetente de e-mail",
    "version": 1,
    "description": "Autoriza a Waid a enviar e-mails da sua área de membros com o seu domínio (Amazon SES): DKIM, MAIL FROM e SPF.",
    "variableDescription": "%dkim1%, %dkim2%, %dkim3%: seletores DKIM que o Amazon SES gerou para este domínio; %mailfrom%: subdomínio de MAIL FROM escolhido no cadastro do remetente (padrão: correio)",
    "syncBlock": false,
    "syncPubKeyDomain": "waid.pro",
    "syncRedirectDomain": "waid.io,waid.pro,curseduca.pro",
    "records": [
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "mailfrom",
            "type": "MX",
            "host": "%mailfrom%",
            "pointsTo": "feedback-smtp.us-east-1.amazonses.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mailfrom",
            "type": "SPFM",
            "host": "%mailfrom%",
            "spfRules": "include:amazonses.com"
        }
    ]
}
