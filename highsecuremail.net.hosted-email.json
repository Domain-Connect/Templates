{
  "providerId": "highsecuremail.net",
  "providerName": "DATCG HighSecureMail",
  "serviceId": "hosted-email",
  "serviceName": "HighSecureMail Hosted Email",
  "version": 4,
  "description": "Points a domain's mail to HighSecureMail: MX, SPF (merge), DKIM (RSA-2048), DMARC, and client autodiscovery (autoconfig/autodiscover/MTA-STS/webmail).",
  "variableDescription": "sel_rsa/key_rsa: the domain's DKIM selector and base64 public key, read from the mail platform after the domain is created. mtastsid: MTA-STS policy id (monotonic). verify: domain ownership token issued by the mail platform (TXT at apex).",
  "syncBlock": false,
  "syncPubKeyDomain": "highsecuremail.com",
  "syncRedirectDomain": "highsecuremail.com,highsecuremail.net",
  "records": [
    {
      "type": "MX",
      "groupId": "mail",
      "host": "@",
      "pointsTo": "mx1.highsecuremail.net",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "groupId": "mail",
      "host": "@",
      "spfRules": "include:_spf.highsecuremail.net"
    },
    {
      "type": "TXT",
      "groupId": "mail",
      "host": "@",
      "data": "highsecuremail-verification=%verify%",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "type": "TXT",
      "groupId": "mail",
      "host": "%sel_rsa%._domainkey",
      "data": "v=DKIM1; k=rsa; h=sha256; p=%key_rsa%",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "groupId": "mail",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc@highsecuremail.net; fo=1",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },
    {
      "type": "CNAME",
      "groupId": "discovery",
      "host": "autoconfig",
      "pointsTo": "mx1.highsecuremail.net",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "discovery",
      "host": "autodiscover",
      "pointsTo": "mx1.highsecuremail.net",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "discovery",
      "host": "mta-sts",
      "pointsTo": "mx1.highsecuremail.net",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "discovery",
      "host": "email",
      "pointsTo": "mx1.highsecuremail.net",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "groupId": "discovery",
      "host": "_mta-sts",
      "data": "v=STSv1; id=%mtastsid%",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=STSv1"
    }
  ]
}
