{
  "providerId": "valiqai.com",
  "providerName": "ValiqAI",
  "serviceId": "site-verification",
  "serviceName": "Site verification",
  "version": 1,
  "logoUrl": "https://www.valiqai.com/icon.svg",
  "description": "Adds one TXT record that proves you own the domain, so ValiqAI can run tests against your site.",
  "variableDescription": "token: the per-domain verification token generated by ValiqAI",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.valiqai.com",
  "syncRedirectDomain": "valiqai.com,www.valiqai.com",
  "records": [
    {
      "type": "TXT",
      "host": "_valiq-site-verification",
      "data": "valiq-site-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
