{
  "providerId": "sitevelox.com",
  "providerName": "SiteVelox",
  "serviceId": "speed",
  "serviceName": "SiteVelox website acceleration",
  "version": 1,
  "logoUrl": "https://sitevelox.com/assets/logo.png",
  "description": "Points www and the root domain to SiteVelox, which serves a faster version of your existing website. Email records are not changed.",
  "variableDescription": "acme1, acme2: certificate validation tokens; owner: hostname ownership token (issued per domain by SiteVelox)",
  "syncBlock": false,
  "syncPubKeyDomain": "sitevelox.com",
  "sharedProviderName": false,
  "syncRedirectDomain": "sitevelox.com",
  "hostRequired": false,
  "records": [
    { "type": "TXT", "host": "_acme-challenge.www", "data": "%acme1%", "ttl": 300, "txtConflictMatchingMode": "None" },
    { "type": "TXT", "host": "_acme-challenge.www", "data": "%acme2%", "ttl": 300, "txtConflictMatchingMode": "None" },
    { "type": "TXT", "host": "_cf-custom-hostname.www", "data": "%owner%", "ttl": 300, "txtConflictMatchingMode": "All" },
    { "type": "CNAME", "host": "www", "pointsTo": "fallback.sitevelox.com", "ttl": 300 },
    { "type": "A", "host": "@", "pointsTo": "104.21.60.223", "ttl": 300 },
    { "type": "A", "host": "@", "pointsTo": "172.67.201.243", "ttl": 300 }
  ]
}
