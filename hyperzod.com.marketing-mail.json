{
  "providerId": "hyperzod.com",
  "providerName": "Hyperzod",
  "serviceId": "marketing-mail",
  "serviceName": "Hyperzod Mail",
  "version": 2,
  "logoUrl": "https://www.hyperzod.com/images/hyperzod_logo.png",
  "syncBlock": false,
  "syncPubKeyDomain": "hyperzod.com",
  "description": "Adds DKIM and a return-path subdomain so a store can send email through Hyperzod Mail (Amazon SES).",
  "variableDescription": "dkim1-3 are the Amazon SES Easy DKIM tokens for the domain; region is the SES region of the return-path MX.",
  "records": [
    { "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "MX", "host": "bounce", "pointsTo": "feedback-smtp.%region%.amazonses.com", "priority": 10, "ttl": 3600 },
    { "type": "SPFM", "host": "bounce", "spfRules": "include:amazonses.com" }
  ]
}
