{
  "providerId": "sadorra.app",
  "providerName": "Sadorra",
  "serviceId": "email",
  "serviceName": "Sadorra newsletter sending domain",
  "version": 1,
  "logoUrl": "https://sadorra.app/img/mark-512.png",
  "description": "Adds the three DKIM records that let Sadorra send your newsletter from this domain. Existing email, website and SPF records are not changed.",
  "variableDescription": "dkim1, dkim2, dkim3: the DKIM tokens Amazon SES issued for this domain, as Sadorra shows them.",
  "syncBlock": false,
  "syncPubKeyDomain": "sadorra.app",
  "syncRedirectDomain": "sadorra.app,studio.sadorra.app",
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    }
  ]
}
