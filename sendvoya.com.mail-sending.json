{
  "providerId": "sendvoya.com",
  "providerName": "Sendvoya",
  "serviceId": "mail-sending",
  "serviceName": "Mail Sending and Mailboxes",
  "sharedServiceName": true,
  "version": 2,
  "logoUrl": "https://app.sendvoya.com/favicon.svg",
  "description": "Configure Sendvoya email authentication, delivery and hosted mailbox discovery. Apply group sending for sending only, or sending,mailbox for hosted mailboxes.",
  "variableDescription": "dkimselector and dkimpublickey are generated by Sendvoya for the selected sending domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "sendvoya.com",
  "syncRedirectDomain": "app.sendvoya.com,sendvoya.com",
  "records": [
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.sendvoya.com",
      "ttl": 3600,
      "groupId": "sending"
    },
    {
      "type": "SPFM",
      "host": "svy",
      "spfRules": "include:_spf.sendvoya.com",
      "ttl": 3600,
      "groupId": "sending"
    },
    {
      "type": "TXT",
      "host": "%dkimselector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimpublickey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DKIM1",
      "groupId": "sending"
    },
    {
      "type": "MX",
      "host": "bounce-svy",
      "pointsTo": "mta01.mx.sendvoya.com",
      "priority": 10,
      "ttl": 3600,
      "groupId": "sending"
    },
    {
      "type": "SPFM",
      "host": "bounce-svy",
      "spfRules": "include:_spf.sendvoya.com",
      "ttl": 3600,
      "groupId": "sending"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; sp=none; adkim=r; aspf=r;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply",
      "groupId": "sending"
    },
    {
      "type": "CNAME",
      "host": "go-svy",
      "pointsTo": "track.sendvoya.com",
      "ttl": 3600,
      "groupId": "sending"
    },
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "mta01.mx.sendvoya.com",
      "priority": 10,
      "ttl": 3600,
      "groupId": "mailbox"
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_imaps",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 993,
      "target": "imap.sendvoya.com",
      "ttl": 3600,
      "groupId": "mailbox"
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_submission",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 587,
      "target": "smtp.sendvoya.com",
      "ttl": 3600,
      "groupId": "mailbox"
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_submissions",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 465,
      "target": "smtp.sendvoya.com",
      "ttl": 3600,
      "groupId": "mailbox"
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_autodiscover",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "app.sendvoya.com",
      "ttl": 3600,
      "groupId": "mailbox"
    }
  ]
}
