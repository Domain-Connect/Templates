{
    "providerId": "runearc.com",
    "providerName": "Runearc",
    "serviceId": "mail",
    "serviceName": "Runearc email",
    "version": 2,
    "logoUrl": "https://runearc.com/icon.svg",
    "description": "Sends and receives email for a domain or mail subdomain through Runearc. Groups: mx (receive), dkim (mb1 selector), dmarc (only when the domain has no DMARC record yet), bounce (Amazon SES custom MAIL FROM MX and SPF). Apply on the root with no host, or on a subdomain with host.",
    "variableDescription": "dkimKey: the base64 DKIM public key Runearc generated for this domain (the p= tag).",
    "syncBlock": false,
    "sharedProviderName": false,
    "hostRequired": false,
    "syncPubKeyDomain": "runearc.com",
    "syncRedirectDomain": "runearc.com,app.runearc.com",
    "records": [
        {
            "groupId": "mx",
            "type": "MX",
            "host": "@",
            "pointsTo": "mx.runearc.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "TXT",
            "host": "mb1._domainkey",
            "data": "v=DKIM1; k=rsa; p=%dkimKey%",
            "ttl": 3600,
            "txtConflictMatchingMode": "All"
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none; rua=mailto:dmarc@runearc.com",
            "ttl": 3600,
            "txtConflictMatchingMode": "All",
            "essential": "OnApply"
        },
        {
            "groupId": "bounce",
            "type": "MX",
            "host": "bounce",
            "pointsTo": "feedback-smtp.us-east-1.amazonses.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "spf",
            "type": "SPFM",
            "host": "bounce",
            "spfRules": "include:amazonses.com"
        }
    ]
}
