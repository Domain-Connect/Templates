{
  "providerId": "agentsmail.io",
  "providerName": "AgentsMail",
  "serviceId": "sending-domain",
  "serviceName": "Domaine d'envoi AgentsMail",
  "version": 1,
  "logoUrl": "https://agentsmail.io/logo.png",
  "description": "Configure votre domaine pour l'envoi d'e-mails avec AgentsMail : preuve de propriete, signature DKIM, domaine de retour et politique DMARC.",
  "variableDescription": "challenge : jeton de preuve de propriete. dkim1, dkim2, dkim3 : selecteurs DKIM emis par Amazon SES. mxtarget : hote de collecte des retours, dependant de la region SES.",
  "syncBlock": false,
  "syncPubKeyDomain": "agentsmail.io",
  "syncRedirectDomain": "agentsmail.io",
  "shared": false,
  "records": [
    {
      "type": "TXT",
      "host": "_agentmail-challenge",
      "data": "%challenge%",
      "ttl": 1800,
      "txtConflictMatchingMode": "All",
      "essential": "Always"
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 1800,
      "essential": "Always"
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 1800,
      "essential": "Always"
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 1800,
      "essential": "Always"
    },
    {
      "type": "MX",
      "host": "mail",
      "pointsTo": "%mxtarget%",
      "priority": 10,
      "ttl": 1800
    },
    {
      "type": "SPFM",
      "host": "mail",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 1800,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    }
  ]
}
