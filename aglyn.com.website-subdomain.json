{
  "providerId": "aglyn.com",
  "providerName": "Aglyn",
  "serviceId": "website-subdomain",
  "serviceName": "Aglyn website on a subdomain",
  "version": 1,
  "logoUrl": "https://raw.githubusercontent.com/aglyn/aglyn/main/apps/tenant/public/_static/images/brand/aglyn-logo-500x500.png",
  "description": "Points one subdomain (for example shop.example.com) at an Aglyn website.",
  "variableDescription": "No variables. The subdomain is the host the template is applied to.",
  "syncPubKeyDomain": "aglyn.com",
  "syncRedirectDomain": "app.aglyn.com",
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "sites.aglyn.app",
      "ttl": 3600
    }
  ]
}
