{
  "providerId": "chaudie.com",
  "providerName": "Chaudie",
  "serviceId": "website",
  "serviceName": "Chaudie website",
  "version": 2,
  "logoUrl": "https://chaudie.com/favicon.svg",
  "description": "Points www at the business's Chaudie website, and sends the bare domain to www. Adds a TXT record showing the domain is the business's. Email records are not changed.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "chaudie.com",
  "syncRedirectDomain": "app.chaudie.com",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_chaudie",
      "data": "chaudie-site=%token%",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "sites.chaudiesites.com",
      "ttl": 3600
    },
    {
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%domain%"
    }
  ]
}
