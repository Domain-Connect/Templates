{
  "providerId": "commandagi.com",
  "providerName": "CommandAGI",
  "version": 1,
  "logoUrl": "https://commandagi.com/apple-touch-icon.png",
  "variableDescription": "verification: the domain's ownership token at CommandAGI; dkim1, dkim2, dkim3: the DKIM tokens Amazon SES issues for the domain",
  "syncPubKeyDomain": "commandagi.com",
  "syncRedirectDomain": "commandagi.com,commandagi.app",
  "serviceId": "mail",
  "serviceName": "CommandAGI Mail",
  "description": "Receives and sends the mail of a domain with CommandAGI (through Amazon SES): an ownership TXT record, the MX record, the SPF include and three DKIM CNAME records.",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "commandagi-verification=%verification%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "commandagi-verification="
    },
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.us-east-2.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    }
  ]
}
