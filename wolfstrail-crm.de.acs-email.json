{
  "providerId": "wolfstrail-crm.de",
  "providerName": "Wolfstrail",
  "serviceId": "acs-email",
  "serviceName": "Wolfstrail Kampagnen (E-Mail-Versand)",
  "version": 1,
  "logoUrl": "https://app.wolfstrail-crm.de/logo.png",
  "description": "Authenticates a sending domain for email campaigns sent via Wolfstrail (Azure Communication Services): domain-ownership TXT, SPF, and two DKIM CNAMEs.",
  "variableDescription": "%verify%: the ms-domain-verification TXT value of the domain from Azure Communication Services.",
  "syncBlock": false,
  "sharedProviderName": true,
  "sharedServiceName": true,
  "syncRedirectDomain": "app.wolfstrail-crm.de",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "ms-domain-verification=%verify%",
      "ttl": 3600,
      "groupId": "verify",
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "ms-domain-verification="
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.protection.outlook.com",
      "groupId": "spf",
      "essential": "OnApply"
    },
    {
      "type": "CNAME",
      "host": "selector1-azurecomm-prod-net._domainkey",
      "pointsTo": "selector1-azurecomm-prod-net._domainkey.azurecomm.net",
      "ttl": 3600,
      "groupId": "dkim",
      "essential": "OnApply"
    },
    {
      "type": "CNAME",
      "host": "selector2-azurecomm-prod-net._domainkey",
      "pointsTo": "selector2-azurecomm-prod-net._domainkey.azurecomm.net",
      "ttl": 3600,
      "groupId": "dkim",
      "essential": "OnApply"
    }
  ]
}
