{
  "providerId": "oblipali.app",
  "providerName": "Oblipali",
  "serviceId": "email-sending",
  "serviceName": "Oblipali email sending",
  "version": 1,
  "logoUrl": "https://oblipali.app/favicon.svg",
  "description": "Lets Oblipali send your store's emails from a subdomain of your domain (for example mail.yourstore.com): DKIM signature, bounce handling (MX and SPF) and DMARC. Your usual mailbox is not affected.",
  "variableDescription": "dkimkey: DKIM public key generated for this subdomain (without the p= prefix). region: sending region of the bounce server, for example eu-west-1.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "oblipali.app",
  "syncRedirectDomain": "oblipali.app",
  "hostRequired": true,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
