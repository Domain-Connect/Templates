{
  "providerId": "socialloop.ai",
  "providerName": "SocialLoop",
  "serviceId": "email",
  "serviceName": "SocialLoop — send invitations from your own domain",
  "version": 1,
  "logoUrl": "https://socialloop.ai/logo.svg",
  "description": "Authorises SocialLoop to send event invitations from your domain: DKIM, the return-path (MX + SPF), its CNAME fallback, and a DMARC policy.",
  "syncBlock": false,
  "syncPubKeyDomain": "mailsocialloop.com",
  "syncRedirectDomain": "socialloop.ai",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "%dkim%",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "%mxhost%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "send",
      "data": "%spf%",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "rsend",
      "pointsTo": "%rsend%",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=quarantine; rua=mailto:dmarc@mailsocialloop.com",
      "ttl": 3600
    }
  ]
}
