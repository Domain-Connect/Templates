{
  "providerId": "relaydns.dev",
  "providerName": "RelayDNS",
  "serviceId": "relay-email",
  "serviceName": "Set up a sending domain",
  "version": 1,
  "logoUrl": "https://relaydns.dev/relaydns-logo-on-light.svg",
  "description": "Adds the DKIM, SPF, DMARC and bounce records a domain needs before it can send authenticated email.",
  "variableDescription": "selector: the DKIM selector the sending platform issued for this domain. dkimkey: the base64 public half of that DKIM keypair. region: the AWS region the sending infrastructure runs in, for example eu-north-1. dmarcto: the mailbox DMARC aggregate reports are sent to.",
  "syncPubKeyDomain": "relaydns.dev",
  "syncBlock": false,
  "syncRedirectDomain": "api.relaydns.dev,relaydns.dev",
  "records": [
    {
      "type": "TXT",
      "host": "%selector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "mail",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "mail",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=quarantine; rua=mailto:%dmarcto%; adkim=s; aspf=s",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    }
  ]
}
