{
  "providerId": "staykurious.studio",
  "providerName": "Stay Kurious",
  "serviceId": "website",
  "serviceName": "Stay Kurious website",
  "version": 1,
  "logoUrl": "https://www.staykurious.studio/apple-icon.png",
  "description": "Points a domain at a website built and hosted by Stay Kurious. Email (MX) records are not touched.",
  "variableDescription": "ip is the site's A record address and cname its CNAME target, both assigned per site by the host; verification is a one-time ownership token, only needed when the domain was used on another hosting account",
  "syncPubKeyDomain": "domainconnect.staykurious.studio",
  "syncRedirectDomain": "hub.staykurious.studio",
  "records": [
    {
      "type": "A",
      "groupId": "apex",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 600
    },
    {
      "type": "CNAME",
      "groupId": "apex",
      "host": "www",
      "pointsTo": "%cname%",
      "ttl": 600
    },
    {
      "type": "TXT",
      "groupId": "verification",
      "host": "_vercel",
      "data": "vc-domain-verify=%verification%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "vc-domain-verify=",
      "ttl": 600
    }
  ]
}
