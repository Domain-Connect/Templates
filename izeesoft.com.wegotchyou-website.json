{
  "providerId": "izeesoft.com",
  "providerName": "WeGotchYou",
  "serviceId": "wegotchyou-website",
  "serviceName": "WeGotchYou website",
  "version": 1,
  "logoUrl": "https://gotcha.izeesoft.com/icon.png",
  "description": "Points your domain at your WeGotchYou website and proves you own it.",
  "variableDescription": "ip: the WeGotchYou server address; verification: the ownership code shown on your Domains page",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "izeesoft.com",
  "syncRedirectDomain": "gotcha.izeesoft.com",
  "hostRequired": false,
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 3600
    },
    {
      "type": "A",
      "host": "www",
      "pointsTo": "%ip%",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_wegotchyou",
      "data": "wegotchyou-verification=%verification%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "wegotchyou-verification="
    }
  ]
}
