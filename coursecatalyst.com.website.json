{
  "providerId": "coursecatalyst.com",
  "providerName": "Course Catalyst",
  "serviceId": "website",
  "serviceName": "Course Catalyst website",
  "version": 1,
  "description": "Connect your website and verify domain ownership. Keep email records and nameservers unchanged.",
  "syncPubKeyDomain": "coursecatalyst.com",
  "syncRedirectDomain": "app.coursecatalyst.com",
  "records": [
    {
      "groupId": "apex",
      "type": "A",
      "host": "@",
      "pointsTo": "%ipv4%",
      "ttl": 3600
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%wwwTarget%",
      "ttl": 3600
    },
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "_vercel",
      "data": "%verification%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
