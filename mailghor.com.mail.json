{
  "providerId": "mailghor.com",
  "providerName": "Mailghor",
  "serviceId": "mail",
  "serviceName": "Business email",
  "version": 1,
  "logoUrl": "https://mailghor.com/favicon.svg",
  "description": "Sets up a domain for email hosted by Mailghor: ownership, mail delivery (MX), SPF, DKIM, DMARC, MTA-STS, TLS reporting and mail app autoconfiguration.",
  "variableDescription": "verifytoken: ownership token; mailhost: Mailghor mail server; dkimhost/dkimvalue: the domain's DKIM selector and key; dmarc, mtasts, tlsrpt, uaconfig: the domain's policy records.",
  "syncBlock": false,
  "syncPubKeyDomain": "mailghor.com",
  "syncRedirectDomain": "mailghor.com",
  "hostRequired": false,
  "records": [
    { "type": "TXT", "host": "_mailghor", "data": "mailghor-verification=%verifytoken%", "ttl": 3600 },
    { "type": "MX", "host": "@", "pointsTo": "%mailhost%", "priority": 10, "ttl": 3600 },
    { "type": "SPFM", "host": "@", "spfRules": "mx" },
    { "type": "TXT", "host": "%dkimhost%", "data": "%dkimvalue%", "ttl": 3600 },
    { "type": "TXT", "host": "_dmarc", "data": "%dmarc%", "ttl": 3600 },
    { "type": "TXT", "host": "_mta-sts", "data": "%mtasts%", "ttl": 3600 },
    { "type": "TXT", "host": "_smtp._tls", "data": "%tlsrpt%", "ttl": 3600 },
    { "type": "TXT", "host": "_ua-auto-config", "data": "%uaconfig%", "ttl": 3600 },
    { "type": "CNAME", "host": "mta-sts", "pointsTo": "%mailhost%", "ttl": 3600 },
    { "type": "CNAME", "host": "autoconfig", "pointsTo": "%mailhost%", "ttl": 3600 },
    { "type": "CNAME", "host": "autodiscover", "pointsTo": "%mailhost%", "ttl": 3600 },
    { "type": "CNAME", "host": "ua-auto-config", "pointsTo": "%mailhost%", "ttl": 3600 },
    {
      "type": "SRV",
      "name": "@",
      "service": "_imaps",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 993,
      "target": "%mailhost%",
      "ttl": 3600
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_submissions",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 465,
      "target": "%mailhost%",
      "ttl": 3600
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_pop3s",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 995,
      "target": "%mailhost%",
      "ttl": 3600
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_jmap",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "%mailhost%",
      "ttl": 3600
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_caldavs",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "%mailhost%",
      "ttl": 3600
    },
    {
      "type": "SRV",
      "name": "@",
      "service": "_carddavs",
      "protocol": "_tcp",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "%mailhost%",
      "ttl": 3600
    }
  ]
}
