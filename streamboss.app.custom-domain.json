{
  "providerId": "streamboss.app",
  "providerName": "StreamBoss",
  "serviceId": "custom-domain",
  "serviceName": "StreamBoss custom domain",
  "version": 2,
  "logoUrl": "https://streamboss.app/domain-connect/logo.svg",
  "description": "Points your address at your StreamBoss workspace and sets up the email records it needs to send from the notify subdomain of your domain.",
  "variableDescription": "Group web: cnameTarget is where the address points, ownershipHost and ownershipValue prove the domain is yours. Group sending, applied under the notify subdomain: spfHost and spfRules authorize StreamBoss to send email, mxValue and mxPriority route its bounces on the fixed send address, rsendValue completes its return path on the fixed rsend address, dkimHost and dkimValue sign that email.",
  "syncPubKeyDomain": "streamboss.app",
  "syncRedirectDomain": "streamboss.app,codstreamingjp.com",
  "syncBlock": false,
  "hostRequired": true,
  "records": [
    {
      "groupId": "web",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%cnameTarget%",
      "ttl": 3600
    },
    {
      "groupId": "web",
      "type": "TXT",
      "host": "%ownershipHost%",
      "data": "%ownershipValue%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "%spfHost%",
      "spfRules": "%spfRules%"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "send",
      "pointsTo": "%mxValue%",
      "priority": "%mxPriority%",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "rsend",
      "pointsTo": "%rsendValue%",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "%dkimHost%",
      "data": "%dkimValue%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
