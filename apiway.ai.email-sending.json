{
  "providerId": "apiway.ai",
  "providerName": "Apiway",
  "serviceId": "email-sending",
  "serviceName": "Apiway Email Marketing",
  "version": 1,
  "logoUrl": "https://apiway.ai/icons/logo.svg",
  "description": "Lets Apiway Email Marketing send campaigns from your domain: DKIM signing keys, the SPF include for Amazon SES, and a domain-ownership record.",
  "variableDescription": "dkim1, dkim2, dkim3: the Amazon SES DKIM tokens for this domain; verify: Apiway's ownership token for this domain",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.apiway.ai",
  "syncRedirectDomain": "apiway.ai,studio.apiway.ai",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "host": "_apiway-verify",
      "data": "apiway-verification=%verify%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
