{
  "providerId": "findabis.com",
  "providerName": "Findabis",
  "serviceId": "website-root-proxied",
  "serviceName": "Findabis website (whole domain, behind your proxy)",
  "version": 1,
  "logoUrl": "https://findabis.com/domain-connect/logo.svg",
  "description": "Points your domain (yourbrand.com) at the website you run on Findabis, keeping your proxy on. Adds the two records that let Findabis verify the domain and issue its certificate. Email and other records are not changed.",
  "syncPubKeyDomain": "findabis.com",
  "syncRedirectDomain": "findabis.com",
  "syncBlock": false,
  "hostRequired": false,
  "records": [
    { "type": "A", "host": "@", "pointsTo": "%ip4%", "ttl": 3600 },
    { "type": "AAAA", "host": "@", "pointsTo": "%ip6%", "ttl": 3600 },
    { "type": "TXT", "host": "_fly-ownership", "data": "app-%flyapp%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "type": "CNAME", "host": "_acme-challenge", "pointsTo": "%fqdn%.%flyapp%.flydns.net", "ttl": 3600 }
  ]
}
