{
  "hostRequired": false,
  "providerId": "hitos.ai",
  "providerName": "HitOS",
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.%dkimzone%",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.%dkimzone%",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.%dkimzone%",
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "%mailfrom%",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "%mailfrom%",
      "ttl": 3600,
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "essential": "OnApply",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },
    {
      "groupId": "links",
      "type": "CNAME",
      "host": "%links%",
      "pointsTo": "%linktarget%.hitos.ai",
      "ttl": 3600
    }
  ],
  "serviceId": "email",
  "serviceName": "Email sending",
  "syncBlock": false,
  "syncPubKeyDomain": "hitos.ai",
  "syncRedirectDomain": "hitos.ai",
  "version": 2,
  "logoUrl": "https://app.hitos.ai/favicon.svg"
}
