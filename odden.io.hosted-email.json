{
  "providerId": "odden.io",
  "providerName": "Odden",
  "serviceId": "hosted-email",
  "serviceName": "Odden hosted email",
  "version": 1,
  "logoUrl": "https://odden.io/favicon.svg",
  "description": "Lets a workspace in Odden Cloud send email from the customer's own domain through Amazon SES: three Easy DKIM CNAMEs and a custom MAIL FROM subdomain (MX and SPF) for bounces. A recommended DMARC record is in a separate group that Odden does not request unless the customer asks for it.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the Amazon SES Easy DKIM tokens issued for the domain. %region%: the AWS region of the SES account, which names the bounce-handling MX host (for example us-east-2).",
  "syncBlock": false,
  "syncPubKeyDomain": "odden.io",
  "syncRedirectDomain": "cloud.odden.io",
  "records": [
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
