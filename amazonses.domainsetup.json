{
  "providerId": "amazonses",
  "providerName": "Amazon SES",
  "serviceId": "domainsetup",
  "serviceName": "Domain Setup",
  "version": 1,
  "description": "Publishes the DNS records relevant for a domain for sending with Amazon SES",
  "syncPubKeyDomain": "domainconnect.amazonses.com",

  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkimSelector1%._domainkey",
      "pointsTo": "%dkimSelector1%.%dkimZone%.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkimSelector2%._domainkey",
      "pointsTo": "%dkimSelector2%.%dkimZone%.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkimSelector3%._domainkey",
      "pointsTo": "%dkimSelector3%.%dkimZone%.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },

    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "%mailFromHost%",
      "pointsTo": "feedback-smtp.%sesFeedbackZone%",
      "priority": 10,
      "ttl": 3600,
      "essential": "OnApply"
    },

    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "%mailFromHost%",
      "spfRules": "include:amazonses.com"
    },

    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=%dmarcPolicy%%rua%",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },

    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "%trackingHost%",
      "pointsTo": "%trackingTarget%",
      "ttl": 3600,
      "essential": "OnApply"
    },

    {
      "groupId": "bimi",
      "type": "TXT",
      "host": "default._bimi",
      "data": "v=BIMI1; l=%bimiLogoUrl%%bimiCertificate%",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=BIMI1"
    }
  ]
}
