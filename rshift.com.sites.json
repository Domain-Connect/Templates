{
  "providerId": "rshift.com",
  "providerName": "RShift",
  "serviceId": "sites",
  "serviceName": "RShift Sites",
  "version": 2,
  "logoUrl": "https://www.rshift.com/favicon.svg",
  "description": "Connect a custom domain to RShift Sites and configure its DNS verification records.",
  "variableDescription": "target: one routing hostname label. Choose exactly one routing group from the current checked CNAME: routing for shift.fyi or routingHelp for tidy.help. ownership: Cloudflare for SaaS ownership TXT; certificate1 and certificate2: Cloudflare-issued ACME TXT values. Before SSL readiness select verification TXT groups only.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.rshift.com",
  "syncRedirectDomain": "app.rshift.com",
  "records": [
    {
      "groupId": "routing",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%target%.shift.fyi",
      "ttl": 600
    },
    {
      "groupId": "routingHelp",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%target%.tidy.help",
      "ttl": 600
    },
    {
      "groupId": "ownership",
      "type": "TXT",
      "host": "_cf-custom-hostname",
      "data": "%ownership%",
      "ttl": 600
    },
    {
      "groupId": "certificate1",
      "type": "TXT",
      "host": "_acme-challenge",
      "data": "%certificate1%",
      "ttl": 600
    },
    {
      "groupId": "certificate2",
      "type": "TXT",
      "host": "_acme-challenge",
      "data": "%certificate2%",
      "ttl": 600
    }
  ],
  "hostRequired": true
}
