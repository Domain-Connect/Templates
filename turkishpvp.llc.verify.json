{
  "providerId": "turkishpvp.llc",
  "providerName": "TurkishPvP LLC",
  "serviceId": "verify",
  "serviceName": "Domain ownership check",
  "version": 1,
  "logoUrl": "https://turkishpvp.llc/brand/logo-club.webp",
  "description": "Adds the TXT record that proves to TurkishPvP LLC that you own this domain or subdomain.",
  "variableDescription": "token is the whole TXT value shown in the TurkishPvP LLC client area, tpvp-site-verification= followed by a random code.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "turkishpvp.llc",
  "syncRedirectDomain": "turkishpvp.llc",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_tpvp-verify",
      "data": "%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "tpvp-site-verification="
    }
  ]
}
