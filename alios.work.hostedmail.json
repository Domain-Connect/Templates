{
  "providerId": "alios.work",
  "providerName": "Alios",
  "serviceId": "hostedmail",
  "serviceName": "Alios Mail Hosting",
  "version": 4,
  "logoUrl": "https://alios.work/vite.svg",
  "description": "Hosted email for your domain on Alios (MX, SPF, DKIM, DMARC and ownership verification).",
  "syncBlock": false,
  "syncPubKeyDomain": "alios.work",
  "syncRedirectDomain": "alios.work",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "alios-verify=%verifytoken%",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "mail.alios.work",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "mx"
    },
    {
      "type": "TXT",
      "host": "%dkimselector%._domainkey",
      "data": "v=DKIM1; k=ed25519; h=sha256; p=%dkimkey%",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "%dkimselector2%._domainkey",
      "data": "v=DKIM1; k=rsa; h=sha256; p=%dkimkey2%",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=reject; rua=mailto:postmaster@%domain%",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "autoconfig",
      "pointsTo": "mail.alios.work",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "autodiscover",
      "pointsTo": "mail.alios.work",
      "ttl": 3600
    }
  ],
  "variableDescription": "verifytoken is the per-domain ownership token generated by Alios; dkimselector/dkimkey and dkimselector2/dkimkey2 are the ed25519 and RSA DKIM selector and public-key pairs generated by the Alios mail server (the RSA pair is required by Gmail)."
}
