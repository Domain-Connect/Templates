{
  "providerId": "izie.top",
  "providerName": "izie.top",
  "serviceId": "account-verify",
  "serviceName": "izie.top account verification",
  "version": 1,
  "logoUrl": "https://izie.top/favicon.svg",
  "description": "Adds one TXT record that proves you own this domain for your izie.top account. Nothing else on the domain changes.",
  "variableDescription": "token: the verification code from your izie.top account page",
  "syncBlock": false,
  "syncPubKeyDomain": "izie.top",
  "syncRedirectDomain": "account.izie.top",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_izie-verify",
      "data": "izie-verify=%token%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "izie-verify="
    }
  ]
}
