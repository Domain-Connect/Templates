{
  "providerId": "usedayroom.com",
  "providerName": "Dayroom",
  "version": 1,
  "syncPubKeyDomain": "domainconnect.usedayroom.com",
  "syncRedirectDomain": "app.usedayroom.com",
  "syncBlock": false,
  "serviceId": "email-delivery",
  "serviceName": "Connect your company email to Dayroom",
  "records": [
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "mx1.dayroom.com.ng",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "mx",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "%dkimSelector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimPublicKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ],
  "logoUrl": "https://app.usedayroom.com/assets/email/dayroom-logo-dark.png",
  "description": "Route incoming company mail to Dayroom and authorize sending. Existing mailboxes must be prepared before approval.",
  "variableDescription": "dkimSelector: RSA selector generated by Dayroom; dkimPublicKey: base64 encoded RSA public key."
}
