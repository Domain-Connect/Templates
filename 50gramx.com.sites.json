{
  "providerId": "50gramx.com",
  "providerName": "50GRAMx",
  "serviceId": "sites",
  "serviceName": "50GRAMx Sites",
  "version": 1,
  "logoUrl": "https://50gramx.com/icon.svg",
  "description": "Serves a website from the 50GRAMx network on this domain or subdomain, and proves which 50GRAMx account owns it.",
  "variableDescription": "target: the site's network name (e.g. saturn-crux-50gramx-50.gramx.50gramx.com); owner: the owner's DID; ip4/ip6: the edge addresses, used only for a bare domain",
  "syncBlock": false,
  "syncPubKeyDomain": "dc.50gramx.com",
  "syncRedirectDomain": "50gramx.com",
  "hostRequired": false,
  "records": [
    { "groupId": "sub", "type": "CNAME", "host": "@", "pointsTo": "%target%", "ttl": 3600 },
    { "groupId": "apex", "type": "A", "host": "@", "pointsTo": "%ip4%", "ttl": 3600 },
    { "groupId": "apex", "type": "AAAA", "host": "@", "pointsTo": "%ip6%", "ttl": 3600 },
    { "type": "TXT", "host": "_epn", "data": "epn-owner=%owner%", "ttl": 3600, "txtConflictMatchingMode": "All" }
  ]
}
