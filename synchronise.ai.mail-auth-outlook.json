{
  "providerId": "synchronise.ai",
  "providerName": "Synchronise AI",
  "serviceId": "mail-auth-outlook",
  "serviceName": "Email authentication (Microsoft 365)",
  "version": 1,
  "description": "Authorises Microsoft 365 to send email as this domain (SPF) and publishes a monitoring-only DMARC policy. Applied when a business connects its Microsoft 365 mailbox to Synchronise AI.",
  "syncBlock": false,
  "syncPubKeyDomain": "synchronise.ai",
  "syncRedirectDomain": "synchronise.ai",
  "hostRequired": false,
  "records": [
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.protection.outlook.com"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc@%domain%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
