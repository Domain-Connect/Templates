{
  "providerId": "outflare.ai",
  "providerName": "Outflare",
  "serviceId": "resend",
  "serviceName": "Sending domain (Resend)",
  "version": 1,
  "logoUrl": "https://outflare.ai/brand/png/outflare-mark-black-256.png",
  "description": "Lets Resend send email for the domain from your own Resend account: DKIM, a sending subdomain (send) with its SPF, and a DMARC policy when there is none.",
  "variableDescription": "dkim: the DKIM public key (p=...); region: Resend's sending region (us-east-1)",
  "syncBlock": false,
  "syncPubKeyDomain": "outflare.ai",
  "syncRedirectDomain": "app.outflare.ai",
  "records": [
    {
      "type": "TXT",
      "groupId": "dkim",
      "host": "resend._domainkey",
      "data": "%dkim%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "groupId": "mailfrom",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "ttl": 3600,
      "priority": 10
    },
    {
      "type": "SPFM",
      "groupId": "mailfrom",
      "host": "send",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "groupId": "dmarc",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
