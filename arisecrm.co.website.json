{
  "providerId": "arisecrm.co",
  "providerName": "ARISE",
  "serviceId": "website",
  "serviceName": "ARISE Website",
  "version": 2,
  "logoUrl": "https://arisecrm.co/logo.png",
  "description": "Points your domain at your new ARISE website and lets Google show your site in search. Your email records are not changed.",
  "variableDescription": "token is the Google Search Console verification value for your domain.",
  "syncPubKeyDomain": "arisecrm.co",
  "syncRedirectDomain": "arisecrm.app.n8n.cloud",
  "syncBlock": false,
  "records": [
    { "type": "A", "host": "@", "pointsTo": "216.150.1.1", "ttl": 600 },
    { "type": "CNAME", "host": "www", "pointsTo": "cname.vercel-dns.com", "ttl": 600 },
    { "type": "TXT", "host": "@", "data": "google-site-verification=%token%", "ttl": 600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "google-site-verification=" }
  ]
}
