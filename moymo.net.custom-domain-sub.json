{
  "providerId": "moymo.net",
  "providerName": "Moymo",
  "serviceId": "custom-domain-sub",
  "serviceName": "Moymo custom domain (subdomain)",
  "version": 1,
  "logoUrl": "https://moymo.net/favicon.svg",
  "description": "Shows your Moymo profile page on a name under your own domain, and proves the domain is yours.",
  "variableDescription": "target is the name Moymo serves from. token is the secret Moymo checks to confirm the domain is yours.",
  "syncPubKeyDomain": "moymo.net",
  "syncRedirectDomain": "moymo.net",
  "syncBlock": false,
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%target%",
      "ttl": 300
    },
    {
      "type": "TXT",
      "host": "_moymo-challenge",
      "data": "moymo-verify=%token%",
      "ttl": 300,
      "txtConflictMatchingMode": "All"
    }
  ]
}
