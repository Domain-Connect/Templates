{
  "providerId": "mozmail.org",
  "providerName": "MozMail",
  "serviceId": "email-zoho",
  "serviceName": "MozMail email for your domain (Zoho Mail delivery)",
  "version": 1,
  "logoUrl": "https://mail.mozmail.org/m/icons/icon-512.png",
  "description": "Connect your domain to MozMail where mail is delivered through MozMail's Zoho Mail organisation (MX, SPF, DKIM and ownership verification).",
  "variableDescription": "zohoCode: Zoho domain verification code; zohoZone: Zoho data centre suffix (com, eu, in, com.au, jp, ca, sa); dkimSelector: Zoho DKIM selector; dkimKey: Zoho DKIM public key; dmarcPolicy: none, quarantine or reject",
  "syncPubKeyDomain": "mozmail.org",
  "syncRedirectDomain": "mail.mozmail.org",
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "@",
      "data": "zoho-verification=%zohoCode%.zmverify.zoho.%zohoZone%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "zoho-verification="
    },
    { "groupId": "inbound", "type": "MX", "host": "@", "pointsTo": "mx.zoho.%zohoZone%", "priority": 10, "ttl": 3600 },
    { "groupId": "inbound", "type": "MX", "host": "@", "pointsTo": "mx2.zoho.%zohoZone%", "priority": 20, "ttl": 3600 },
    { "groupId": "inbound", "type": "MX", "host": "@", "pointsTo": "mx3.zoho.%zohoZone%", "priority": 50, "ttl": 3600 },
    { "groupId": "spf", "type": "SPFM", "host": "@", "spfRules": "include:zoho.%zohoZone%" },
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimSelector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=%dmarcPolicy%",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    }
  ]
}
