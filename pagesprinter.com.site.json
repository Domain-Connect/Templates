{
  "providerId": "pagesprinter.com",
  "providerName": "PagesPrinter",
  "serviceId": "site",
  "serviceName": "PagesPrinter site",
  "version": 1,
  "description": "Connects a domain to a PagesPrinter site: a TXT record proves ownership, www points to PagesPrinter, and the bare domain points to PagesPrinter's redirect to www.",
  "variableDescription": "token: the domain's ownership value (the part after pagesprinter-verification=); apexip: the IPv4 address of PagesPrinter's bare-domain redirect",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "domainconnect.pagesprinter.com",
  "syncRedirectDomain": "api.pagesprinter.com,app.pagesprinter.com",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_pagesprinter.www",
      "ttl": 3600,
      "data": "pagesprinter-verification=%token%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "pagesprinter-verification="
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "domains.pagesprinter.com",
      "ttl": 3600
    },
    {
      "type": "A",
      "host": "@",
      "pointsTo": "%apexip%",
      "ttl": 3600
    }
  ]
}
