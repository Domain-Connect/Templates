{
  "providerId": "maillogic.io",
  "providerName": "MailLogic",
  "serviceId": "box",
  "serviceName": "Box Mailboxes",
  "version": 1,
  "logoUrl": "https://maillogic.io/static/images/mail-orbit-logo.svg",
  "description": "Connects a domain to MailLogic Box mailboxes: ownership verification, inbound MX, SPF, DKIM, and a starting DMARC policy.",
  "variableDescription": "%VERIFY_TOKEN%: domain verification token generated by Box; %DKIM_ID%: Box domain identifier as 32 lowercase hexadecimal characters",
  "syncPubKeyDomain": "keys.maillogic.io",
  "syncRedirectDomain": "maillogic.io",
  "records": [
    {
      "groupId": "verification",
      "type": "TXT",
      "host": "_maillogic-box",
      "data": "maillogic-box-verification=%VERIFY_TOKEN%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "maillogic-box-verification="
    },
    {
      "groupId": "mx",
      "type": "MX",
      "host": "@",
      "pointsTo": "mx.box.maillogic.io",
      "ttl": 300,
      "priority": 10
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "box1._domainkey",
      "pointsTo": "box1.%DKIM_ID%.dkim.box.maillogic.io",
      "ttl": 300
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "box2._domainkey",
      "pointsTo": "box2.%DKIM_ID%.dkim.box.maillogic.io",
      "ttl": 300
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.box.maillogic.io"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "ttl": 300,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    }
  ]
}
