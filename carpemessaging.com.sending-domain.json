{
  "providerId": "carpemessaging.com",
  "providerName": "Carpe Messaging",
  "serviceId": "sending-domain",
  "serviceName": "Send from your own domain",
  "version": 3,
  "logoUrl": "https://carpemessaging.com/domain-connect-logo.svg",
  "syncBlock": false,
  "syncPubKeyDomain": "carpemessaging.com",
  "records": [
    {
      "type": "CNAME",
      "host": "%t1%._domainkey",
      "ttl": 3600,
      "pointsTo": "%t1%.%dkimzone%",
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%t2%._domainkey",
      "ttl": 3600,
      "pointsTo": "%t2%.%dkimzone%",
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%t3%._domainkey",
      "ttl": 3600,
      "pointsTo": "%t3%.%dkimzone%",
      "groupId": "email"
    },
    {
      "type": "MX",
      "host": "send",
      "ttl": 3600,
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "groupId": "email"
    },
    {
      "type": "SPFM",
      "host": "send",
      "ttl": 3600,
      "spfRules": "include:amazonses.com",
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%golabel%",
      "ttl": 3600,
      "pointsTo": "links.carpemessaging.com",
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%smslabel%",
      "ttl": 3600,
      "pointsTo": "links.carpemessaging.com",
      "groupId": "sms"
    }
  ]
}
