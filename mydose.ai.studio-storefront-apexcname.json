{
  "providerId": "mydose.ai",
  "providerName": "MyDose",
  "serviceId": "studio-storefront-apexcname",
  "serviceName": "MyDose Studio storefront (bare domain pointed at MyDose)",
  "version": 1,
  "logoUrl": "https://studio.mydose.ai/apple-touch-icon.png",
  "description": "Connects your domain to your MyDose storefront: your website (www) and patient portal (app) addresses, your bare domain (which sends visitors to www), and permanent records that keep their security certificates renewing automatically.",
  "variableDescription": "wwwown: Cloudflare for SaaS ownership TXT value for www.%domain% (a UUID Cloudflare issues per hostname); portalown: the same for app.%domain%.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.mydose.ai",
  "syncRedirectDomain": "studio.mydose.ai,studio.dev.mydose.ai",
  "hostRequired": false,
  "records": [
    {
      "groupId": "website",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "sites.mydose.store",
      "ttl": 3600
    },
    {
      "groupId": "portal",
      "type": "CNAME",
      "host": "app",
      "pointsTo": "sites.mydose.store",
      "ttl": 3600
    },
    {
      "groupId": "websiteown",
      "type": "TXT",
      "host": "_cf-custom-hostname.www",
      "data": "%wwwown%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    },
    {
      "groupId": "portalown",
      "type": "TXT",
      "host": "_cf-custom-hostname.app",
      "data": "%portalown%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    },
    {
      "groupId": "websitedcv",
      "type": "CNAME",
      "host": "_acme-challenge.www",
      "pointsTo": "www.%fqdn%.f7fc08fe556bcdcf.dcv.cloudflare.com",
      "ttl": 3600
    },
    {
      "groupId": "portaldcv",
      "type": "CNAME",
      "host": "_acme-challenge.app",
      "pointsTo": "app.%fqdn%.f7fc08fe556bcdcf.dcv.cloudflare.com",
      "ttl": 3600
    },
    {
      "groupId": "apexcname",
      "type": "APEXCNAME",
      "host": "@",
      "pointsTo": "sites.mydose.store",
      "ttl": 3600
    },
    {
      "groupId": "apexdcv",
      "type": "CNAME",
      "host": "_acme-challenge",
      "pointsTo": "%fqdn%.f7fc08fe556bcdcf.dcv.cloudflare.com",
      "ttl": 3600
    }
  ]
}
