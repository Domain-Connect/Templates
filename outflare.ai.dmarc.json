{
  "providerId": "outflare.ai",
  "providerName": "Outflare",
  "serviceId": "dmarc",
  "serviceName": "DMARC policy",
  "version": 1,
  "logoUrl": "https://outflare.ai/brand/png/outflare-mark-black-256.png",
  "description": "Adds or updates the domain's DMARC policy, which Google, Yahoo and Microsoft require from bulk senders.",
  "variableDescription": "policy: the policy after v=DMARC1; (p=none, or p=quarantine with reporting tags)",
  "syncBlock": false,
  "syncPubKeyDomain": "outflare.ai",
  "syncRedirectDomain": "app.outflare.ai",
  "records": [
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; %policy%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
