{
    "providerId": "neleto.io",
    "providerName": "Neleto",
    "serviceId": "website",
    "serviceName": "Neleto Website",
    "version": 1,
    "logoUrl": "https://console.neleto.io/favicon.svg",
    "description": "Points your domain at your Neleto website",
    "variableDescription": "IP: IPv4 address of the server hosting the website",
    "syncBlock": false,
    "sharedProviderName": false,
    "hostRequired": false,
    "syncPubKeyDomain": "neleto.io",
    "syncRedirectDomain": "console.neleto.io",
    "records": [
        { "type": "A", "host": "@", "pointsTo": "%IP%", "ttl": 3600 },
        { "type": "A", "host": "www", "pointsTo": "%IP%", "ttl": 3600 }
    ]
}
