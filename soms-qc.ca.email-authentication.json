{
  "providerId": "soms-qc.ca",
  "providerName": "SOMS-QC",
  "serviceId": "email-authentication",
  "serviceName": "Email domain authentication",
  "version": 1,
  "logoUrl": "https://pipegrid.soms-qc.ca/logo.png",
  "description": "Authorize the DNS records required to authenticate a sending domain for email delivery.",
  "variableDescription": "%returnPathValue%: SendGrid return-path target; %dkim1Value%: SendGrid DKIM selector s1 target; %dkim2Value%: SendGrid DKIM selector s2 target; %dmarcValue%: DMARC policy supplied by the email service.",
  "syncBlock": false,
  "syncRedirectDomain": "crm-api.soms-qc.ca",
  "records": [
    {
      "type": "CNAME",
      "host": "em",
      "pointsTo": "%returnPathValue%",
      "ttl": 3600,
      "groupId": "email-authentication",
      "essential": "OnApply"
    },
    {
      "type": "CNAME",
      "host": "s1._domainkey",
      "pointsTo": "%dkim1Value%",
      "ttl": 3600,
      "groupId": "email-authentication",
      "essential": "OnApply"
    },
    {
      "type": "CNAME",
      "host": "s2._domainkey",
      "pointsTo": "%dkim2Value%",
      "ttl": 3600,
      "groupId": "email-authentication",
      "essential": "OnApply"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "%dmarcValue%",
      "ttl": 3600,
      "groupId": "email-authentication",
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    }
  ]
}
