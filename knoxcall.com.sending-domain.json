{
  "providerId": "knoxcall.com",
  "providerName": "KnoxCall",
  "serviceId": "sending-domain",
  "serviceName": "KnoxCall sending domain",
  "version": 2,
  "logoUrl": "https://knoxcall.com/knoxcall-v2-icon.svg",
  "description": "Lets KnoxCall send email (workflow mail, alerts and invitations) from this domain by publishing the DKIM key, return-path MX and SPF include its mail provider requires.",
  "variableDescription": "dkim: the DKIM public key body issued for this domain (the value after p=). mx: the return-path MX host for the domain’s mail region, e.g. feedback-smtp.us-east-1.amazonses.com.",
  "syncBlock": false,
  "syncPubKeyDomain": "knoxcall.com",
  "syncRedirectDomain": "knoxcall.com",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkim%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "%mx%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "send",
      "data": "v=spf1 include:amazonses.com ~all",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=spf1"
    },
    {
      "type": "CNAME",
      "host": "rsend",
      "pointsTo": "send.forge.rmta.net",
      "ttl": 3600
    }
  ]
}
