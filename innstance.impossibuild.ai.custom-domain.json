{
  "providerId": "innstance.impossibuild.ai",
  "providerName": "Innstance",
  "serviceId": "custom-domain",
  "serviceName": "Custom domain",
  "version": 1,
  "description": "Connects a domain the user owns to their app or published site: one CNAME to the platform edge and one ownership-proof TXT record.",
  "variableDescription": "verify is the hex ownership token the dashboard or CLI shows when the user adds the domain.",
  "syncPubKeyDomain": "innstance.impossibuild.ai",
  "syncRedirectDomain": "innstance.impossibuild.ai",
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "innstance.impossibuild.ai",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_innstance-verify",
      "data": "innstance-verify=%verify%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "innstance-verify="
    }
  ]
}
