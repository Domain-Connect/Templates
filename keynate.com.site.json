{
  "providerId": "keynate.com",
  "providerName": "Keynate",
  "serviceId": "site",
  "serviceName": "Keynate website",
  "version": 1,
  "logoUrl": "https://www.keynate.com/email/keynate-logo-2x.png",
  "description": "Points your domain (and www) to your Keynate website, verifies that you own it and adds the address of your site dashboard (admin.).",
  "variableDescription": "siteid: your Keynate site number; token: your domain verification code",
  "syncBlock": false,
  "syncPubKeyDomain": "keynate.com",
  "syncRedirectDomain": "keynate.com,www.keynate.com",
  "hostRequired": false,
  "multiInstance": false,
  "records": [
    {
      "groupId": "site",
      "type": "A",
      "host": "@",
      "pointsTo": "36.50.82.158",
      "ttl": 3600
    },
    {
      "groupId": "site",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "i-%siteid%.edge.keynate.com",
      "ttl": 3600
    },
    {
      "groupId": "site",
      "type": "TXT",
      "host": "_keynate",
      "data": "keynate-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "keynate-verify="
    },
    {
      "groupId": "admin",
      "type": "CNAME",
      "host": "admin",
      "pointsTo": "i-%siteid%.edge.keynate.com",
      "ttl": 3600,
      "essential": "OnApply"
    }
  ]
}
