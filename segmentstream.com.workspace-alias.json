{
  "providerId": "segmentstream.com",
  "providerName": "SegmentStream",
  "logoUrl": "https://segmentstream.com/segmentstream-logo-black.svg",
  "serviceId": "workspace-alias",
  "serviceName": "Workspace hostname",
  "version": 1,
  "description": "Point this hostname to the workspace app.",
  "variableDescription": "target is the assigned workspace DNS target.",
  "syncPubKeyDomain": "domainconnect.segmentstream.com",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "%target%",
      "ttl": 600
    }
  ],
  "hostRequired": true
}
