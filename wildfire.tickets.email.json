{
  "providerId": "wildfire.tickets",
  "providerName": "Wildfire",
  "serviceId": "email",
  "serviceName": "Wildfire email sending",
  "version": 1,
  "logoUrl": "https://dashboard.wildfire.tickets/icon.svg",
  "description": "Lets Wildfire send email from your domain through Amazon SES: three DKIM records, a bounce (MAIL FROM) subdomain with MX and SPF, and a DMARC record when the domain has none.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the Easy DKIM tokens Amazon SES issued for the domain; %mark%: the eight characters Wildfire gave this domain's bounce subdomain; %region%: the AWS region of Wildfire's Amazon SES account",
  "syncPubKeyDomain": "wildfire.tickets",
  "syncRedirectDomain": "dashboard.wildfire.tickets",
  "syncBlock": false,
  "hostRequired": false,
  "records": [
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "bounce-%mark%",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "bounce-%mark%",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
