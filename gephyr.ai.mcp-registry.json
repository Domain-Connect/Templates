{
  "providerId": "gephyr.ai",
  "providerName": "Gephyr",
  "serviceId": "mcp-registry",
  "serviceName": "MCP Registry listing",
  "version": 1,
  "logoUrl": "https://gephyr.ai/logo/gephyr-icon-512.png",
  "description": "Adds one TXT record that lets Gephyr list your app's AI connector in the official MCP Registry under your domain.",
  "variableDescription": "mcpkey: the public key Gephyr shows for your app's listing",
  "syncBlock": false,
  "syncPubKeyDomain": "dc.gephyr.ai",
  "syncRedirectDomain": "gephyr.ai",
  "hostRequired": false,
  "multiInstance": true,
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "v=MCPv1; k=ed25519; p=%mcpkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
