{
  "providerId": "basehand.com",
  "providerName": "Basehand",
  "serviceId": "domain-www",
  "serviceName": "Website",
  "description": "Shows your Basehand site at www and forwards your bare domain to it",
  "syncPubKeyDomain": "basehand.com",
  "syncRedirectDomain": "basehand.com,app.basehand.com",
  "version": 1,
  "logoUrl": "https://basehand.com/domain-connect-logo.svg",
  "variableDescription": "token: verification code for this domain; target: Basehand's connection hostname, such as connect.basehand.site",
  "records": [
    {
      "type": "TXT",
      "host": "_basehand",
      "data": "basehand-site-verification=%token%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "basehand-site-verification=",
      "ttl": "300"
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%target%",
      "ttl": "300"
    },
    {
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%fqdn%"
    }
  ]
}
