{
    "providerId": "aimai.co.uk",
    "providerName": "AIMAI",
    "serviceId": "prismemail",
    "serviceName": "PRISM email sending",
    "version": 2,
    "logoUrl": "https://app.aimai.co.uk/domain-connect/aimai-logo.svg",
    "description": "Lets PRISM send email from the organisation's domain through Amazon SES without changing existing mailboxes",
    "variableDescription": "%dkim1%, %dkim2%, %dkim3%: Amazon SES Easy DKIM tokens; %sesregion%: Amazon SES region used for the bounce subdomain (for example eu-west-2)",
    "syncBlock": false,
    "shared": true,
    "sharedProviderName": true,
    "syncPubKeyDomain": "aimai.co.uk",
    "records": [
        {
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "type": "MX",
            "host": "bounce",
            "pointsTo": "feedback-smtp.%sesregion%.amazonses.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "type": "SPFM",
            "host": "bounce",
            "spfRules": "include:amazonses.com",
            "ttl": 3600
        }
    ]
}
