{
  "providerId": "novard.de",
  "providerName": "Novard",
  "serviceId": "ownership-verification",
  "serviceName": "Novard ownership verification",
  "version": 1,
  "description": "Adds a DNS TXT record used to verify domain ownership for the Novard security check.",
  "variableDescription": "token: unique token generated by Novard for domain ownership verification",
  "syncBlock": false,
  "syncRedirectDomain": "novard.de",
  "records": [
    {
      "groupId": "verification",
      "type": "TXT",
      "host": "_novard-verify",
      "data": "novard-site-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "novard-site-verification="
    }
  ]
}
