{
  "providerId": "thinkmission.com",
  "providerName": "Think Mission",
  "serviceId": "newsletter-sending",
  "serviceName": "Newsletter sending",
  "version": 1,
  "logoUrl": "https://thinkmission.com/email/onboarding/logo-platform.png",
  "description": "Lets Think Mission send your organization's newsletters from your domain: a DKIM signing key, SPF authorization, and bounce handling on the send subdomain.",
  "variableDescription": "dkimKey: DKIM public key for this domain (base64, without the p= prefix). region: email sending region, e.g. us-east-1.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "domainconnect.thinkmission.com",
  "syncRedirectDomain": "thinkmission.com",
  "hostRequired": false,
  "records": [
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
