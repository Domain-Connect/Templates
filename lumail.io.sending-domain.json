{
  "providerId": "lumail.io",
  "providerName": "Lumail",
  "serviceId": "sending-domain",
  "serviceName": "Lumail sending domain",
  "version": 1,
  "logoUrl": "https://lumail.io/images/lumail-logo-light.svg",
  "description": "Authenticates a domain to send email through Lumail (Amazon SES): DKIM, a custom MAIL FROM subdomain and an optional DMARC policy.",
  "variableDescription": "dkimkey: base64 DKIM public key generated by Lumail; region: Amazon SES region of the identity, e.g. us-east-1",
  "syncBlock": false,
  "syncPubKeyDomain": "lumail.io",
  "records": [
    {
      "groupId": "ses",
      "type": "TXT",
      "host": "lumail._domainkey",
      "data": "p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "ses",
      "type": "MX",
      "host": "ses",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "ses",
      "type": "SPFM",
      "host": "ses",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
