{
  "providerId": "getsitefold.com",
  "providerName": "Sitefold",
  "serviceId": "website",
  "serviceName": "Website",
  "version": 1,
  "logoUrl": "https://getsitefold.com/favicon.svg",
  "description": "Connects a domain to a website: www points to the site, and the bare domain redirects to www. Email records are not touched.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "getsitefold.com",
  "syncRedirectDomain": "app.getsitefold.com,staging.getsitefold.com",
  "hostRequired": false,
  "records": [
    { "type": "CNAME", "host": "www", "pointsTo": "sites.getsitefold.com", "ttl": 3600 },
    { "type": "REDIR301", "host": "@", "target": "https://www.%fqdn%" }
  ]
}
