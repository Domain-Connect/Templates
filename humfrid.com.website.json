{
  "providerId": "humfrid.com",
  "providerName": "Humfrid",
  "serviceId": "website",
  "serviceName": "Humfrid website",
  "version": 1,
  "logoUrl": "https://humfrid.com/apple-touch-icon.png",
  "description": "Shows the website Humfrid made for you at your own domain. Your email and every other record stay as they are.",
  "variableDescription": "proof: the token after humfrid-verify= that proves this domain belongs to the Humfrid workspace that asked",
  "syncBlock": false,
  "syncPubKeyDomain": "humfrid.com",
  "syncRedirectDomain": "humfrid.com",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "_humfrid",
      "data": "humfrid-verify=%proof%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "humfrid-verify="
    },
    {
      "type": "A",
      "host": "@",
      "pointsTo": "8.232.109.105",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "connect.byhumfrid.com",
      "ttl": 3600
    }
  ]
}
