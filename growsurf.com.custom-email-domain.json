{
  "providerId": "growsurf.com",
  "providerName": "GrowSurf",
  "serviceId": "custom-email-domain",
  "serviceName": "Custom Email Domain",
  "version": 1,
  "logoUrl": "https://app.growsurf.com/assets/img/logo/iconmark-blue.png",
  "description": "Lets GrowSurf send your referral program emails from your own domain. Adds a GrowSurf ownership record and three DKIM records. Does not change where your email is delivered.",
  "variableDescription": "campaignId: GrowSurf program ID; dkim1, dkim2, dkim3: DKIM tokens generated by GrowSurf for this domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "growsurf.com",
  "syncRedirectDomain": "app.growsurf.com,growsurf.com,app-staging.growsurf.com",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "growsurf=%campaignId%",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    }
  ]
}
