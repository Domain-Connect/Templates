{
  "providerId": "gofarther.dev",
  "providerName": "Go Farther",
  "serviceId": "site",
  "serviceName": "Go Farther website",
  "version": 1,
  "logoUrl": "https://gofarther.dev/logo.png",
  "description": "Point this domain at the website you built with Go Farther.",
  "variableDescription": "target: the Go Farther hostname this domain is served from.",
  "syncPubKeyDomain": "gofarther.dev",
  "syncRedirectDomain": "gofarther.dev,www.gofarther.dev",
  "hostRequired": false,
  "shared": false,
  "records": [
    {
      "type": "APEXCNAME",
      "pointsTo": "%target%",
      "ttl": 1800,
      "groupId": "apex"
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%target%",
      "ttl": 1800,
      "groupId": "www"
    }
  ]
}
