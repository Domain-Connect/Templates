{
  "providerId": "aioslive.app",
  "providerName": "AIOS",
  "serviceId": "sitepair",
  "serviceName": "AIOS Sites www and root",
  "version": 1,
  "logoUrl": "https://cdn.aioshq.com/desktop/aios-wordmark.svg",
  "description": "Connect a domain and its www to a site published with AIOS Sites in one approval: www points at the site, and the root forwards to www.",
  "variableDescription": "%proof%: the one-time token that proves the domain belongs to the AIOS member who claimed it (32 hex characters).",
  "syncPubKeyDomain": "pair.aioslive.app",
  "syncRedirectDomain": "aioslive.app",
  "hostRequired": false,
  "records": [
    {
      "groupId": "proof",
      "type": "TXT",
      "host": "_aios-site.www",
      "data": "aios-site=%proof%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "aios-site="
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "fallback.aioslive.app",
      "ttl": 3600
    },
    {
      "groupId": "forward",
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%domain%"
    }
  ]
}
