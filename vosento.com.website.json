{
    "providerId": "vosento.com",
    "providerName": "Vosento",
    "serviceId": "website",
    "serviceName": "Vosento website",
    "version": 1,
    "logoUrl": "https://www.vosento.com/img/icon-512.png",
    "description": "Points www to the website Vosento built for you and forwards the bare domain to www. Email records are not changed.",
    "syncBlock": false,
    "syncPubKeyDomain": "vosento.com",
    "syncRedirectDomain": "vosento.com,vosento-agent.mehdibs.workers.dev",
    "hostRequired": false,
    "records": [
        {
            "groupId": "site",
            "type": "CNAME",
            "host": "www",
            "pointsTo": "vosento-sites.pages.dev",
            "ttl": 3600
        },
        {
            "groupId": "redirect",
            "type": "REDIR301",
            "host": "@",
            "target": "https://www.%fqdn%",
            "ttl": 3600,
            "essential": "OnApply"
        }
    ]
}
