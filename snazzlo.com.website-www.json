{
  "providerId": "snazzlo.com",
  "providerName": "Snazzlo",
  "serviceId": "website-www",
  "serviceName": "Website",
  "version": 1,
  "logoUrl": "https://snazzlo.com/icon.svg",
  "description": "Shows your Snazzlo website at www and forwards your bare domain to it",
  "variableDescription": "project: the site's Cloudflare Pages project name; www points to <project>.pages.dev",
  "syncPubKeyDomain": "snazzlo.com",
  "syncRedirectDomain": "studio.snazzlo.com",
  "records": [
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%project%.pages.dev",
      "ttl": 3600
    },
    {
      "groupId": "forward",
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%fqdn%"
    }
  ]
}
