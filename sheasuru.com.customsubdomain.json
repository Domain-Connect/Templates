{
    "providerId": "sheasuru.com",
    "providerName": "Sheasuru",
    "serviceId": "customsubdomain",
    "serviceName": "Sheasuru custom subdomain",
    "version": 1,
    "logoUrl": "https://sheasuru.com/favicon.svg",
    "description": "Connects a subdomain (passed as the host parameter) to a Sheasuru creator profile: ownership verification TXT plus the CNAME to Sheasuru hosting.",
    "variableDescription": "%proof%: per-domain ownership token issued by Sheasuru",
    "syncPubKeyDomain": "sheasuru.com",
    "syncRedirectDomain": "sheasuru.com,www.sheasuru.com",
    "records": [
        {
            "groupId": "verify",
            "type": "TXT",
            "host": "_sheasuru-verification",
            "data": "sheasuru-verification=%proof%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "sheasuru-verification="
        },
        {
            "groupId": "subdomain",
            "type": "CNAME",
            "host": "@",
            "pointsTo": "sheasuru-standalone.onrender.com",
            "ttl": 3600
        }
    ],
    "hostRequired": true
}
