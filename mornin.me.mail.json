{
    "providerId": "mornin.me",
    "providerName": "Mornin",
    "serviceId": "mail",
    "serviceName": "Mornin Mail",
    "version": 2,
    "logoUrl": "https://mornin.me/assets/mornin-logo.svg",
    "description": "Configures a domain for Mornin email hosting: ownership verification, inbound MX, SPF, DKIM, outbound relay authentication and DMARC.",
    "variableDescription": "%token%: Mornin ownership verification token; %dkimkey%: Ed25519 DKIM public key (p= value) for the mornin selector",
    "syncBlock": false,
    "syncPubKeyDomain": "mornin.me",
    "syncRedirectDomain": "app.mornin.me",
    "records": [
        {
            "groupId": "mail",
            "type": "TXT",
            "host": "_mornin",
            "data": "mornin-verification=%token%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "mornin-verification="
        },
        {
            "groupId": "mail",
            "type": "MX",
            "host": "@",
            "pointsTo": "mail.mornin.email",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mail",
            "type": "SPFM",
            "host": "@",
            "spfRules": "include:spf.smtp2go.com"
        },
        {
            "groupId": "mail",
            "type": "TXT",
            "host": "mornin._domainkey",
            "data": "v=DKIM1; k=ed25519; h=sha256; p=%dkimkey%",
            "ttl": 3600,
            "txtConflictMatchingMode": "All"
        },
        {
            "groupId": "mail",
            "type": "CNAME",
            "host": "mornin",
            "pointsTo": "return.smtp2go.net",
            "ttl": 3600
        },
        {
            "groupId": "mail",
            "type": "CNAME",
            "host": "s797385._domainkey",
            "pointsTo": "dkim.smtp2go.net",
            "ttl": 3600
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none; rua=mailto:dmarc@mornin.me",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        }
    ]
}
