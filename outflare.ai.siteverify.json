{
  "providerId": "outflare.ai",
  "providerName": "Outflare",
  "serviceId": "siteverify",
  "serviceName": "Site ownership",
  "version": 1,
  "logoUrl": "https://outflare.ai/brand/png/outflare-mark-black-256.png",
  "description": "Proves the site is yours so Outflare can audit it: a TXT record with the site's token.",
  "variableDescription": "token: the site's verification token",
  "syncBlock": false,
  "syncPubKeyDomain": "outflare.ai",
  "syncRedirectDomain": "app.outflare.ai",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "outflare-site-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "outflare-site-verification=",
      "essential": "OnApply"
    }
  ]
}
