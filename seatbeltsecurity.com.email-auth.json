{
  "providerId": "seatbeltsecurity.com",
  "providerName": "Seatbelt Security",
  "serviceId": "email-auth",
  "serviceName": "Email Authentication",
  "description": "Configures SPF and DMARC delegation for automated email security management via Seatbelt Security",
  "logoUrl": "https://seatbeltsecurity.com/marketing/seatbelt-logo-dc.png",
  "version": 2,
  "hostRequired": false,
  "syncPubKeyDomain": "seatbeltsecurity.com",
  "syncRedirectDomain": "seatbeltsecurity.com",
  "variableDescription": "customer: this domain's Seatbelt delegation label, assigned by Seatbelt at setup (e.g. example-com-4f9a1b2c3d4e)",
  "records": [
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:%customer%.spf.seatbeltsecurity.com",
      "ttl": 3600,
      "groupId": "email-auth"
    },
    {
      "type": "CNAME",
      "host": "_dmarc",
      "pointsTo": "_dmarc.%customer%.seatbeltsecurity.com",
      "ttl": 3600,
      "groupId": "email-auth",
      "essential": "OnApply"
    }
  ]
}
