{
  "providerId": "vyxomail.com",
  "providerName": "VyxoMail",
  "serviceId": "mail",
  "serviceName": "VyxoMail Sending & Delivery",
  "version": 1,
  "description": "Configure DNS records (DKIM, SPF, DMARC, and MX) for authenticated email delivery via VyxoMail.",
  "logoUrl": "https://vyxomail.com/logo.svg",
  "syncPubKeyDomain": "vyxomail.com",
  "syncRedirectDomain": "vyxomail.com",
  "syncBlock": false,
  "records": [
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimSelector%._domainkey",
      "ttl": 3600,
      "data": "v=DKIM1; k=rsa; p=%domainKey%"
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "ttl": 3600,
      "spfRules": "include:_spf.vyxomail.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "ttl": 3600,
      "data": "v=DMARC1; p=none;"
    },
    {
      "groupId": "mx",
      "type": "MX",
      "host": "@",
      "pointsTo": "mail.vyxomail.com.",
      "ttl": 3600,
      "priority": 10
    }
  ]
}
