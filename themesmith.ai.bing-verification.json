{
  "providerId": "themesmith.ai",
  "providerName": "ThemeSmith",
  "serviceId": "bing-verification",
  "serviceName": "Bing Webmaster",
  "version": 1,
  "logoUrl": "https://themesmith.ai/favicon.svg",
  "description": "Adds Bing's site check at the bare domain. Other TXT records are left as they are.",
  "variableDescription": "%token%: the Bing Webmaster verification token",
  "syncBlock": false,
  "syncPubKeyDomain": "themesmith.ai",
  "syncRedirectDomain": "app.themesmith.ai",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "msvalidate.01=%token%",
      "ttl": "300",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "msvalidate.01=",
      "essential": "OnApply"
    }
  ]
}
