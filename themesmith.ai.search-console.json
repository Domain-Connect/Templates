{
  "providerId": "themesmith.ai",
  "providerName": "ThemeSmith",
  "serviceId": "search-console",
  "serviceName": "Google Search Console",
  "version": 1,
  "logoUrl": "https://themesmith.ai/favicon.svg",
  "description": "Adds Google's site check at the bare domain. Other TXT records are left as they are.",
  "variableDescription": "%token%: the Google Search Console verification token",
  "syncBlock": false,
  "syncPubKeyDomain": "themesmith.ai",
  "syncRedirectDomain": "app.themesmith.ai",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "google-site-verification=%token%",
      "ttl": "300",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "google-site-verification=",
      "essential": "OnApply"
    }
  ]
}
