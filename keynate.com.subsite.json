{
  "providerId": "keynate.com",
  "providerName": "Keynate",
  "serviceId": "subsite",
  "serviceName": "Keynate website on a sub-domain",
  "version": 1,
  "logoUrl": "https://www.keynate.com/email/keynate-logo-2x.png",
  "description": "Points a sub-domain (for example news.yourdomain.com) to your Keynate website, verifies that you own it and adds the address of your site dashboard (admin.). Your main website and email stay untouched.",
  "variableDescription": "siteid: your Keynate site number; token: your domain verification code",
  "syncBlock": false,
  "syncPubKeyDomain": "keynate.com",
  "syncRedirectDomain": "keynate.com,www.keynate.com",
  "hostRequired": true,
  "multiInstance": false,
  "records": [
    {
      "groupId": "site",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "i-%siteid%.edge.keynate.com",
      "ttl": 3600
    },
    {
      "groupId": "site",
      "type": "TXT",
      "host": "_keynate",
      "data": "keynate-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "keynate-verify="
    },
    {
      "groupId": "admin",
      "type": "CNAME",
      "host": "admin",
      "pointsTo": "i-%siteid%.edge.keynate.com",
      "ttl": 3600,
      "essential": "OnApply"
    }
  ]
}
