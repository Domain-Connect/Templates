{
  "providerId": "narvlabs.com",
  "providerName": "NARV Labs",
  "serviceId": "logger-domain-verification",
  "serviceName": "NARV domain verification",
  "version": 2,
  "logoUrl": "https://app.narvlabs.com/icon.png",
  "description": "Proves that your company owns this domain for its NARV account (NARV Console, NARV Logger and the other NARV apps). Adds one TXT record and changes nothing else.",
  "variableDescription": "token: the verification value NARV shows the company admin",
  "syncBlock": false,
  "sharedProviderName": false,
  "hostRequired": false,
  "syncPubKeyDomain": "narvlabs.com",
  "syncRedirectDomain": "console.narvlabs.com,app.narvlabs.com,team.narvlabs.com,logger.narvlabs.com",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "narv-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "narv-verification=",
      "essential": "OnApply"
    }
  ]
}
