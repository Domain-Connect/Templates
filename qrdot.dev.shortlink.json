{
  "providerId": "qrdot.dev",
  "providerName": "QR.",
  "serviceId": "shortlink",
  "serviceName": "QR. short links",
  "version": 1,
  "logoUrl": "https://qrdot.dev/favicon-48x48.png",
  "description": "Point a hostname at go.qrdot.dev for branded short links and ownership verification.",
  "variableDescription": "domainId is the qrdot domain id used in the ownership TXT value.",
  "syncPubKeyDomain": "qrdot.dev",
  "syncRedirectDomain": "app.qrdot.dev",
  "syncBlock": false,
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "%host%",
      "pointsTo": "go.qrdot.dev",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_qrdot-verify.%host%",
      "data": "qrdot-domain-verification=%domainId%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "qrdot-domain-verification="
    }
  ]
}
