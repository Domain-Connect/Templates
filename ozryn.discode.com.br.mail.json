{
  "providerId": "ozryn.discode.com.br",
  "providerName": "Ozryn",
  "serviceId": "mail",
  "serviceName": "E-mail do Ozryn",
  "version": 3,
  "logoUrl": "https://ozryn.discode.com.br/brand/ozryn-email-quadrado.svg",
  "description": "Lets a company send e-mail from its own domain through the Ozryn (SPF, DKIM, DMARC) and, optionally, receive it (MX).",
  "variableDescription": "dkimkey: DKIM selector (e.g. ozryn1); dkimp: the base64 DKIM public key; mxhost: the Ozryn inbound mail host; sestoken: the Amazon SES verification token of the receiving domain",
  "syncPubKeyDomain": "ozryn.discode.com.br",
  "syncRedirectDomain": "ozryn.discode.com.br",
  "hostRequired": false,
  "records": [
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.ozryn.discode.com.br"
    },
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimkey%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimp%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; adkim=r; aspf=r",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "mx",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mxhost%",
      "priority": 10,
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "mx",
      "type": "TXT",
      "host": "_amazonses",
      "data": "%sestoken%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None",
      "essential": "OnApply"
    }
  ]
}
