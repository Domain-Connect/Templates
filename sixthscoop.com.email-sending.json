{
    "providerId": "sixthscoop.com",
    "providerName": "SixthScoop",
    "serviceId": "email-sending",
    "serviceName": "SixthScoop email sending",
    "version": 1,
    "logoUrl": "https://app.sixthscoop.com/images/logo/sixthscoop-mark.svg",
    "description": "Sets up a domain to send and receive email through SixthScoop (Amazon SES): DKIM, SPF, a custom MAIL FROM sub-domain, DMARC and the inbound MX for replies.",
    "variableDescription": "dkim1-3: Amazon SES Easy DKIM tokens; region: AWS region of the SES account (e.g. us-west-2)",
    "syncBlock": false,
    "syncPubKeyDomain": "brandpod.ai",
    "syncRedirectDomain": "app.sixthscoop.com,sandbox.sixthscoop.com",
    "hostRequired": false,
    "records": [
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "spf",
            "type": "SPFM",
            "host": "@",
            "spfRules": "include:amazonses.com"
        },
        {
            "groupId": "mailfrom",
            "type": "MX",
            "host": "bounce",
            "pointsTo": "feedback-smtp.%region%.amazonses.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mailfrom",
            "type": "SPFM",
            "host": "bounce",
            "spfRules": "include:amazonses.com"
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        },
        {
            "groupId": "inbound",
            "type": "MX",
            "host": "@",
            "pointsTo": "inbound-smtp.%region%.amazonaws.com",
            "priority": 10,
            "ttl": 3600
        }
    ]
}
