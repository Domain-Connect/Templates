{
  "providerId": "quicklist.live",
  "providerName": "Quicklist",
  "serviceId": "storefront-root",
  "serviceName": "Quicklist Online Store",
  "version": 1,
  "logoUrl": "https://quicklist.live/logo.png",
  "description": "Points a root domain (and its www subdomain) at a Quicklist online store.",
  "variableDescription": "ip: IPv4 address of the Quicklist storefront server",
  "syncBlock": false,
  "syncPubKeyDomain": "quicklist.live",
  "syncRedirectDomain": "quicklist.live",
  "hostRequired": false,
  "records": [
    { "type": "A", "host": "@", "pointsTo": "%ip%", "ttl": 600 },
    { "type": "CNAME", "host": "www", "pointsTo": "cname.quicklist.live", "ttl": 600 }
  ]
}
