{
  "providerId": "resortambassadors.com",
  "providerName": "Resort Ambassadors",
  "serviceId": "website-apex",
  "serviceName": "Ambassador website root domain",
  "version": 1,
  "description": "Connect your Ambassador website and verify domain ownership.",
  "syncPubKeyDomain": "resortambassadors.com",
  "syncRedirectDomain": "portal.resortambassadors.com",
  "syncBlock": false,
  "hostRequired": false,
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "18.134.46.178",
      "ttl": 600,
      "essential": "Always"
    },
    {
      "type": "TXT",
      "host": "_ambassador",
      "data": "ambassador-verify-%verification%",
      "ttl": 600,
      "txtConflictMatchingMode": "All",
      "essential": "Always"
    }
  ],
  "logoUrl": "https://portal.resortambassadors.com/assets/ambassador-logo.png",
  "variableDescription": "verification: unique domain ownership token generated by Resort Ambassadors (without the ambassador-verify- prefix)."
}
