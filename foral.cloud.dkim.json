{
    "providerId": "foral.cloud",
    "providerName": "Foral",
    "serviceId": "dkim",
    "serviceName": "Foral — DKIM signing keys",
    "version": 2,
    "logoUrl": "https://foral.cloud/icons/icon-512.png",
    "description": "Adds the DKIM CNAMEs generated by our outbound provider (AhaSend) so that messages sent from the domain are signed and treated as legitimate by receivers. Applied after the `verify-mx` template has run and ownership has been confirmed — values vary per account because each one has unique selectors.",
    "syncBlock": false,
    "syncPubKeyDomain": "foral.cloud",
    "records": [
        {
            "type": "CNAME",
            "groupId": "outbound-dkim",
            "host": "%dkim1Selector%._domainkey",
            "pointsTo": "%dkim1Target%",
            "ttl": 3600,
            "essential": "Always"
        },
        {
            "type": "CNAME",
            "groupId": "outbound-dkim",
            "host": "%dkim2Selector%._domainkey",
            "pointsTo": "%dkim2Target%",
            "ttl": 3600,
            "essential": "Always"
        }
    ]
}
