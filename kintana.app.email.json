{
  "providerId": "kintana.app",
  "providerName": "Kintana",
  "serviceId": "email",
  "serviceName": "Email",
  "version": 1,
  "logoUrl": "https://kintana.app/icons/icon-512.png",
  "description": "Lets Kintana send email from this domain (SPF, DKIM and bounce handling), and optionally receive it and publish a DMARC policy.",
  "variableDescription": "region: the sending region, e.g. us-east-1. dkimkey: the domain's DKIM public key.",
  "syncPubKeyDomain": "kintana.app",
  "syncRedirectDomain": "kintana.app,dev.kintana.app",
  "records": [
    {
      "groupId": "sending",
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimkey%",
      "txtConflictMatchingMode": "All",
      "ttl": 3600
    },
    {
      "groupId": "receiving",
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply",
      "ttl": 3600
    }
  ]
}
