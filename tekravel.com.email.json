{
    "providerId": "tekravel.com",
    "providerName": "Tekravel",
    "serviceId": "email",
    "serviceName": "Tekravel email sending",
    "version": 1,
    "logoUrl": "https://tekravel.com/apple-touch-icon.png",
    "description": "Lets Tekravel send booking emails from your domain through Amazon SES (DKIM, custom MAIL FROM and DMARC).",
    "variableDescription": "dkim1, dkim2, dkim3: Amazon SES Easy DKIM tokens; sesRegion: Amazon SES region of the MAIL FROM feedback endpoint (e.g. eu-west-1); dmarcPolicy: DMARC tags after v=DMARC1 (e.g. p=none; rua=mailto:reports@example.com;).",
    "syncBlock": false,
    "sharedProviderName": false,
    "syncPubKeyDomain": "tekravel.com",
    "syncRedirectDomain": "dubaitrip.com,staging.dubaitrip.com",
    "hostRequired": false,
    "records": [
        {
            "groupId": "dkim1",
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim2",
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim3",
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "mailfrom",
            "type": "MX",
            "host": "mail",
            "pointsTo": "feedback-smtp.%sesRegion%.amazonses.com",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mailfrom",
            "type": "SPFM",
            "host": "mail",
            "spfRules": "include:amazonses.com"
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; %dmarcPolicy%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        }
    ]
}
