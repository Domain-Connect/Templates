{
  "providerId": "themesmith.ai",
  "providerName": "ThemeSmith",
  "serviceId": "caa",
  "serviceName": "Certificate authority",
  "version": 1,
  "logoUrl": "https://themesmith.ai/favicon.svg",
  "description": "Lets Amazon issue certificates for this domain when a CAA record would otherwise block them.",
  "syncBlock": false,
  "syncPubKeyDomain": "themesmith.ai",
  "syncRedirectDomain": "app.themesmith.ai",
  "records": [
    {
      "type": "CAA",
      "host": "@",
      "data": "0 issue \"amazon.com\"",
      "ttl": "300",
      "essential": "OnApply"
    }
  ]
}
