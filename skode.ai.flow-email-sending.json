{
    "providerId": "skode.ai",
    "providerName": "Skode",
    "serviceId": "flow-email-sending",
    "serviceName": "Skode Flow email sending",
    "version": 1,
    "logoUrl": "https://skode.ai/apple-icon.png",
    "description": "Verifies your domain for sending email campaigns from Skode Flow: DKIM signing and a bounce-handling MAIL FROM subdomain. Campaigns then send signed, from your own address.",
    "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the Amazon SES DKIM tokens issued for this domain; %sesregion%: the SES region hosting the identity; %bounce%: the MAIL FROM subdomain label (default 'bounce')",
    "syncPubKeyDomain": "skode.ai",
    "syncRedirectDomain": "flow.skode.ai",
    "records": [
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": "3600"
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": "3600"
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": "3600"
        },
        {
            "groupId": "mailfrom",
            "type": "MX",
            "host": "%bounce%",
            "pointsTo": "feedback-smtp.%sesregion%.amazonses.com",
            "ttl": "3600",
            "priority": "10"
        },
        {
            "groupId": "mailfrom",
            "type": "SPFM",
            "host": "%bounce%",
            "ttl": "3600",
            "spfRules": "include:amazonses.com"
        }
    ]
}
