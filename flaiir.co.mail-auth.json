{
  "providerId": "flaiir.co",
  "providerName": "Flaiir",
  "serviceId": "mail-auth",
  "serviceName": "Email authentication (SPF and DMARC)",
  "version": 1,
  "logoUrl": "https://flaiir.co/icon.svg",
  "description": "Adds your mail provider to SPF and publishes a starter DMARC policy (p=none), so Gmail, Outlook and Yahoo accept mail from your domain. Flaiir only asks for the records its domain check found missing.",
  "syncPubKeyDomain": "flaiir.co",
  "syncRedirectDomain": "app.flaiir.co,flaiir.co",
  "hostRequired": false,
  "records": [
    {
      "groupId": "spf-google",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.google.com"
    },
    {
      "groupId": "spf-microsoft",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.protection.outlook.com"
    },
    {
      "groupId": "spf-zoho",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:zohomail.com"
    },
    {
      "groupId": "spf-fastmail",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.messagingengine.com"
    },
    {
      "groupId": "spf-proton",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:_spf.protonmail.ch"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc-reports@%domain%; adkim=r; aspf=r",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
