    { "type": "MX", "host": "@", "pointsTo": "alt.mx.protectspam.net",     "priority": 20, "ttl": 3600 },
    { "type": "MX", "host": "@", "pointsTo": "alt2.mx.protectspam.com.br", "priority": 30, "ttl": 3600 }
