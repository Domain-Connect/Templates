{
  "providerId": "pgbhub.com",
  "providerName": "PGB Hub",
  "serviceId": "auth-email",
  "serviceName": "Sign-in email sender domain",
  "version": 1,
  "logoUrl": "https://pgbhub.com/favicon.svg",
  "description": "Send sign-in, verification and password-reset emails from your own domain.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: Amazon SES Easy DKIM tokens issued for this domain",
  "syncBlock": false,
  "syncPubKeyDomain": "pgbhub.com",
  "syncRedirectDomain": "console.pgbhub.com",
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    }
  ]
}
