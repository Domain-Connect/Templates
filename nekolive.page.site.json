{
    "providerId": "nekolive.page",
    "providerName": "Nekolive Creator Page",
    "serviceId": "site",
    "serviceName": "Nekolive Creator Site",
    "version": 2,
    "logoUrl": "https://nekolive.net/assets/nekolive.page.svg",
    "description": "Points a subdomain (for example www) to a creator site hosted on Nekolive Page.",
    "variableDescription": "No variables. The record is created on the host chosen by the user.",
    "syncBlock": false,
    "syncPubKeyDomain": "nekolive.page",
    "syncRedirectDomain": "streamer.nekolive.net",
    "hostRequired": true,
    "records": [
        {
            "type": "CNAME",
            "host": "@",
            "pointsTo": "sites.nekolive.page",
            "ttl": 3600
        }
    ]
}
