{
  "providerId": "plts.ai",
  "providerName": "PLTS.AI",
  "serviceId": "email",
  "serviceName": "Studio email sending",
  "version": 1,
  "logoUrl": "https://plts.ai/branding/plts-ai-mark.svg",
  "description": "Lets a pilates studio send its booking, receipt and newsletter emails from its own domain, through PLTS.AI.",
  "variableDescription": "dkim is the DKIM public key to publish (the part after p=). mxhost is the mail server that receives bounces for the sending subdomain.",
  "syncPubKeyDomain": "plts.ai",
  "syncRedirectDomain": "plts.ai",
  "syncBlock": false,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkim%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "%mxhost%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    }
  ]
}
