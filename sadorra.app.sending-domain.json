{
  "providerId": "sadorra.app",
  "providerName": "Sadorra",
  "serviceId": "sending-domain",
  "serviceName": "Sadorra newsletter sending domain",
  "version": 1,
  "logoUrl": "https://sadorra.app/img/mark.png",
  "description": "Lets Sadorra send newsletters from the domain through Amazon SES, with the three DKIM records SES issues for it.",
  "variableDescription": "dkim1, dkim2, dkim3: the three DKIM tokens Amazon SES issues for the domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "sadorra.app",
  "syncRedirectDomain": "studio.sadorra.app,sadorra-staging.vercel.app",
  "records": [
    { "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 }
  ]
}
