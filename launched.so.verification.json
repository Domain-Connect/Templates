{
  "providerId": "launched.so",
  "providerName": "Launched.so",
  "serviceId": "verification",
  "serviceName": "Domain ownership verification",
  "version": 1,
  "logoUrl": "https://app.launched.so/domain-connect-logo.svg",
  "description": "Verify ownership of your domain for Launched.so by adding a verification TXT record.",
  "syncPubKeyDomain": "domainconnect.launched.so",
  "syncRedirectDomain": "app.launched.so",
  "syncBlock": false,
  "variableDescription": "%verification% is the unique ownership verification token generated by Launched.so.",
  "records": [
    {
      "type": "TXT",
      "host": "_readyowner-verification",
      "ttl": 300,
      "data": "readyowner-verification=%verification%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "readyowner-verification="
    }
  ]
}
