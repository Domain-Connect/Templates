{
  "providerId": "enruta.ai",
  "providerName": "Enruta",
  "serviceId": "ownership",
  "serviceName": "Domain verification",
  "version": 1,
  "logoUrl": "https://enruta.ai/brand/enruta-wordmark-color.svg",
  "description": "Adds the TXT record that verifies this domain belongs to your Enruta account.",
  "variableDescription": "token: the Enruta account's verification token for this domain (32 hexadecimal characters)",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "enruta.ai",
  "syncRedirectDomain": "app.enruta.ai",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "enruta-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "enruta-verify="
    }
  ]
}
