{
    "providerId": "authorsend.com",
    "providerName": "AuthorSend",
    "serviceId": "email-dmarc",
    "serviceName": "AuthorSend DMARC starter record",
    "version": 1,
    "logoUrl": "https://authorsend.com/brand/logo-horizontal.png",
    "description": "Adds a monitoring-only DMARC record (p=none), which Gmail and Yahoo expect from bulk senders. Only applied to a domain that has no DMARC record.",
    "syncBlock": false,
    "syncPubKeyDomain": "authorsend.com",
    "syncRedirectDomain": "authorsend.com,app.authorsend.com",
    "hostRequired": false,
    "records": [
        {
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none;",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        }
    ]
}
