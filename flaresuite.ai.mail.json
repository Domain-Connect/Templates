{
	"providerId": "flaresuite.ai",
	"providerName": "FlareSuite",
	"serviceId": "mail",
	"serviceName": "FlareSuite Mail",
	"version": 1,
	"logoUrl": "https://flaresuite.ai/assets/icon.svg",
	"description": "Sends and receives email for a FlareSuite workspace on the customer's own domain (mail delivered through Resend), and lets mail apps configure themselves (autoconfig, autodiscover, RFC 6186 SRV records pointing at the FlareSuite mail gateway).",
	"variableDescription": "dkim: the DKIM public key issued for the domain (base64); region: the sending region, e.g. us-east-1",
	"syncBlock": false,
	"syncPubKeyDomain": "flaresuite.ai",
	"syncRedirectDomain": "flaresuite.ai",
	"records": [
		{
			"groupId": "send",
			"type": "TXT",
			"host": "resend._domainkey",
			"data": "p=%dkim%",
			"ttl": 3600,
			"txtConflictMatchingMode": "All"
		},
		{
			"groupId": "send",
			"type": "MX",
			"host": "send",
			"pointsTo": "feedback-smtp.%region%.amazonses.com",
			"priority": 10,
			"ttl": 3600
		},
		{
			"groupId": "send",
			"type": "SPFM",
			"host": "send",
			"spfRules": "include:amazonses.com"
		},
		{
			"groupId": "send",
			"type": "CNAME",
			"host": "rsend",
			"pointsTo": "send.forge.rmta.net",
			"ttl": 3600
		},
		{
			"groupId": "receive",
			"type": "MX",
			"host": "@",
			"pointsTo": "receive.forge.rmta.net",
			"priority": 10,
			"ttl": 3600
		},
		{
			"groupId": "dmarc",
			"type": "TXT",
			"host": "_dmarc",
			"data": "v=DMARC1; p=none;",
			"ttl": 3600,
			"txtConflictMatchingMode": "Prefix",
			"txtConflictMatchingPrefix": "v=DMARC1",
			"essential": "OnApply"
		},
		{
			"groupId": "apps",
			"type": "CNAME",
			"host": "autoconfig",
			"pointsTo": "mail.flaresuite.ai",
			"ttl": 3600
		},
		{
			"groupId": "apps",
			"type": "CNAME",
			"host": "autodiscover",
			"pointsTo": "mail.flaresuite.ai",
			"ttl": 3600
		},
		{
			"groupId": "apps",
			"type": "SRV",
			"name": "@",
			"service": "_autodiscover",
			"protocol": "_tcp",
			"priority": 0,
			"weight": 0,
			"port": 443,
			"target": "mail.flaresuite.ai",
			"ttl": 3600
		},
		{
			"groupId": "apps",
			"type": "SRV",
			"name": "@",
			"service": "_imaps",
			"protocol": "_tcp",
			"priority": 0,
			"weight": 1,
			"port": 993,
			"target": "mail.flaresuite.ai",
			"ttl": 3600
		},
		{
			"groupId": "apps",
			"type": "SRV",
			"name": "@",
			"service": "_submissions",
			"protocol": "_tcp",
			"priority": 0,
			"weight": 1,
			"port": 465,
			"target": "mail.flaresuite.ai",
			"ttl": 3600
		},
		{
			"groupId": "apps",
			"type": "SRV",
			"name": "@",
			"service": "_submission",
			"protocol": "_tcp",
			"priority": 0,
			"weight": 1,
			"port": 587,
			"target": "mail.flaresuite.ai",
			"ttl": 3600
		}
	]
}
