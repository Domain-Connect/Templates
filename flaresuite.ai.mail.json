{
	"providerId": "flaresuite.ai",
	"providerName": "FlareSuite",
	"serviceId": "mail",
	"serviceName": "FlareSuite Mail",
	"version": 1,
	"logoUrl": "https://flaresuite.ai/assets/icon.svg",
	"description": "Sends and receives email for a FlareSuite workspace on the customer's own domain (mail delivered through Resend).",
	"variableDescription": "dkim: the DKIM public key issued for the domain (base64); region: the sending region, e.g. us-east-1",
	"syncBlock": false,
	"syncPubKeyDomain": "flaresuite.ai",
	"syncRedirectDomain": "flaresuite.ai",
	"records": [
		{
			"groupId": "send",
			"type": "TXT",
			"host": "resend._domainkey",
			"data": "p=%dkim%",
			"ttl": 3600,
			"txtConflictMatchingMode": "All"
		},
		{
			"groupId": "send",
			"type": "MX",
			"host": "send",
			"pointsTo": "feedback-smtp.%region%.amazonses.com",
			"priority": 10,
			"ttl": 3600
		},
		{
			"groupId": "send",
			"type": "SPFM",
			"host": "send",
			"spfRules": "include:amazonses.com"
		},
		{
			"groupId": "send",
			"type": "CNAME",
			"host": "rsend",
			"pointsTo": "send.forge.rmta.net",
			"ttl": 3600
		},
		{
			"groupId": "receive",
			"type": "MX",
			"host": "@",
			"pointsTo": "receive.forge.rmta.net",
			"priority": 10,
			"ttl": 3600
		},
		{
			"groupId": "dmarc",
			"type": "TXT",
			"host": "_dmarc",
			"data": "v=DMARC1; p=none;",
			"ttl": 3600,
			"txtConflictMatchingMode": "Prefix",
			"txtConflictMatchingPrefix": "v=DMARC1",
			"essential": "OnApply"
		}
	]
}
