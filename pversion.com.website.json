{
  "providerId": "pversion.com",
  "providerName": "PVersion",
  "serviceId": "website",
  "serviceName": "PVersion website",
  "version": 1,
  "logoUrl": "https://pversion.com/logo.png",
  "description": "Points a domain or subdomain at a website published by PVersion.",
  "variableDescription": "ip: IPv4 address of the PVersion web server that hosts the site",
  "syncBlock": false,
  "syncPubKeyDomain": "pversion.com",
  "syncRedirectDomain": "console.pversion.com",
  "hostRequired": false,
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 3600
    }
  ]
}
