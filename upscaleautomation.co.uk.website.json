{
  "providerId": "upscaleautomation.co.uk",
  "providerName": "UpScale Automation",
  "serviceId": "website",
  "serviceName": "Website",
  "version": 1,
  "logoUrl": "https://upscaleautomation.co.uk/favicon.svg",
  "description": "Points www at a website hosted by UpScale Automation on Cloudflare Pages, and forwards the bare domain to www. Email records are not touched.",
  "variableDescription": "project: the site's Cloudflare Pages project name (the part before .pages.dev)",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "upscaleautomation.co.uk",
  "syncRedirectDomain": "platform.upscaleautomation.co.uk",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%project%.pages.dev",
      "ttl": 3600
    },
    {
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%fqdn%"
    }
  ]
}
