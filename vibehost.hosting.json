{
  "providerId": "vibehost",
  "providerName": "VibeHost",
  "serviceId": "hosting",
  "serviceName": "VibeHost Hosting",
  "version": 1,
  "logoUrl": "https://vibehost.vn/logo.svg",
  "description": "Point your domain at VibeHost hosting with a stable CNAME and a TXT ownership challenge.",
  "variableDescription": "host is the subdomain to point (use @ for apex); stable is the per-hosting stable target; txtValue is the ownership challenge token.",
  "syncBlock": false,
  "hostRequired": true,
  "sharedProviderName": false,
  "syncPubKeyDomain": "dc.vibehost.vn",
  "syncRedirectDomain": "vibehost.vn",
  "records": [
    {
      "type": "CNAME",
      "groupId": "hosting",
      "host": "%host%",
      "pointsTo": "%stable%",
      "ttl": 300
    },
    {
      "type": "TXT",
      "groupId": "ownership",
      "host": "_vibehost-challenge.%host%",
      "data": "%txtValue%",
      "ttl": 300
    }
  ]
}