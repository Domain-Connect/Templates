{
  "providerId": "coss.com",
  "providerName": "coss.com",
  "serviceId": "email",
  "serviceName": "coss.com Email",
  "version": 1,
  "logoUrl": "https://coss.com/icon.svg",
  "description": "Authorizes coss.com to send email for the domain through Amazon SES: Easy DKIM signing, a custom MAIL FROM domain (send.<domain>), an optional DMARC record and an optional open/click tracking hostname.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the domain's Easy DKIM tokens issued by Amazon SES. %region%: the AWS region of the SES identity (e.g. us-east-1). %dmarc%: the recommended DMARC record (p=none, aggregate reports to coss.com). %tracking_host%: the tracking hostname relative to the domain (e.g. links).",
  "syncBlock": false,
  "syncPubKeyDomain": "coss.com",
  "syncRedirectDomain": "coss.com",
  "hostRequired": false,
  "multiInstance": true,
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mail_from",
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mail_from",
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "%dmarc%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "%tracking_host%",
      "pointsTo": "track.cosslinks.com",
      "ttl": 3600
    }
  ]
}
