{
  "providerId": "retailspec.com",
  "providerName": "RetailSpec",
  "serviceId": "store-email",
  "serviceName": "RetailSpec store and email",
  "version": 1,
  "description": "Connects your domain to your RetailSpec store and sends your store’s email from it.",
  "variableDescription": "dka1-3: Amazon SES DKIM tokens for the domain; dkb1-3: Amazon SES DKIM tokens for its news. subdomain (campaign email, kept apart from order email); region: the Amazon SES region (e.g. us-east-1).",
  "syncBlock": false,
  "sharedProviderName": false,
  "hostRequired": false,
  "logoUrl": "https://platform.retailspec.com/logo/mark.svg",
  "syncPubKeyDomain": "retailspec.com",
  "syncRedirectDomain": "platform.retailspec.com",
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "216.150.1.1",
      "ttl": 3600,
      "groupId": "storefront"
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "cname.retailspec.com",
      "ttl": 3600,
      "groupId": "storefront"
    },
    {
      "type": "CNAME",
      "host": "%dka1%._domainkey",
      "pointsTo": "%dka1%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%dka2%._domainkey",
      "pointsTo": "%dka2%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%dka3%._domainkey",
      "pointsTo": "%dka3%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "email"
    },
    {
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600,
      "groupId": "email"
    },
    {
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com",
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "links",
      "pointsTo": "cname.retailspec.com",
      "ttl": 3600,
      "groupId": "email"
    },
    {
      "type": "CNAME",
      "host": "%dkb1%._domainkey.news",
      "pointsTo": "%dkb1%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "marketing"
    },
    {
      "type": "CNAME",
      "host": "%dkb2%._domainkey.news",
      "pointsTo": "%dkb2%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "marketing"
    },
    {
      "type": "CNAME",
      "host": "%dkb3%._domainkey.news",
      "pointsTo": "%dkb3%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "marketing"
    },
    {
      "type": "MX",
      "host": "bounce.news",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600,
      "groupId": "marketing"
    },
    {
      "type": "SPFM",
      "host": "bounce.news",
      "spfRules": "include:amazonses.com",
      "groupId": "marketing"
    },
    {
      "type": "CNAME",
      "host": "links.news",
      "pointsTo": "cname.retailspec.com",
      "ttl": 3600,
      "groupId": "marketing"
    },
    {
      "type": "MX",
      "host": "reply",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "priority": 10,
      "ttl": 3600,
      "groupId": "reply"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; adkim=r; aspf=r",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply",
      "groupId": "dmarc"
    }
  ]
}
