{
  "providerId": "brandmyinbox.com",
  "providerName": "Brand My Inbox",
  "serviceId": "mail-send-and-receive",
  "serviceName": "Mail (Sending & Receiving)",
  "version": 1,
  "syncBlock": false,
  "syncPubKeyDomain": "brandmyinbox.com",
  "syncRedirectDomain": "app.brandmyinbox.com,pro.brandmyinbox.com",
  "description": "Authenticated sending (DKIM, SPF, return path, DMARC) and, optionally, receiving at Brand My Inbox. Records mode: everything lives in the customer's own zone.",
  "logoUrl": "https://brandmyinbox.com/domain-connect/logo.svg",
  "records": [
    {
      "groupId": "outbound",
      "type": "CNAME",
      "host": "%dkimSelector%._domainkey",
      "pointsTo": "%dkimTarget%",
      "ttl": 3600
    },
    {
      "groupId": "outbound",
      "type": "CNAME",
      "host": "bounce",
      "pointsTo": "%returnPathTarget%",
      "ttl": 3600
    },
    {
      "groupId": "outbound",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:%spfInclude%"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; %dmarcPolicy%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "inbound",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mxHost%",
      "priority": "%mxPriority%",
      "ttl": 3600
    }
  ]
}
