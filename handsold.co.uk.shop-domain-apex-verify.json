{
  "providerId": "handsold.co.uk",
  "providerName": "Handsold",
  "serviceId": "shop-domain-apex-verify",
  "serviceName": "Your shop on your own domain",
  "version": 1,
  "logoUrl": "https://handsold.co.uk/brand/handsold-mark.svg",
  "description": "Proves the domain is yours to Handsold's host, and points your domain (like yourname.co.uk) and its www at your Handsold shop.",
  "variableDescription": "verify: the proof Handsold's host (Vercel) asked for.",
  "syncBlock": false,
  "syncPubKeyDomain": "handsold.co.uk",
  "records": [
    {
      "type": "TXT",
      "host": "_vercel",
      "data": "%verify%",
      "ttl": 3600
    },
    {
      "type": "A",
      "host": "@",
      "pointsTo": "76.76.21.21",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "cname.vercel-dns.com",
      "ttl": 3600
    }
  ]
}
