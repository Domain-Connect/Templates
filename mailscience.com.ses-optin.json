{
  "providerId": "mailscience.com",
  "providerName": "MailScience",
  "serviceId": "ses-optin",
  "serviceName": "MailScience Opt-In Email Sending",
  "version": 1,
  "description": "Configures DKIM, custom MAIL FROM (SPF/MX), and DMARC records on a dedicated sending subdomain for MailScience opt-in email delivery.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: AWS SES DKIM CNAME tokens; %region%: AWS SES region (e.g. us-east-2).",
  "syncPubKeyDomain": "mailscience.com",
  "syncRedirectDomain": "mailscience.com",
  "hostRequired": true,
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "outbound",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "outbound",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; adkim=r; aspf=r;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
