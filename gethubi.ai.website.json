{
  "providerId": "gethubi.ai",
  "providerName": "Hubi",
  "serviceId": "website",
  "serviceName": "Hubi website",
  "version": 1,
  "logoUrl": "https://gethubi.ai/logo.png",
  "description": "Puts the website Hubi built and hosts for you on your own domain.",
  "variableDescription": "ip: the address the domain points at; wwwtarget: the alias its www. points at; verify: the token proving the domain is yours",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "domainconnect.gethubi.ai",
  "syncRedirectDomain": "app.gethubi.ai,app.hubapp.dev",
  "hostRequired": false,
  "records": [
    {
      "groupId": "apex",
      "type": "A",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 600
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%wwwtarget%",
      "ttl": 600
    },
    {
      "groupId": "ownership",
      "type": "TXT",
      "host": "_vercel",
      "data": "vc-domain-verify=%verify%",
      "ttl": 600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
