{
  "providerId": "shipmail.to",
  "providerName": "Shipmail",
  "serviceId": "newsletter",
  "serviceName": "Shipmail Newsletters",
  "version": 1,
  "hostRequired": true,
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.shipmail.to",
  "syncRedirectDomain": "shipmail.to",
  "logoUrl": "https://shipmail.to/domain-connect-logo.svg",
  "description": "Configures DNS records for a Shipmail newsletter sending subdomain.",
  "variableDescription": "%dkim% is the DKIM TXT value generated by Shipmail for this sending subdomain. %region% is the AWS region that sends the newsletters.",
  "records": [
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "shipmail._domainkey",
      "data": "%dkim%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DKIM1"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "mail",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 300
    },
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "mail",
      "data": "v=spf1 include:amazonses.com -all",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=spf1"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=reject",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
