{
  "providerId": "arkanasecurity.com",
  "providerName": "Arkana Security",
  "serviceId": "domain-verification",
  "serviceName": "Domain verification",
  "version": 1,
  "description": "Adds the TXT record Arkana uses to verify that the organization controls the domain before running security scans on it.",
  "variableDescription": "verification: per-domain verification token generated by Arkana",
  "syncBlock": false,
  "sharedProviderName": false,
  "hostRequired": false,
  "syncPubKeyDomain": "arkanasecurity.com",
  "syncRedirectDomain": "arkanasecurity.com,app.arkanasecurity.com",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "arkana-verification=%verification%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "arkana-verification="
    }
  ]
}
