{
  "providerId": "thaibulksms.com-thaibulkmail.com",
  "providerName": "ThaiBulkSMS",
  "serviceId": "email",
  "serviceName": "ThaiBulkMail Email Service",
  "version": 4,
  "logoUrl": "https://www.thaibulksms.com/assets/images/og-tbs-main.jpg",
  "description": "Configure the DKIM and SPF records required to verify a ThaiBulkMail sending domain.",
  "variableDescription": "dkimSelector1..4 are the DKIM selectors issued by ThaiBulkMail.",
  "syncPubKeyDomain": "thaibulksms.com",
  "syncBlock": false,
  "syncRedirectDomain": "thaibulksms.com",
  "records": [
    { "groupId": "dkim", "type": "CNAME", "host": "%dkimSelector1%._domainkey", "pointsTo": "%dkimSelector1%._domainkey.v.thaibulkmail.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkimSelector2%._domainkey", "pointsTo": "%dkimSelector2%._domainkey.v.thaibulkmail.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkimSelector3%._domainkey", "pointsTo": "%dkimSelector3%._domainkey.v.thaibulkmail.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkimSelector4%._domainkey", "pointsTo": "%dkimSelector4%._domainkey.v.thaibulkmail.com", "ttl": 3600 },
    { "groupId": "spf", "type": "SPFM", "host": "@", "spfRules": "include:v.thaibulkmail.com" }
  ]
}
