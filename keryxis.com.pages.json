{
    "providerId": "keryxis.com",
    "providerName": "Keryxis",
    "serviceId": "pages",
    "serviceName": "Keryxis text-message pages",
    "version": 1,
    "logoUrl": "https://keryxis.com/logo.svg",
    "description": "Points a subdomain (for example sms.yourbusiness.com) at Keryxis, which serves your text-message sign-up, terms and privacy pages there.",
