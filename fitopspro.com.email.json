{
  "providerId": "fitopspro.com",
  "providerName": "FitOps Pro",
  "serviceId": "email",
  "serviceName": "FitOps Pro email and booking pages",
  "version": 2,
  "logoUrl": "https://app.fitopspro.com/assets/brand/fitops-icon-sapphire.svg",
  "description": "Lets FitOps Pro send email from your own domain, receive replies to it, handle bounced email under your name, and put your booking pages on an address of your own domain, such as book.yourgym.com. Each group is applied only while its records are missing.",
  "variableDescription": "dkim1, dkim2, dkim3: the three DKIM tokens Amazon SES gives for the domain. booking: the first label of the booking address, such as book. owner: the ownership value Cloudflare for SaaS gives for that address. mktkey: the public key of the domain's marketing email DKIM key. gsv: Google's Gmail Postmaster Tools verification token.",
  "syncBlock": false,
  "syncPubKeyDomain": "fitopspro.com",
  "syncRedirectDomain": "app.fitopspro.com",
  "records": [
    { "groupId": "owner", "type": "TXT", "host": "_cf-custom-hostname.%booking%", "data": "%owner%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "groupId": "booking", "type": "CNAME", "host": "%booking%", "pointsTo": "bookings.fitopspro.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "groupId": "dkim", "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 },
    { "groupId": "dmarc", "type": "TXT", "host": "_dmarc", "data": "v=DMARC1; p=none;", "ttl": 3600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DMARC1", "essential": "OnApply" },
    { "groupId": "reply", "type": "MX", "host": "reply", "pointsTo": "inbound-smtp.us-east-1.amazonaws.com", "priority": 10, "ttl": 3600 },
    { "groupId": "bounce", "type": "MX", "host": "bounce", "pointsTo": "feedback-smtp.us-east-1.amazonses.com", "priority": 10, "ttl": 3600 },
    { "groupId": "bounce", "type": "SPFM", "host": "bounce", "spfRules": "include:amazonses.com" },
    { "groupId": "mkt", "type": "TXT", "host": "fitops1._domainkey", "data": "v=DKIM1; k=rsa; p=%mktkey%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "groupId": "gmail", "type": "TXT", "host": "@", "data": "google-site-verification=%gsv%", "ttl": 3600 }
  ]
}
