{
  "providerId": "omnisend.com",
  "providerName": "Omnisend",
  "serviceId": "sender-domain-authentication",
  "serviceName": "Omnisend Sender Domain Authentication",
  "version": 1,
  "logoUrl": "https://www.omnisend.com/wp-content/uploads/2026/10/omnisend_logo_dark.svg",
  "description": "Publishes SPF, DKIM and optionally DMARC records so Omnisend can send authenticated email from a customer's sender domain (apex or subdomain via the host parameter).",
  "variableDescription": "dkimSelector: DKIM selector assigned by Omnisend's sending infrastructure; dkimPublicKey: base64 RSA public key for that selector",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.omnisenddns.com",
  "syncRedirectDomain": "app.omnisend-dev.work,app.omnisend.work,app.omnisend.com",
  "records": [
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:mailgun.org",
      "essential": "OnApply"
    },
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimSelector%._domainkey",
      "data": "k=rsa; p=%dkimPublicKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
