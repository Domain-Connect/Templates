{
  "providerId": "vaartix.com",
  "providerName": "Vaartix",
  "serviceId": "email-easydkim",
  "serviceName": "Vaartix email sending (older domains, three DKIM keys)",
  "version": 1,
  "logoUrl": "https://vaartix.com/favicon.svg",
  "description": "Lets Vaartix send email from your domain: three DKIM signing keys and a return path for bounces.",
  "variableDescription": "dkim1, dkim2, dkim3: Amazon SES DKIM tokens; bounce: return-path label, such as vxmail (vx-bounces on older domains); region: AWS region of the mail servers, such as ap-south-1",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "vaartix.com",
  "syncRedirectDomain": "app.vaartix.com",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "%bounce%",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "%bounce%",
      "spfRules": "include:amazonses.com"
    }
  ]
}
