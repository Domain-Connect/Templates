{
  "providerId": "mordi.ai",
  "providerName": "Mordi",
  "serviceId": "sending",
  "serviceName": "Mordi email sending",
  "version": 1,
  "logoUrl": "https://mordi.ai/brand/mordi-avatar.png",
  "description": "Lets Mordi send your store's marketing emails from your own domain through Amazon SES: DKIM signing, a bounce subdomain covered by SPF, and a DMARC policy.",
  "variableDescription": "dkim1, dkim2, dkim3: the Amazon SES Easy DKIM tokens for the domain; region: the Amazon SES region, for example us-east-1",
  "syncBlock": false,
  "syncPubKeyDomain": "mordi.ai",
  "syncRedirectDomain": "app.mordi.ai",
  "hostRequired": true,
  "records": [
    { "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.dkim.amazonses.com", "ttl": 3600 },
    { "type": "MX", "host": "bounce", "pointsTo": "feedback-smtp.%region%.amazonses.com", "priority": 10, "ttl": 3600 },
    { "type": "SPFM", "host": "bounce", "spfRules": "include:amazonses.com" },
    { "type": "TXT", "host": "_dmarc", "data": "v=DMARC1; p=none;", "ttl": 3600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DMARC1", "essential": "OnApply" }
  ]
}
