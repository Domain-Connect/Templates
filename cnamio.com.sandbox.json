{
  "providerId": "cnamio.com",
  "providerName": "Cnamio",
  "serviceId": "sandbox",
  "serviceName": "Cnamio Sandbox",
  "version": 1,
  "logoUrl": "https://cnamio.com/brand/cnamio-logo.svg",
  "description": "Connects a subdomain to Cnamio Sandbox through Cnamio. The host is required; no apex, nameserver or redirect records are set.",
  "variableDescription": "token: values generated by Cnamio Sandbox for each connection.",
  "hostRequired": true,
  "syncPubKeyDomain": "domainconnect.cnamio.com",
  "syncRedirectDomain": "api.cnamio.com",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "sandbox.cnamio.com",
      "ttl": 300
    },
    {
      "type": "TXT",
      "host": "_cnamio-sandbox",
      "data": "cnamio-sandbox=%token%",
      "ttl": 300
    }
  ]
}
