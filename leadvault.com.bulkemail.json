{
    "providerId": "leadvault.com",
    "providerName": "LeadVault",
    "serviceId": "bulkemail",
    "serviceName": "Email sending",
    "version": 1,
    "logoUrl": "https://leadvault.com/img/favicon.svg",
    "description": "Lets LeadVault send email from the customer's own domain through Amazon SES. Group dkim: the three SES Easy DKIM CNAMEs. Group dmarc: a starter DMARC policy, applied only when the domain has no DMARC record yet.",
    "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the domain's Amazon SES Easy DKIM tokens",
    "syncBlock": false,
    "syncPubKeyDomain": "leadvault.com",
    "syncRedirectDomain": "leadvault.com,test.leadvault.com",
    "records": [
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim1%._domainkey",
            "pointsTo": "%dkim1%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim2%._domainkey",
            "pointsTo": "%dkim2%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dkim",
            "type": "CNAME",
            "host": "%dkim3%._domainkey",
            "pointsTo": "%dkim3%.dkim.amazonses.com",
            "ttl": 3600
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none;",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        }
    ]
}
