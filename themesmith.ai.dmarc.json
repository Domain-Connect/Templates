{
  "providerId": "themesmith.ai",
  "providerName": "ThemeSmith",
  "serviceId": "dmarc",
  "serviceName": "DMARC",
  "version": 1,
  "logoUrl": "https://themesmith.ai/favicon.svg",
  "description": "Adds a report-only DMARC record at _dmarc. ThemeSmith offers this only when the domain has no DMARC record yet. Other TXT records are left as they are.",
  "syncBlock": false,
  "syncPubKeyDomain": "themesmith.ai",
  "syncRedirectDomain": "app.themesmith.ai",
  "records": [
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc@themesmith.ai",
      "ttl": "300",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
