{
  "providerId": "signveria.com",
  "providerName": "Signveria",
  "logoUrl": "https://signveria.com/esign.svg",
  "version": 1,
  "syncBlock": false,
  "multiInstance": true,
  "syncPubKeyDomain": "domainconnect.signveria.com",
  "syncRedirectDomain": "signveria.com,admin.signveria.com,m.signveria.com,gladmin.signveria.com",
  "serviceId": "email-dkim",
  "serviceName": "Amazon SES sending domain",
  "description": "Retain tenant ownership proof and configure the three Easy DKIM CNAMEs returned by Amazon SES. Incoming mail is unchanged.",
  "variableDescription": "proof: 64 lowercase hexadecimal characters generated by Signveria. dkim1, dkim2, dkim3: distinct 32-character lowercase alphanumeric SES selectors. Only the dkim.amazonses.com signing zone is supported by this template.",
  "records": [
    {
      "type": "TXT",
      "host": "_signveria-mail",
      "data": "signveria=%proof%",
      "ttl": 300,
      "txtConflictMatchingMode": "None"
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 300
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 300
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 300
    }
  ]
}
