{
  "providerId": "inbox4u.biz",
  "providerName": "inbox4u",
  "serviceId": "mail-sending",
  "serviceName": "inbox4u business email (sending)",
  "version": 1,
  "logoUrl": "https://inbox4u.biz/icon.svg",
  "description": "Authorizes inbox4u to send email on behalf of the domain: DKIM signature, a bounce subdomain with SPF.",
  "variableDescription": "dkimkey: the DKIM public key (base64, without the 'p=' prefix) for the domain; region: the sending region, e.g. ap-northeast-1",
  "syncBlock": false,
  "syncPubKeyDomain": "inbox4u.biz",
  "syncRedirectDomain": "app.inbox4u.biz",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    }
  ]
}
