{
  "providerId": "champion.io",
  "providerName": "Champion",
  "serviceId": "studio-domain",
  "serviceName": "Champion website, email sending, payments and contracts",
  "version": 1,
  "logoUrl": "https://champion.io/logo.svg",
  "description": "Connects a domain to a Champion Studio website (apex + www), adds pay. and sign. subdomains for payment pages and contracts, and authenticates bulk email sent through Postmark (DKIM, Return-Path, optional DMARC).",
  "variableDescription": "%dkimselector%: Postmark DKIM selector label (e.g. 20261020123456pm); %dkimkey%: Postmark DKIM public key (the part after p=)",
  "syncPubKeyDomain": "dc.champion.io",
  "syncRedirectDomain": "studio.champion.io",
  "hostRequired": false,
  "records": [
    { "groupId": "website", "type": "A",    "host": "@",   "pointsTo": "162.159.140.98", "ttl": 3600 },
    { "groupId": "website", "type": "A",    "host": "@",   "pointsTo": "172.66.0.96",    "ttl": 3600 },
    { "groupId": "website", "type": "AAAA", "host": "@",   "pointsTo": "2606:4700:7::60",  "ttl": 3600 },
    { "groupId": "website", "type": "AAAA", "host": "@",   "pointsTo": "2a06:98c1:58::60", "ttl": 3600 },
    { "groupId": "website", "type": "CNAME","host": "www", "pointsTo": "champion-studio-knb4s.ondigitalocean.app", "ttl": 3600 },

    { "groupId": "apps", "type": "CNAME", "host": "pay",  "pointsTo": "champion-studio-knb4s.ondigitalocean.app", "ttl": 3600 },
    { "groupId": "apps", "type": "CNAME", "host": "sign", "pointsTo": "champion-studio-knb4s.ondigitalocean.app", "ttl": 3600 },

    { "groupId": "email", "type": "TXT",   "host": "%dkimselector%._domainkey", "data": "k=rsa;p=%dkimkey%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "groupId": "email", "type": "CNAME", "host": "pm-bounces", "pointsTo": "pm.mtasv.net", "ttl": 3600 },

    { "groupId": "dmarc", "type": "TXT", "host": "_dmarc", "data": "v=DMARC1; p=none;", "ttl": 3600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DMARC1", "essential": "OnApply" }
  ]
}
