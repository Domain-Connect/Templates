{
  "providerId": "mailrift.io",
  "providerName": "MailRift",
  "serviceId": "email",
  "serviceName": "MailRift Email",
  "version": 1,
  "logoUrl": "https://mailrift.io/logo.png",
  "description": "Configure MX, SPF, DMARC and DKIM so MailRift can send and receive email for your domain.",
  "variableDescription": "Per-domain DKIM selectors and DMARC reporting address.",
  "syncBlock": false,
  "warnPhishing": true,
  "syncRedirectDomain": "mailrift.io,mailrift.ch",
  "hostRequired": false,
  "records": [
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.eu-central-1.amazonaws.com",
      "priority": 10,
      "ttl": 300
    },
    {
      "type": "MX",
      "host": "mail",
      "pointsTo": "feedback-smtp.eu-central-1.amazonses.com",
      "priority": 10,
      "ttl": 300
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "SPFM",
      "host": "mail",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:%dmarcrua%; ruf=mailto:%dmarcrua%; adkim=r; aspf=r; fo=1; pct=100;",
      "ttl": 3600,
      "essential": "OnApply",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    },
    {
      "type": "CNAME",
      "host": "%dkim0%._domainkey",
      "pointsTo": "%dkim0%.dkim.amazonses.com",
      "ttl": 1800
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 1800
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 1800
    }
  ]
}
