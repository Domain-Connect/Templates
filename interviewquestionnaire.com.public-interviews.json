{
  "providerId": "interviewquestionnaire.com",
  "providerName": "InterviewPro Connect",
  "serviceId": "public-interviews",
  "serviceName": "Public interview domain",
  "version": 1,
  "syncBlock": false,
  "syncPubKeyDomain": "interviewquestionnaire.com",
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "216.150.1.1",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_interviewpro-domain",
      "data": "interviewpro-verification=%challenge%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "interviewpro-verification="
    }
  ],
  "logoUrl": "https://interviewpro-connect.vercel.app/favicon.png",
  "description": "Connect a customer domain or subdomain to a public InterviewPro Connect questionnaire.",
  "variableDescription": "challenge: A random ownership token generated by InterviewPro Connect for this connection."
}
