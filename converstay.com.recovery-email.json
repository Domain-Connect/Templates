{
  "providerId": "converstay.com",
  "providerName": "Converstay",
  "serviceId": "recovery-email",
  "serviceName": "Converstay booking recovery email",
  "version": 1,
  "logoUrl": "https://www.converstay.com/favicon.svg",
  "description": "Lets Converstay send booking recovery email for your hotel from this domain (via Resend), with DKIM, SPF, bounce handling, link tracking and an optional DMARC record.",
  "variableDescription": "%dkimKey%: DKIM public key issued for this domain (the part after p=); %region%: sending region of the bounce MX host, e.g. us-east-1",
  "syncBlock": false,
  "syncPubKeyDomain": "converstay.com",
  "syncRedirectDomain": "converstay.com,www.converstay.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "returnpath",
      "type": "CNAME",
      "host": "rsend",
      "pointsTo": "send.forge.rmta.net",
      "ttl": 3600
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "link",
      "pointsTo": "links2.resend-dns.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
