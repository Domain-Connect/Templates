{
  "providerId": "converstay.com",
  "providerName": "Converstay",
  "serviceId": "recovery-email",
  "serviceName": "Converstay booking recovery email",
  "version": 2,
  "logoUrl": "https://www.converstay.com/favicon.svg",
  "description": "Lets Converstay send booking recovery email for your hotel from this domain (through Amazon SES), with DKIM signing, a bounce subdomain with SPF, a links subdomain for open and click tracking and an optional DMARC record.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the domain's Amazon SES DKIM tokens; %region%: its Amazon SES region, e.g. us-east-2",
  "syncBlock": false,
  "syncPubKeyDomain": "converstay.com",
  "syncRedirectDomain": "converstay.com,www.converstay.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "links",
      "pointsTo": "track.mailroom.vallepinto.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
