{
  "providerId": "sendtier.com",
  "providerName": "Sendtier",
  "serviceId": "mail-nodmarc",
  "serviceName": "Email sending (existing DMARC)",
  "version": 1,
  "logoUrl": "https://sendtier.com/icon.svg",
  "description": "Adds the DKIM and return-path records for sending email with Sendtier, for a domain that already publishes DMARC.",
  "variableDescription": "dkimkey: the domain's DKIM public key (base64)",
  "syncBlock": false,
  "syncPubKeyDomain": "mail-nodmarc.dc.sendtier.com",
  "syncRedirectDomain": "app.sendtier.com",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "st1._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "CNAME",
      "host": "send",
      "pointsTo": "rp.sendtier.com",
      "ttl": 3600
    }
  ]
}
