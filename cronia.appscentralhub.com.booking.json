{
  "providerId": "cronia.appscentralhub.com",
  "providerName": "Crónia",
  "serviceId": "booking",
  "serviceName": "Página de marcações",
  "version": 1,
  "syncPubKeyDomain": "cronia.appscentralhub.com",
  "description": "Connect a dedicated subdomain to the public Crónia booking page. Email records are not changed.",
  "variableDescription": "verification: ownership code generated by Crónia for this company and hostname.",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cronia.appscentralhub.com",
      "ttl": 600
    },
    {
      "type": "TXT",
      "host": "_cronia",
      "data": "cronia-verification=%verification%",
      "ttl": 600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "cronia-verification="
    }
  ],
  "hostRequired": true,
  "logoUrl": "https://cronia.appscentralhub.com/assets/cronia-mark.svg"
}
