{
    "providerId": "bulletinbook.com",
    "providerName": "BulletinBook",
    "serviceId": "custom-domain",
    "serviceName": "BulletinBook community site",
    "version": 1,
    "description": "Connects your domain and its www name to your BulletinBook community site. Email records are not changed.",
    "syncPubKeyDomain": "domainconnect.bulletinbook.com",
    "syncBlock": false,
    "hostRequired": true,
    "records": [
        { "type": "CNAME", "host": "@", "pointsTo": "%target%", "ttl": 3600 },
        { "type": "CNAME", "host": "www", "pointsTo": "%target%", "ttl": 3600 }
    ]
}
