{
    "providerId": "bulletinbook.com",
    "providerName": "BulletinBook",
    "serviceId": "custom-domain",
    "serviceName": "BulletinBook community site",
    "version": 1,
    "description": "Connects your domain to your BulletinBook community site: www points to the site and the bare domain redirects to www. Email records are not changed.",
    "syncPubKeyDomain": "domainconnect.bulletinbook.com",
    "syncBlock": false,
    "records": [
        { "type": "CNAME", "host": "www", "pointsTo": "%target%", "ttl": 3600 },
        { "type": "REDIR301", "host": "@", "target": "https://www.%fqdn%" }
    ]
}
