{
  "providerId": "bulkmail.dev",
  "providerName": "BulkMail",
  "serviceId": "email-sending",
  "serviceName": "BulkMail Email Sending",
  "version": 1,
  "logoUrl": "https://bulkmail.dev/icon-512.png",
  "description": "Adds the DKIM, SPF and bounce MX records needed to send email through BulkMail.",
  "variableDescription": "selector: DKIM selector generated by BulkMail; dkimkey: base64 DKIM public key",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.bulkmail.dev",
  "syncRedirectDomain": "bulkmail.dev",
  "records": [
    {
      "type": "TXT",
      "host": "%selector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:_spf.bulkmail.dev"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "mail.bulkmail.dev",
      "priority": 10,
      "ttl": 3600
    }
  ]
}
