{
  "providerId": "funnellingo.com",
  "providerName": "FunnelLingo",
  "serviceId": "dashboard",
  "serviceName": "Custom dashboard address",
  "version": 1,
  "logoUrl": "https://app.funnellingo.com/funnellingo-mark.svg",
  "description": "Connects a dedicated subdomain to the company dashboard and adds its ownership verification record.",
  "variableDescription": "%verification%: hostname-bound ownership challenge generated by FunnelLingo.",
  "syncPubKeyDomain": "taptapdns.com",
  "syncRedirectDomain": "api.taptapdns.com",
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "seo-fallback.funnellingo.com.",
      "ttl": 300
    },
    {
      "type": "TXT",
      "host": "_translation-workspace-dashboard",
      "data": "translation-workspace-dashboard=%verification%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "translation-workspace-dashboard="
    }
  ]
}
