{
  "providerId": "selltrust.app",
  "providerName": "SellTrust",
  "serviceId": "storefront",
  "serviceName": "SellTrust storefront",
  "version": 2,
  "logoUrl": "https://selltrust.app/brand/mark-color.svg",
  "description": "Points your domain to your SellTrust storefront.",
  "variableDescription": "IP: the address of the SellTrust storefront servers; TARGET: the host name the www record points to",
  "syncBlock": false,
  "syncPubKeyDomain": "selltrust.app",
  "syncRedirectDomain": "dashboard.selltrust.app,dev-dashboard.selltrust.app",
  "hostRequired": false,
  "records": [
    {
      "groupId": "root",
      "type": "A",
      "host": "@",
      "pointsTo": "%IP%",
      "ttl": 300
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%TARGET%",
      "ttl": 300
    }
  ]
}
