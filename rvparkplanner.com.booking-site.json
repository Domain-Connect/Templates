{
    "providerId": "rvparkplanner.com",
    "providerName": "RV Park Planner",
    "serviceId": "booking-site",
    "serviceName": "RV Park Planner booking website",
    "version": 1,
    "logoUrl": "https://rvparkplanner.com/images/domain-connect-logo.png",
    "description": "Points your domain (and www) at your RV Park Planner booking website and adds a TXT record that proves you own the domain.",
    "variableDescription": "ip: the IPv4 address of the RV Park Planner server (A record for the domain); token: the one-time ownership code shown in RV Park Planner, without its rvpp- prefix (TXT record at _rvpp-verify, written as rvpp-<token>)",
    "syncBlock": false,
    "syncPubKeyDomain": "rvparkplanner.com",
    "syncRedirectDomain": "rvparkplanner.com",
    "hostRequired": false,
    "records": [
        {
            "type": "A",
            "host": "@",
            "pointsTo": "%ip%",
            "ttl": 600
        },
        {
            "type": "CNAME",
            "host": "www",
            "pointsTo": "@",
            "ttl": 600
        },
        {
            "type": "TXT",
            "host": "_rvpp-verify",
            "data": "rvpp-%token%",
            "ttl": 600,
            "txtConflictMatchingMode": "All"
        }
    ]
}
