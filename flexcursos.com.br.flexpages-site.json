{
  "providerId": "flexcursos.com.br",
  "providerName": "Flexpages",
  "serviceId": "flexpages-site",
  "serviceName": "Site Flexpages",
  "description": "Connect a domain managed by Cloudflare to a Flexpages website.",
  "version": 1,
  "syncBlock": false,
  "hostRequired": true,
  "syncPubKeyDomain": "dc.flexcursos.com.br",
  "variableDescription": "%verification% is the UUID ownership token generated by Flexpages for this domain.",
  "records": [
    {
      "type": "TXT",
      "host": "_flexpages",
      "data": "flexpages-verification=%verification%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "flexpages-verification=",
      "ttl": 600
    },
    { "type": "CNAME", "host": "@", "pointsTo": "sites.flexcursos.com.br", "ttl": 600 }
  ]
}
