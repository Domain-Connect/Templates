{
  "providerId": "darkstrata.io",
  "providerName": "DarkStrata",
  "serviceId": "domain-verification",
  "serviceName": "Domain Verification",
  "version": 2,
  "logoUrl": "https://darkstrata.io/images/favicons/favicon-512.png",
  "description": "Verify domain ownership for DarkStrata threat monitoring",
  "variableDescription": "Unique verification code for domain ownership verification",
  "multiInstance": false,
  "syncBlock": false,
  "syncPubKeyDomain": "darkstrata.io",
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "_darkstrata-domain-verification=%verification%",
      "ttl": 3600
    }
  ]
}
