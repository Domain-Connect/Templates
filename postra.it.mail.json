{
    "providerId": "postra.it",
    "providerName": "Postra",
    "serviceId": "mail",
    "serviceName": "Postra Mail",
    "version": 2,
    "logoUrl": "https://postra.it/assets/postra-logo.svg",
    "description": "Configures a domain for Postra email hosting: ownership verification, inbound MX, SPF, DKIM, outbound relay authentication and DMARC.",
    "variableDescription": "%token%: Postra ownership verification token; %dkimkey%: Ed25519 DKIM public key (p= value) for the postra selector",
    "syncBlock": false,
    "syncPubKeyDomain": "postra.it",
    "syncRedirectDomain": "panel.postra.it",
    "records": [
        {
            "groupId": "mail",
            "type": "TXT",
            "host": "_postra",
            "data": "postra-verification=%token%",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "postra-verification="
        },
        {
            "groupId": "mail",
            "type": "MX",
            "host": "@",
            "pointsTo": "mail.postra.it",
            "priority": 10,
            "ttl": 3600
        },
        {
            "groupId": "mail",
            "type": "SPFM",
            "host": "@",
            "spfRules": "include:spf.smtp2go.com"
        },
        {
            "groupId": "mail",
            "type": "TXT",
            "host": "postra._domainkey",
            "data": "v=DKIM1; k=ed25519; h=sha256; p=%dkimkey%",
            "ttl": 3600,
            "txtConflictMatchingMode": "All"
        },
        {
            "groupId": "mail",
            "type": "CNAME",
            "host": "postra",
            "pointsTo": "return.smtp2go.net",
            "ttl": 3600
        },
        {
            "groupId": "mail",
            "type": "CNAME",
            "host": "s797385._domainkey",
            "pointsTo": "dkim.smtp2go.net",
            "ttl": 3600
        },
        {
            "groupId": "dmarc",
            "type": "TXT",
            "host": "_dmarc",
            "data": "v=DMARC1; p=none; rua=mailto:dmarc@postra.it",
            "ttl": 3600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1",
            "essential": "OnApply"
        }
    ]
}
