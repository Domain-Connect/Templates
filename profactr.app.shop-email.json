{
  "providerId": "profactr.app",
  "providerName": "Profactr",
  "serviceId": "shop-email",
  "serviceName": "Profactr shop email",
  "version": 1,
  "logoUrl": "https://profactr.com/profactr-connect.png",
  "description": "Lets your Profactr shop send email from your own domain.",
  "syncPubKeyDomain": "profactr.app",
  "syncRedirectDomain": "profactr.app",
  "records": [
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%sesRegion%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimPublicKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
