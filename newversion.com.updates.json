{
  "providerId": "newversion.com",
  "providerName": "NewVersion",
  "serviceId": "updates",
  "serviceName": "App updates and licensing",
  "version": 1,
  "logoUrl": "https://admin.newversion.com/brand/logo@2x.png",
  "description": "Points a hostname at NewVersion so a desktop app can check for updates and activate licenses there.",
  "variableDescription": "The hostname is chosen in the NewVersion console.",
  "syncBlock": false,
  "sharedProviderName": false,
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cname.newversion.com",
      "ttl": 300
    }
  ]
}
