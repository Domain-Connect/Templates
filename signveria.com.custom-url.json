{
  "providerId": "signveria.com",
  "providerName": "Signveria",
  "logoUrl": "https://signveria.com/esign.svg",
  "version": 1,
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.signveria.com",
  "syncRedirectDomain": "signveria.com,admin.signveria.com,m.signveria.com,gladmin.signveria.com",
  "serviceId": "custom-url",
  "serviceName": "Custom signing URL",
  "description": "Verify ownership and route a custom signing subdomain to Signveria.",
  "hostRequired": true,
  "variableDescription": "proof: 64 lowercase hexadecimal characters generated by Signveria for this tenant and hostname.",
  "records": [
    {
      "type": "TXT",
      "host": "_esign-verification",
      "data": "esign=%proof%",
      "ttl": 300,
      "txtConflictMatchingMode": "None"
    },
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cname.signveria.com",
      "ttl": 300
    }
  ]
}
