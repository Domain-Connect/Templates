{
  "providerId": "mailif.uvxyz.in",
  "providerName": "Mailif",
  "serviceId": "email",
  "serviceName": "Mailif Email Forwarding & Routing",
  "version": 1,
  "logoUrl": "https://mailif.uvxyz.in/logo.png",
  "description": "Configures MX, SPF, DMARC and DKIM records for Mailif inbound email forwarding and delivery.",
  "syncPubKeyDomain": "mailif.uvxyz.in",
  "syncRedirectDomain": "mailif.uvxyz.in",
  "variableDescription": "%dkim1%: First DKIM CNAME token generated by Mailif; %dkim2%: Second DKIM CNAME token generated by Mailif; %dkim3%: Third DKIM CNAME token generated by Mailif",
  "records": [
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "mx.mailif.uvxyz.in",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:mailif.uvxyz.in"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "dkim",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "dkim",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "groupId": "dkim",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    }
  ]
}
