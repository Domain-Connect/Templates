{
  "providerId": "mailif.uvxyz.in",
  "providerName": "Mailif",
  "serviceId": "email",
  "serviceName": "Mailif Email Forwarding & Routing",
  "version": 1,
  "logoUrl": "https://mailif.uvxyz.in/logo.png",
  "description": "Configures MX, SPF, DMARC and DKIM records for Mailif inbound email forwarding and delivery.",
  "syncPubKeyDomain": "mailif.uvxyz.in",
  "syncRedirectUrl": "https://mailif.uvxyz.in",
  "variableDescription": {
    "dkim1": "First DKIM CNAME token generated by Mailif",
    "dkim2": "Second DKIM CNAME token generated by Mailif",
    "dkim3": "Third DKIM CNAME token generated by Mailif"
  },
  "records": [
    {
      "type": "MX",
      "name": "@",
      "target": "mx.mailif.uvxyz.in",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "TXT",
      "name": "@",
      "data": "v=spf1 include:mailif.uvxyz.in ~all",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "name": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "name": "%dkim1%._domainkey",
      "target": "%dkim1%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "name": "%dkim2%._domainkey",
      "target": "%dkim2%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "name": "%dkim3%._domainkey",
      "target": "%dkim3%.dkim.mailif.uvxyz.in",
      "ttl": 3600
    }
  ]
}
