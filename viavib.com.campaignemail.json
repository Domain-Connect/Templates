
{
  "providerId": "viavib.com",
  "providerName": "ViaVib",
  "serviceId": "campaignemail",
  "serviceName": "ViaVib email campaigns",
  "version": 2,
  "logoUrl": "https://viavib.com/apple-touch-icon.png",
  "description": "Connects your domain to send ViaVib email campaigns from your own address. Adds email verification and signing records only \u2014 your website and normal mail routing are untouched.",
  "variableDescription": "OWNERSHIP_TOKEN proves domain ownership. SG_ACCOUNT is your ViaVib sending account at SendGrid (e.g. u123.wl062). The bounce-handling name is always vvb. All values are generated by ViaVib for your domain.",
  "syncRedirectDomain": "viavib.com",
  "syncPubKeyDomain": "viavib.com",
  "shared": false,
  "multiInstance": false,
  "records": [
    {
      "type": "TXT",
      "host": "_viavib",
      "data": "viavib-verify=%OWNERSHIP_TOKEN%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "viavib-verify="
    },
    {
      "type": "CNAME",
      "host": "s1._domainkey",
      "pointsTo": "s1.domainkey.%SG_ACCOUNT%.sendgrid.net",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "s2._domainkey",
      "pointsTo": "s2.domainkey.%SG_ACCOUNT%.sendgrid.net",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "vvb",
      "pointsTo": "%SG_ACCOUNT%.sendgrid.net",
      "ttl": 3600
    }
  ]
}
