{
  "providerId": "fast.site",
  "providerName": "fast.site",
  "serviceId": "edge",
  "serviceName": "Website acceleration",
  "version": 1,
  "logoUrl": "https://fast.site/icon.svg",
  "description": "Connects your domain to the fast.site edge network: an ownership TXT record, and your domain and www pointed at edge.fast.site.",
  "variableDescription": "token: the per-domain ownership token shown in the fast.site dashboard",
  "syncBlock": false,
  "syncPubKeyDomain": "fast.site",
  "syncRedirectDomain": "fast.site",
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "_fastsite-verify",
      "data": "fastsite-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "apex",
      "type": "APEXCNAME",
      "host": "@",
      "pointsTo": "edge.fast.site",
      "ttl": 3600
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "edge.fast.site",
      "ttl": 3600
    }
  ]
}
