{
  "providerId": "absolutejs.ai",
  "providerName": "AbsoluteJS",
  "serviceId": "custom-domain",
  "serviceName": "AbsoluteJS custom domain (subdomain)",
  "version": 1,
  "logoUrl": "https://avatars.githubusercontent.com/u/207762196?v=4",
  "description": "Connect a subdomain to an app hosted on AbsoluteJS: a certificate validation record, and the record that sends visitors to the AbsoluteJS edge.",
  "variableDescription": "%acmeToken%: the domain's certificate validation token issued by AbsoluteJS, a 32-character hexadecimal string",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.absolutejs.ai",
  "syncRedirectDomain": "absolutejs.ai",
  "hostRequired": true,
  "records": [
    {
      "groupId": "certificate",
      "type": "CNAME",
      "host": "_acme-challenge",
      "pointsTo": "%acmeToken%.acme.absolutejs.app",
      "ttl": 600,
      "essential": "Always"
    },
    {
      "groupId": "traffic",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "edge.absolutejs.app",
      "ttl": 600,
      "essential": "Always"
    }
  ]
}
