{
  "providerId": "guardiao.dev",
  "providerName": "Guardião",
  "serviceId": "org-domain-verification",
  "serviceName": "Organization Domain Verification",
  "version": 1,
  "logoUrl": "https://guardiao.dev/app/assets/icone.svg",
  "description": "Adds a TXT record to verify domain ownership for Home Realm Discovery in Guardião.",
  "variableDescription": "TOKEN is the unique verification code (guardiao-verify-...) generated by Guardião for the organization.",
  "syncPubKeyDomain": "guardiao.dev",
  "syncBlock": false,
  "sharedProviderName": false,
  "records": [
    {
      "groupId": "verification",
      "type": "TXT",
      "host": "_guardiao-challenge",
      "data": "guardiao-verify-%TOKEN%",
      "ttl": 300,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "guardiao-verify-"
    }
  ]
}
