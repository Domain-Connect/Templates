{
  "providerId": "minimo.it",
  "providerName": "Minimo",
  "serviceId": "mail",
  "serviceName": "Email",
  "version": 2,
  "description": "Configure email sending for your domain through Minimo (SES domain verification, DKIM, custom MAIL FROM and DMARC with aggregate reporting).",
  "variableDescription": "dnsToken: Minimo domain-ownership verification token (always mn- prefixed). dkim1/dkim2/dkim3: the three Amazon SES easy-DKIM selectors. dmarcRua: Minimo-managed DMARC aggregate report mailbox (e.g. abc1234@dmarc.minimo.it).",
  "syncPubKeyDomain": "minimo.it",
  "syncRedirectDomain": "minimo.it",
  "syncBlock": false,
  "shared": false,
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "%dnsToken%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "mn-",
      "groupId": "core"
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "core"
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "core"
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600,
      "groupId": "core"
    },
    {
      "groupId": "core",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.eu-central-1.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "core",
      "type": "TXT",
      "host": "bounce",
      "data": "v=spf1 include:amazonses.com ~all",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=spf1"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:%dmarcRua%;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply",
      "groupId": "dmarc"
    }
  ]
}
