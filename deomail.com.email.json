{
  "providerId": "deomail.com",
  "providerName": "DeoMail",
  "serviceId": "email",
  "serviceName": "DeoMail Email Hosting",
  "version": 1,
  "logoUrl": "https://deomail.com/favicon.png",
  "description": "Connects your domain to DeoMail email: MX, SPF, DKIM and DMARC records.",
  "variableDescription": "dkimkey: DKIM RSA public key generated by DeoMail for this domain",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "deomail.com",
  "syncRedirectDomain": "deomail.com,deomail.net,deomail.eu,deomail.in,deomail.uk,deomail.ca",
  "hostRequired": false,
  "records": [
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "hi.deomail.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "mx"
    },
    {
      "type": "TXT",
      "host": "dkim._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=quarantine; rua=mailto:dmarc@%fqdn%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    }
  ]
}
