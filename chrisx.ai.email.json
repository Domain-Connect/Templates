{
  "providerId": "chrisx.ai",
  "providerName": "ChrisX",
  "serviceId": "email",
  "serviceName": "ChrisX email",
  "version": 1,
  "logoUrl": "https://chrisx.ai/chrisx/mark-black.svg",
  "description": "Sets up a business's email on mail.<domain> through ChrisX (sent by Resend): DKIM, the return path's MX and SPF, the routing and tracking CNAMEs, the MX that takes replies, and DMARC only when the domain has none. Applied at the root; ChrisX sends only the groups still missing.",
  "variableDescription": "%dkimKey%: the DKIM public key Resend gives mail.<domain> (base64, without p=); %region%: the AWS region in Resend's mail servers (us-east-1 today); %trackTarget%: the first label of Resend's click-tracking target under resend-dns.com (links1, links2).",
  "syncPubKeyDomain": "chrisx.ai",
  "syncRedirectDomain": "app.chrisx.ai",
  "records": [
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "resend._domainkey.mail",
      "data": "p=%dkimKey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "send.mail",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "send.mail",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mta",
      "type": "CNAME",
      "host": "rsend.mail",
      "pointsTo": "send.forge.rmta.net",
      "ttl": 3600
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "links.mail",
      "pointsTo": "%trackTarget%.resend-dns.com",
      "ttl": 3600
    },
    {
      "groupId": "replies",
      "type": "MX",
      "host": "mail",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
