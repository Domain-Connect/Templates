{
  "providerId": "sendability.com",
  "providerName": "Sendability",
  "serviceId": "onboarding",
  "serviceName": "Sendability email onboarding",
  "version": 1,
  "logoUrl": "https://sendability.com/wp-content/themes/sendability/img/Sendability-Icon.svg",
  "description": "Delegates Sendability sending subdomains and adds SPF, DMARC and optional BIMI for a new Sendability customer.",
  "syncBlock": false,
  "syncPubKeyDomain": "dc.sendability.com",
  "syncRedirectDomain": "clients.sendability.com",
  "records": [
    {
      "groupId": "ns",
      "type": "NS",
      "host": "m",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "mb",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "crm",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "email",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "info",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "content",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "mta",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "mta1",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "mta2",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "ns",
      "type": "NS",
      "host": "mta3",
      "pointsTo": "ns1.sendability.org",
      "ttl": 86400
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.sendability.org"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=reject; rua=mailto:dmarc@%fqdn%;",
      "ttl": 86400,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "bimi",
      "type": "TXT",
      "host": "default._bimi",
      "data": "v=BIMI1; l=https://www.%fqdn%/img/bimi-logo.svg;",
      "ttl": 86400,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=BIMI1",
      "essential": "OnApply"
    }
  ]
}