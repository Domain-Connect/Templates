{
  "providerId": "retsef.co.il",
  "providerName": "Retzef Mailer",
  "serviceId": "mailer-bimi",
  "serviceName": "Sender logo (BIMI)",
  "version": 1,
  "logoUrl": "https://mail.retsef.co.il/app/logo.svg",
  "description": "Publishes a BIMI record so mailbox providers can show the sender logo hosted by the Retzef mailer.",
  "variableDescription": "bimi: BIMI record",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "retsef.co.il",
  "syncRedirectDomain": "mail.retsef.co.il",
  "warnPhishing": true,
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "default._bimi",
      "data": "%bimi%",
      "ttl": 3600
    }
  ]
}
