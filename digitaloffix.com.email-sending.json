{
  "providerId": "digitaloffix.com",
  "providerName": "DigitalOffix",
  "serviceId": "email-sending",
  "serviceName": "DigitalOffix Email Sending",
  "version": 1,
  "logoUrl": "https://api.digitaloffix.com/images/mail/digitaloffix-logo-mail.png",
  "description": "Authorizes DigitalOffix to send marketing email on behalf of your domain via Amazon SES, with Easy DKIM signing and a custom MAIL FROM subdomain.",
  "syncBlock": false,
  "syncPubKeyDomain": "digitaloffix.com",
  "syncRedirectDomain": "digitaloffix.com",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the three Easy DKIM tokens issued by Amazon SES for this domain; %mailFromSubdomain%: MAIL FROM (bounce) subdomain chosen by the customer (default: m)",
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "%mailFromSubdomain%",
      "pointsTo": "feedback-smtp.eu-central-1.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "%mailFromSubdomain%",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    }
  ]
}
