{
  "providerId": "sendbound.com",
  "providerName": "Sendbound",
  "serviceId": "email-sending",
  "serviceName": "Email Sending",
  "version": 1,
  "logoUrl": "https://sendbound.com/favicon/android-chrome-192x192.png",
  "description": "Configure DNS records for sending authenticated email with Sendbound.",
  "variableDescription": "dkimSelector: DKIM selector name (e.g. postal-a1b2c3); dkimPublicKey: Base64-encoded DKIM public key value (the p= value from your DKIM TXT record)",
  "syncPubKeyDomain": "sendbound.com",
  "syncRedirectDomain": "api.sendbound.com",
  "records": [
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimSelector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimPublicKey%",
      "ttl": 3600
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.sendbound.com",
      "ttl": 3600
    }
  ]
}
