{
  "providerId": "outflare.ai",
  "providerName": "Outflare",
  "serviceId": "trackingdomain",
  "serviceName": "Tracking domain",
  "version": 1,
  "logoUrl": "https://outflare.ai/brand/png/outflare-mark-black-256.png",
  "description": "Points a subdomain at Outflare so the links and opens in your emails, and your website tracking, use your own domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "outflare.ai",
  "syncRedirectDomain": "app.outflare.ai",
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "app.outflare.ai",
      "ttl": 3600
    }
  ]
}
