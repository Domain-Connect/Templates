{
  "providerId": "arlow.co.za",
  "providerName": "Arlow Cyber Assurance",
  "serviceId": "domain-verification",
  "serviceName": "Cyber Assurance domain verification",
  "version": 2,
  "logoUrl": "https://www.arlow.co.za/images/ArlowLogoLight.svg",
  "description": "Adds a constrained TXT record so Arlow Cyber Assurance can verify control of a domain before passive security evidence collection.",
  "variableDescription": "verification is the unique, short-lived domain ownership challenge issued by Arlow Cyber Assurance",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.arlow.co.za",
  "syncRedirectDomain": "assurance.arlow.co.za",
  "hostRequired": false,
  "multiInstance": false,
  "records": [
    {
      "type": "TXT",
      "host": "_cyber-assurance",
      "data": "cca-verification=%verification%",
      "ttl": 300,
      "essential": "OnApply"
    }
  ]
}
