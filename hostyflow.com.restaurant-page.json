{
  "providerId": "hostyflow.com",
  "providerName": "HostyFlow",
  "serviceId": "restaurant-page",
  "serviceName": "Restaurant page",
  "version": 1,
  "logoUrl": "https://hostyflow.com/icon.svg",
  "description": "Opens your restaurant's HostyFlow page on www of your own domain, with its own secure certificate.",
  "variableDescription": "%verifywww%: the ownership code HostyFlow's certificate provider issued for www of the domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "hostyflow.com",
  "syncRedirectDomain": "app.hostyflow.com",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "customers.hostyflow.com",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_cf-custom-hostname.www",
      "data": "%verifywww%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
