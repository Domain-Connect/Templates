{
  "providerId": "pidgely.com",
  "providerName": "Pidgely",
  "serviceId": "email-sending",
  "serviceName": "Pidgely e-mail sending",
  "version": 1,
  "logoUrl": "https://pidgely.com/brand/icon-192.png",
  "description": "Authenticates a domain for sending e-mail through Pidgely: DKIM signing key, return-path MX for bounces, SPF include for the return path and, optionally, a starter DMARC policy.",
  "variableDescription": "dkimselector: DKIM selector generated by Pidgely for this domain (e.g. pdg202610). dkimkey: base64 RSA public key of that selector (the p= value).",
  "syncBlock": false,
  "syncPubKeyDomain": "pidgely.com",
  "syncRedirectDomain": "app.pidgely.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "sending",
      "type": "TXT",
      "host": "%dkimselector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "bounces",
      "pointsTo": "mta.pidgely.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "bounces",
      "spfRules": "include:_spf.mta.pidgely.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
