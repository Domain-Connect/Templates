{
  "providerId": "mailzito.com",
  "providerName": "MailZito",
  "serviceId": "sendingdomain",
  "serviceName": "Email sending (newsletters)",
  "version": 1,
  "logoUrl": "https://mailzito.com/icon.svg",
  "description": "Lets MailZito send newsletters from your domain: DKIM signing keys and a bounce subdomain for Amazon SES. Your website and existing email are not changed.",
  "variableDescription": "dkim1, dkim2, dkim3: DKIM tokens from Amazon SES; region: SES region (eu-central-1)",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.mailzito.com",
  "syncRedirectDomain": "app.mailzito.com",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    }
  ]
}
