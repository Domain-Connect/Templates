{
	"providerId": "inbox.sarl",
	"providerName": "Inbox.SARL",
	"serviceId": "email-authentication",
	"serviceName": "Email authentication records",
	"version": 1,
	"syncBlock": false,
	"syncPubKeyDomain": "inbox.sarl",
	"syncRedirectDomain": "inbox.sarl",
	"description": "Publish the SPF, DMARC, TLS-RPT and MTA-STS records recommended by the Inbox.SARL email deliverability scan.",
	"logoUrl": "https://inbox-sarl.manafix-pub.workers.dev/favicon.svg",
	"records": [
		{
			"groupId": "spf",
			"type": "SPFM",
			"host": "@",
			"spfRules": "%spfRules%",
			"ttl": 3600
		},
		{
			"groupId": "dmarc",
			"type": "TXT",
			"host": "_dmarc",
			"data": "v=DMARC1; p=%dmarcPolicy%; rua=mailto:%rua%; fo=1",
			"ttl": 3600
		},
		{
			"groupId": "tlsrpt",
			"type": "TXT",
			"host": "_smtp._tls",
			"data": "v=TLSRPTv1; rua=mailto:%rua%",
			"ttl": 3600
		},
		{
			"groupId": "mtasts",
			"type": "TXT",
			"host": "_mta-sts",
			"data": "v=STSv1; id=%stsId%",
			"ttl": 3600
		}
	]
}
