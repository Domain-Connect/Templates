{
  "providerId": "gettonica.com",
  "providerName": "Tonica",
  "serviceId": "site",
  "serviceName": "Tonica website and online booking",
  "version": 1,
  "logoUrl": "https://gettonica.com/brand/tonica-app-icon-512.png",
  "description": "Points the domain to the business website and online booking hosted by Tonica (server 167.233.69.4) and proves ownership with a verification record.",
  "variableDescription": "token: the verification code shown to the business in Tonica, without the salon- prefix",
  "syncBlock": false,
  "syncPubKeyDomain": "gettonica.com",
  "syncRedirectDomain": "gettonica.com",
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "167.233.69.4",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "@",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_verificare",
      "data": "salon-%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
