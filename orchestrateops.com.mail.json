{
  "providerId": "orchestrateops.com",
  "providerName": "Orchestrate",
  "serviceId": "mail",
  "serviceName": "Orchestrate email trust",
  "version": 1,
  "logoUrl": "https://orchestrateops.com/icons/Icon-192.png",
  "description": "Adds the SPF, DKIM and DMARC records that let inboxes trust the email a business sends through Orchestrate from its own mailbox.",
  "variableDescription": "spfrules: the SPF mechanism of the business's own mail provider (for example include:_spf.google.com); dkimselector and dkimkey: the DKIM selector and public key Orchestrate signs with, for businesses that connect their own mail server.",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "orchestrateops.com",
  "syncRedirectDomain": "orchestrateops.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "%spfrules%"
    },
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%dkimselector%._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}