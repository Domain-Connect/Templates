{
  "providerId": "amelu.org",
  "providerName": "Amelu",
  "serviceId": "mailhosting",
  "serviceName": "Amelu Mail Hosting",
  "version": 1,
  "logoUrl": "https://amelu.org/amelu-logo.png",
  "description": "Sets up a domain for email hosted on Amelu: MX, SPF, DKIM, DMARC, TLS reporting and client autodiscovery SRV records.",
  "variableDescription": "%ed25519selector% and %rsaselector%: DKIM selectors generated by Amelu, e.g. v1-ed25519-20260711; %ed25519key% and %rsakey%: the matching base64 DKIM public keys.",
  "syncBlock": false,
  "syncPubKeyDomain": "amelu.org",
  "syncRedirectDomain": "app.amelu.org",
  "records": [
    {
      "groupId": "mail",
      "type": "MX",
      "host": "@",
      "pointsTo": "marduk.mx.amelu.org",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mail",
      "type": "SPFM",
      "host": "@",
      "spfRules": "mx"
    },
    {
      "groupId": "mail",
      "type": "TXT",
      "host": "%ed25519selector%._domainkey",
      "data": "v=DKIM1; k=ed25519; h=sha256; p=%ed25519key%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "mail",
      "type": "TXT",
      "host": "%rsaselector%._domainkey",
      "data": "v=DKIM1; k=rsa; h=sha256; p=%rsakey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "mail",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=reject; rua=mailto:postmaster@%fqdn%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "mail",
      "type": "TXT",
      "host": "_smtp._tls",
      "data": "v=TLSRPTv1; rua=mailto:postmaster@%fqdn%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=TLSRPTv1",
      "essential": "OnApply"
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_caldavs",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_carddavs",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_imaps",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 993,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_jmap",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 443,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_pop3s",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 995,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    },
    {
      "groupId": "discovery",
      "type": "SRV",
      "service": "_submissions",
      "protocol": "_tcp",
      "name": "@",
      "priority": 0,
      "weight": 1,
      "port": 465,
      "target": "marduk.mx.amelu.org",
      "ttl": 3600
    }
  ]
}
