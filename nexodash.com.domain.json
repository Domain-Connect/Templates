{
  "providerId": "nexodash.com",
  "providerName": "NexoDash",
  "serviceId": "domain",
  "serviceName": "Custom Domain",
  "version": 1,
  "logoUrl": "https://nexodash.com/brand/v2/logo-mark.svg",
  "syncPubKeyDomain": "nexodash.com",
  "syncRedirectDomain": "nexodash.com",
  "description": "Connect your domain to your NexoDash site.",
  "variableDescription": "%ip%: IPv4 address for the apex, issued per-domain by the hosting API (values evolve; e.g. the 2026 range migration 76.76.21.21 -> 216.198.x is why it cannot be hardcoded); %wwwtarget%: CNAME target for www, issued by the same API; %verifytoken%: NexoDash domain-ownership token.",
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 300,
      "groupId": "core"
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%wwwtarget%",
      "ttl": 300,
      "groupId": "pair"
    },
    {
      "type": "TXT",
      "host": "_nexodash-verify",
      "ttl": 3600,
      "data": "nexodash-domain-verification=%verifytoken%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "nexodash-domain-verification=",
      "groupId": "core"
    }
  ]
}
