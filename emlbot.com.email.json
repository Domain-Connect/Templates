{
  "providerId": "emlbot.com",
  "providerName": "EMLbot",
  "serviceId": "email",
  "serviceName": "EMLbot email",
  "version": 2,
  "hostRequired": true,
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.emlbot.com",
  "syncRedirectDomain": "app.emlbot.com",
  "description": "Connect a dedicated email subdomain to EMLbot. Existing mail records require review.",
  "records": [
    { "groupId": "emlbot", "type": "TXT", "host": "_emlbot", "data": "emlbot-verify=%emlbotToken%", "ttl": 300, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "emlbot-verify=" },
    { "groupId": "ownership", "type": "TXT", "host": "@", "data": "telnyx-domain-verification=%ownershipToken%", "ttl": 300, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "telnyx-domain-verification=" },
    { "groupId": "dkim", "type": "TXT", "host": "%dkimSelector%._domainkey", "data": "v=DKIM1;%dkimParams%", "ttl": 300, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DKIM1" },
    { "groupId": "inbound", "type": "MX", "host": "@", "pointsTo": "%mxValue%", "priority": "%mxPriority%", "ttl": 300 },
    { "groupId": "inbound2", "type": "MX", "host": "@", "pointsTo": "%mxValueTwo%", "priority": "%mxPriorityTwo%", "ttl": 300 },
    { "groupId": "inbound3", "type": "MX", "host": "@", "pointsTo": "%mxValueThree%", "priority": "%mxPriorityThree%", "ttl": 300 },
    { "groupId": "spf", "type": "SPFM", "host": "@", "spfRules": "%spfRules%" },
    { "groupId": "dmarc", "type": "TXT", "host": "_dmarc", "data": "v=DMARC1;%dmarcParams%", "ttl": 300, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DMARC1", "essential": "OnApply" }
  ]
}
