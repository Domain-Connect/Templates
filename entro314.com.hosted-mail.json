{
  "providerId": "entro314.com",
  "serviceId": "hosted-mail",
  "providerName": "Entropost",
  "serviceName": "Hosted Mail",
  "version": 3,
  "description": "Configures MX, SPF, DKIM, and DMARC records for an Entropost hosted mailbox domain.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.entro314.com",
  "syncRedirectDomain": "app.entropost.com",
  "records": [
    {
      "type": "MX",
      "host": "@",
      "pointsTo": "%mxTarget%",
      "groupId": "mail",
      "priority": 10,
      "ttl": 120
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "mx",
      "groupId": "mail",
      "ttl": 120
    },
    {
      "type": "TXT",
      "host": "%selector%._domainkey",
      "data": "%dkimValue%",
      "groupId": "mail",
      "ttl": 120,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "groupId": "dmarc",
      "ttl": 120,
      "txtConflictMatchingMode": "None",
      "essential": "OnApply"
    }
  ]
}
