{
  "providerId": "smproxy.io",
  "providerName": "SMProxy",
  "serviceId": "domain-verification",
  "serviceName": "Domain verification",
  "version": 1,
  "logoUrl": "https://provider.smproxy.io/imgs/smproxy-logo.svg",
  "description": "Verify domain ownership for SMProxy by adding a single TXT record. No other DNS records are changed.",
  "variableDescription": "%verification%: unique domain ownership verification token generated by SMProxy",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.smproxy.io",
  "syncRedirectDomain": "provider.smproxy.io",
  "records": [
    {
      "type": "TXT",
      "host": "smproxy-verification",
      "data": "%verification%",
      "ttl": 300,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    }
  ]
}
