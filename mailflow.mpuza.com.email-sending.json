{
  "providerId": "mailflow.mpuza.com",
  "providerName": "MailFlow",
  "serviceId": "email-sending",
  "serviceName": "MailFlow email sending",
  "version": 1,
  "logoUrl": "https://mailflow.mpuza.com/logo.svg",
  "description": "Adds the DKIM, SPF and DMARC records MailFlow needs to send email from your domain.",
  "variableDescription": "selector: DKIM selector; dkimValue: DKIM public key; dmarcRua: address that receives DMARC reports",
  "syncPubKeyDomain": "mailflow.mpuza.com",
  "syncRedirectDomain": "mailflow.mpuza.com,api.mailflow.mpuza.com",
  "hostRequired": true,
  "records": [
    {
      "type": "TXT",
      "host": "%selector%._domainkey",
      "ttl": 3600,
      "data": "%dkimValue%"
    },
    {
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.mailflow.mpuza.com"
    },
    {
      "type": "TXT",
      "host": "_dmarc",
      "ttl": 3600,
      "data": "v=DMARC1; p=none; rua=mailto:%dmarcRua%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    }
  ]
}
