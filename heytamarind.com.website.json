{
  "providerId": "heytamarind.com",
  "providerName": "Tamarind",
  "serviceId": "website",
  "serviceName": "Tamarind website",
  "version": 1,
  "logoUrl": "https://app.heytamarind.com/domain-connect/logo.svg",
  "description": "Shows your Tamarind website at www and forwards your bare domain to it. Email and other records are not changed.",
  "variableDescription": "project: the name of this customer's website on Cloudflare Pages (the site is served at <project>.pages.dev)",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.heytamarind.com",
  "syncRedirectDomain": "app.heytamarind.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "%project%.pages.dev",
      "ttl": 3600
    },
    {
      "groupId": "apex",
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%fqdn%"
    }
  ]
}
