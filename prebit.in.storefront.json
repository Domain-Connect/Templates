{
  "providerId": "prebit.in",
  "providerName": "Prebit",
  "serviceId": "storefront",
  "serviceName": "Prebit online store",
  "version": 1,
  "logoUrl": "https://admin.prebit.in/web-app-manifest-512x512.png",
  "description": "Connects your domain to your Prebit online store",
  "variableDescription": "rootverify and wwwverify are the Cloudflare for SaaS ownership tokens for the domain and its www subdomain",
  "syncPubKeyDomain": "prebit.in",
  "syncRedirectDomain": "admin.prebit.in",
  "hostRequired": true,
  "records": [
    {
      "groupId": "root",
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cname.prebit.store",
      "ttl": 3600
    },
    {
      "groupId": "rootverify",
      "type": "TXT",
      "host": "_cf-custom-hostname",
      "data": "%rootverify%",
      "txtConflictMatchingMode": "All",
      "ttl": 3600
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "cname.prebit.store",
      "ttl": 3600
    },
    {
      "groupId": "wwwverify",
      "type": "TXT",
      "host": "_cf-custom-hostname.www",
      "data": "%wwwverify%",
      "txtConflictMatchingMode": "All",
      "ttl": 3600
    }
  ]
}
