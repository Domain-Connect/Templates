{
  "providerId": "merch.com",
  "providerName": "Merch.com",
  "serviceId": "store-apex",
  "serviceName": "Merch.com store on your domain",
  "version": 2,
  "description": "Points the domain at the Merch.com storefront and writes the ownership record. Developer note: applied with an empty host.",
  "variableDescription": "merchverification: the per-store ownership token Merch.com shows the merchant, without the merch-verify- prefix this template writes back. It proves the domain and points nowhere.",
  "syncBlock": false,
  "syncRedirectDomain": "merch.com",
  "syncPubKeyDomain": "merch.com",
  "hostRequired": false,
  "multiInstance": false,
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "76.76.21.21",
      "ttl": 600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "cname.vercel-dns.com",
      "ttl": 600
    },
    {
      "type": "TXT",
      "host": "_merch-verification",
      "data": "merch-verify-%merchverification%",
      "ttl": 600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "merch-verify-"
    }
  ]
}
