{
  "providerId": "e-manager.io",
  "providerName": "E-Manager",
  "serviceId": "tracking",
  "serviceName": "Pagina tracking personalizzata",
  "version": 2,
  "description": "Collega un sottodominio alla pagina tracking E-Manager e verifica la proprietà.",
  "syncPubKeyDomain": "domainconnect.e-manager.io",
  "syncBlock": false,
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "groupId": "tracking",
      "host": "@",
      "pointsTo": "%target%",
      "ttl": 300
    },
    {
      "type": "TXT",
      "groupId": "tracking",
      "host": "_emanager-tracking",
      "data": "%verification%",
      "ttl": 300,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "TXT",
      "groupId": "cloudflare",
      "host": "_cf-custom-hostname",
      "data": "%cloudflareVerification%",
      "ttl": 300,
      "txtConflictMatchingMode": "All"
    }
  ]
}
