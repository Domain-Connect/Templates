{
  "providerId": "affrev.com",
  "providerName": "AffRev",
  "serviceId": "funnel",
  "serviceName": "AffRev Funnel (subdomain)",
  "version": 1,
  "logoUrl": "https://affrev.com/affrev.svg",
  "description": "Connects a subdomain to a published AffRev funnel and proves ownership via a TXT record.",
  "syncRedirectDomain": "affrev.com",
  "hostRequired": true,
  "variableDescription": "%txt%: domain ownership verification token generated by AffRev",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "funnels.affrev.io",
      "ttl": 3600,
      "essential": "Always"
    },
    {
      "type": "TXT",
      "host": "_affrev",
      "data": "affrev-verify=%txt%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "Always"
    }
  ]
}
