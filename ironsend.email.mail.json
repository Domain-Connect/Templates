{
  "providerId": "ironsend.email",
  "providerName": "Ironsend",
  "serviceId": "mail",
  "serviceName": "Business email",
  "version": 1,
  "logoUrl": "https://ironsend.email/brand/ironsend-mark.svg",
  "description": "Connects a domain to Ironsend business email. Group receiving: MX to Ironsend. Group sending: SPF include, the three Amazon SES Easy DKIM CNAMEs, and a custom MAIL FROM domain (bounce MX and SPF). Group dmarc: a starting DMARC policy, applied only when the domain has none. Group mailhost: the domain's own mail server name, mail CNAME to Ironsend, applied only when that name is free.",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the three Amazon SES Easy DKIM tokens issued for this domain; %sesRegion%: AWS region of the SES account that relays the domain's mail (e.g. ap-south-1), which names the bounce MX host",
  "syncPubKeyDomain": "domainconnect.ironsend.email",
  "syncRedirectDomain": "admin.ironsend.email",
  "records": [
    {
      "groupId": "receiving",
      "type": "MX",
      "host": "@",
      "pointsTo": "mx1.ironsend.email",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.ironsend.email"
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "sending",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "sending",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%sesRegion%.amazonses.com",
      "priority": 10,
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "sending",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "mailhost",
      "type": "CNAME",
      "host": "mail",
      "pointsTo": "mx1.ironsend.email",
      "ttl": 3600,
      "essential": "OnApply"
    }
  ]
}
