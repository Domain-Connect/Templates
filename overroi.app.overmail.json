{
  "providerId": "overroi.app",
  "providerName": "OverRoi",
  "serviceId": "overmail",
  "serviceName": "OverMail",
  "version": 1,
  "logoUrl": "https://mail.overroi.app/logo/overmail-mark.svg",
  "description": "Authenticates a sending domain for OverMail (email on Amazon SES): the DKIM public key, the custom MAIL FROM subdomain (MX and SPF) and a starter DMARC policy. Apply with domain=<registrable domain> and, for a sending subdomain, host=<subdomain>.",
  "variableDescription": "dkim: base64 RSA public key OverMail generated for this domain (the p= value of the DKIM record). region: the Amazon SES region the domain sends from, for example us-east-1.",
  "syncBlock": false,
  "syncPubKeyDomain": "overroi.app",
  "syncRedirectDomain": "mail.overroi.app",
  "records": [
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "millionsend._domainkey",
      "data": "v=DKIM1; k=rsa; p=%dkim%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
