{
  "providerId": "sequenzy.com",
  "providerName": "Sequenzy",
  "serviceId": "mail",
  "serviceName": "Mail",
  "version": 3,
  "syncBlock": false,
  "syncPubKeyDomain": "sequenzy.com",
  "syncRedirectDomain": "sequenzy.com,www.sequenzy.com",
  "description": "Authenticate email sent from your domain with Sequenzy: DKIM, bounce handling, DMARC and tracking.",
  "logoUrl": "https://www.sequenzy.com/logo.png",
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "sq1._domainkey",
      "pointsTo": "sq1.%platformDnsId%.d.sequenzydns.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "sq2._domainkey",
      "pointsTo": "sq2.%platformDnsId%.d.sequenzydns.com",
      "ttl": 3600
    },
    {
      "groupId": "return-path",
      "type": "CNAME",
      "host": "%returnPathHost%",
      "pointsTo": "r1.%platformDnsId%.d.sequenzydns.com",
      "ttl": 3600
    },
    {
      "groupId": "ses-return-path",
      "type": "CNAME",
      "host": "%sesReturnPathHost%",
      "pointsTo": "r2.%platformDnsId%.d.sequenzydns.com",
      "ttl": 3600,
      "essential": "OnApply"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc.%domain%.",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "All",
      "essential": "OnApply"
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "%trackingHost%.%domain%.",
      "pointsTo": "%trackingCnameTarget%.sequenzydns.com",
      "ttl": 3600,
      "essential": "OnApply"
    }
  ]
}
