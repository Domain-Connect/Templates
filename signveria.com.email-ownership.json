{
  "providerId": "signveria.com",
  "providerName": "Signveria",
  "logoUrl": "https://signveria.com/esign.svg",
  "version": 1,
  "syncBlock": false,
  "multiInstance": true,
  "syncPubKeyDomain": "domainconnect.signveria.com",
  "syncRedirectDomain": "signveria.com,admin.signveria.com,m.signveria.com,gladmin.signveria.com",
  "serviceId": "email-ownership",
  "serviceName": "Sending domain ownership",
  "description": "Verify this tenant controls its email domain before provisioning an Amazon SES identity.",
  "variableDescription": "proof: 64 lowercase hexadecimal characters generated by Signveria for this tenant and email domain.",
  "records": [
    {
      "type": "TXT",
      "host": "_signveria-mail",
      "data": "signveria=%proof%",
      "ttl": 300,
      "txtConflictMatchingMode": "None"
    }
  ]
}
