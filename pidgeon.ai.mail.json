{
  "providerId": "pidgeon.ai",
  "providerName": "Pidgeon",
  "serviceId": "mail",
  "serviceName": "Pidgeon Mail",
  "version": 1,
  "logoUrl": "https://pidgeon.ai/brand/logo-light.svg",
  "description": "Email inboxes for your team and your AI agents on your own domain: domain ownership, sending authentication (SPF, DKIM, DMARC), optional signed-sender records, and inbound mail routing (MX), each in its own group.",
  "variableDescription": "verification: 32 hex characters proving the domain is the customer's. dkim1-3: Amazon SES Easy DKIM tokens. region: the AWS region that receives mail, e.g. eu-west-1. postid: 16 hex characters identifying the domain's signing policy. posttarget: the hostname that serves the domain's signing keys over HTTPS.",
  "syncBlock": false,
  "syncPubKeyDomain": "pidgeon.ai",
  "syncRedirectDomain": "pidgeon.ai",
  "records": [
    {
      "groupId": "ownership",
      "type": "TXT",
      "host": "_pidgeon",
      "data": "pidgeon-verification=%verification%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "pidgeon-verification="
    },
    {
      "groupId": "mail",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "mail",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mail",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mail",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc@pidgeon.ai",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "signing",
      "type": "TXT",
      "host": "_post",
      "data": "v=post0; id=%postid%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=post0"
    },
    {
      "groupId": "signing",
      "type": "CNAME",
      "host": "post",
      "pointsTo": "%posttarget%",
      "ttl": 3600
    },
    {
      "groupId": "mx",
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    }
  ]
}
