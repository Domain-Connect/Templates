{
    "providerId": "podpage.com",
    "providerName": "Podpage",
    "serviceId": "subdomain",
    "serviceName": "Podpage Website (subdomain)",
    "version": 1,
    "logoUrl": "https://static.podpage.com/dashboard/images/apple-icon.png",
    "description": "Connects a subdomain (for example podcast.yourdomain.com) to your Podpage podcast website without touching the rest of your domain.",
    "syncBlock": false,
    "syncRedirectDomain": "podpage.com",
    "hostRequired": true,
    "records": [
        {
            "type": "CNAME",
            "host": "@",
            "pointsTo": "domains.podpage.com",
            "ttl": 3600
        }
    ]
}
