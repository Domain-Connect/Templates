  "syncPubKeyDomain": "domainconnect.vantuni.com.br",
  "syncRedirectDomain": "app.vantuni.com.br",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "edge.clubes.vantuni.com.br",
      "ttl": 600
    }
  ]
}
