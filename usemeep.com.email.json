{
  "providerId": "usemeep.com",
  "providerName": "Meep",
  "serviceId": "email",
  "serviceName": "Meep Email Sending",
  "version": 1,
  "logoUrl": "https://usemeep.com/favicon.svg",
  "description": "Authorizes Meep to send email from your domain. Existing inbox and website records are not changed.",
  "variableDescription": "dkim1Selector through dkim3Selector are the three constrained AWS SES DKIM selectors returned by Resend.",
  "syncBlock": false,
  "syncPubKeyDomain": "dc.usemeep.com",
  "syncRedirectDomain": "usemeep.com",
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1Selector%._domainkey",
      "pointsTo": "%dkim1Selector%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2Selector%._domainkey",
      "pointsTo": "%dkim2Selector%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3Selector%._domainkey",
      "pointsTo": "%dkim3Selector%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.us-east-1.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    }
  ]
}
