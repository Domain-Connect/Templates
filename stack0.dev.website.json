{
    "providerId": "stack0.dev",
    "providerName": "Stack0",
    "serviceId": "website",
    "serviceName": "Stack0 website",
    "version": 1,
    "logoUrl": "https://www.stack0.dev/icon.png",
    "description": "Points this domain at a website hosted on Stack0: www through Stack0's edge, and the bare domain at the site.",
    "variableDescription": "v4 and v6: the site's addresses for the bare domain.",
    "syncPubKeyDomain": "stack0.dev",
    "syncRedirectDomain": "cloud.stack0.dev,launch.stack0.dev,build.stack0.dev",
    "records": [
        {
            "type": "CNAME",
            "host": "www",
            "pointsTo": "customers.stack0.app",
            "ttl": "3600"
        },
        {
            "type": "A",
            "host": "@",
            "pointsTo": "%v4%",
            "ttl": "600"
        },
        {
            "type": "AAAA",
            "host": "@",
            "pointsTo": "%v6%",
            "ttl": "600"
        }
    ]
}
