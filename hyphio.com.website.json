{
  "providerId": "hyphio.com",
  "providerName": "Hyphio",
  "serviceId": "website",
  "serviceName": "Hyphio website",
  "version": 2,
  "logoUrl": "https://hyphio.com/logo.svg",
  "description": "Connects a domain and its www name to an EmDash website hosted by Hyphio. Only the two website records and their ownership checks are touched; mail and other records are left alone.",
  "variableDescription": "apexToken and wwwToken are the per-hostname ownership-verification values Hyphio receives from Cloudflare for SaaS; apexProof and wwwProof are Hyphio's own per-customer proofs for the same two names.",
  "syncPubKeyDomain": "hyphio.com",
  "syncRedirectDomain": "hyphio.com",
  "syncBlock": false,
  "hostRequired": true,
  "records": [
    { "type": "CNAME", "host": "@", "pointsTo": "sites.hyphio.cc", "ttl": 3600 },
    { "type": "TXT", "host": "_cf-custom-hostname", "data": "%apexToken%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "type": "TXT", "host": "_hyphio", "data": "hyphio-verify=%apexProof%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "type": "CNAME", "host": "www", "pointsTo": "sites.hyphio.cc", "ttl": 3600 },
    { "type": "TXT", "host": "_cf-custom-hostname.www", "data": "%wwwToken%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "type": "TXT", "host": "_hyphio.www", "data": "hyphio-verify=%wwwProof%", "ttl": 3600, "txtConflictMatchingMode": "All" }
  ]
}
