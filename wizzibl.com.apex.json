{
  "providerId": "wizzibl.com",
  "providerName": "Wizzibl",
  "serviceId": "apex",
  "serviceName": "Wizzibl apex website",
  "version": 1,
  "logoUrl": "https://wizzibl.com/favicon.png",
  "description": "Points an apex domain and its www subdomain to a website hosted on Wizzibl.",
  "variableDescription": "%ip%: IPv4 address for the apex A record.",
  "syncPubKeyDomain": "wizzibl.com",
  "records": [
    {
      "type": "A",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "customers.wizzibl.com",
      "ttl": 3600
    }
  ]
}
