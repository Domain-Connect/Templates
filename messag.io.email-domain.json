{
  "providerId": "messag.io",
  "providerName": "Messagio",
  "serviceId": "email-domain",
  "serviceName": "Messagio email sending domain",
  "version": 1,
  "logoUrl": "https://messag.io/domain-connect/messagio.svg",
  "description": "Publishes the DNS records that let Messagio send email from your domain through Amazon SES in Seoul: domain ownership, DKIM signing, the custom MAIL FROM domain (bounce.<domain>) and, optionally, a monitoring DMARC policy, a click-tracking host (links.<domain>) and an inbound receiving host (reply.<domain>).",
  "variableDescription": "token: Messagio ownership token; dk1, dk2, dk3: Amazon SES DKIM tokens; rua: DMARC aggregate report address",
  "syncBlock": false,
  "syncPubKeyDomain": "messag.io",
  "hostRequired": false,
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "_messagio",
      "data": "messagio-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "messagio-verification="
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dk1%._domainkey",
      "pointsTo": "%dk1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dk2%._domainkey",
      "pointsTo": "%dk2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dk3%._domainkey",
      "pointsTo": "%dk3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.ap-northeast-2.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:%rua%",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "links",
      "pointsTo": "track.messag.io",
      "ttl": 3600
    },
    {
      "groupId": "receiving",
      "type": "MX",
      "host": "reply",
      "pointsTo": "inbound-smtp.ap-northeast-2.amazonaws.com",
      "priority": 10,
      "ttl": 3600
    }
  ]
}
