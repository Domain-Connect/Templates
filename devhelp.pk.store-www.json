{
  "providerId": "devhelp.pk",
  "providerName": "devhelp shop",
  "serviceId": "store-www",
  "serviceName": "Online store",
  "version": 1,
  "logoUrl": "https://devhelp.pk/brand-icon.svg",
  "description": "Points www at a devhelp shop store and forwards the root domain to it, for DNS providers without root CNAME support. Email and nameservers are not changed.",
  "syncBlock": false,
  "syncPubKeyDomain": "devhelp.pk",
  "syncRedirectDomain": "app.devhelp.pk,app-dev.devhelp.pk",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "www",
      "pointsTo": "shops.devhelp.store",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "_acme-challenge.www",
      "pointsTo": "www.%fqdn%.71d26191badc177d.dcv.cloudflare.com",
      "ttl": 3600
    },
    {
      "type": "REDIR301",
      "host": "@",
      "target": "https://www.%fqdn%"
    }
  ]
}
