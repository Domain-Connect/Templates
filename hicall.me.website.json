{
  "providerId": "hicall.me",
  "providerName": "HiCall",
  "serviceId": "website",
  "serviceName": "HiCall website",
  "version": 1,
  "description": "Connect a domain or subdomain to its owner's HiCall website.",
  "variableDescription": "proof is a 48-character hexadecimal site ownership verification token generated by HiCall.",
  "syncBlock": false,
  "syncRedirectDomain": "hicall.me",
  "syncPubKeyDomain": "domainconnect.hicall.me",
  "records": [
    {
      "groupId": "website",
      "type": "A",
      "host": "@",
      "pointsTo": "144.76.224.220",
      "ttl": 600
    },
    {
      "groupId": "ownership",
      "type": "TXT",
      "host": "_hicall",
      "data": "hicall-site=%proof%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "hicall-site=",
      "ttl": 600
    },
    {
      "groupId": "www",
      "type": "CNAME",
      "host": "www",
      "pointsTo": "@",
      "ttl": 600
    }
  ],
  "logoUrl": "https://hicall.me/wp-content/uploads/2026/09/hicall-logo-light.2.fw_.png"
}
