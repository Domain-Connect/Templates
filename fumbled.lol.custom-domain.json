{
  "providerId": "fumbled.lol",
  "providerName": "fumbled.lol",
  "serviceId": "custom-domain",
  "serviceName": "Custom Domain",
  "version": 1,
  "description": "Connect your domain or subdomain to your fumbled.lol profile.",
  "variableDescription": "%txtToken%: The hex verification token for your domain.",
  "syncBlock": false,
  "hostRequired": true,
  "syncRedirectDomain": "fumbled.lol",
  "syncPubKeyDomain": "fumbled.lol",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "cname.fumbled.lol",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_fumbled-verify",
      "data": "fumbled-verify=%txtToken%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
