{
  "providerId": "folksay.ai",
  "providerName": "Folksay",
  "serviceId": "newsletter-us-east-1",
  "serviceName": "Company newsletters",
  "version": 1,
  "description": "Connect a dedicated sending subdomain for company newsletters in Folksay.",
  "variableDescription": "%dkim% is the complete Resend-provided DKIM TXT value (p= followed by a validated base64 public key), restricted to resend._domainkey. %ownership% is an opaque, company-bound verification token generated by Folksay. The signed host parameter is always updates.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect-keys.folksay.ai",
  "syncRedirectDomain": "folksay.ai",
  "hostRequired": true,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "%dkim%",
      "txtConflictMatchingMode": "All",
      "ttl": 600
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "feedback-smtp.us-east-1.amazonses.com",
      "priority": 10,
      "ttl": 600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com"
    },
    {
      "type": "TXT",
      "host": "_folksay",
      "data": "folksay-verification=%ownership%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "folksay-verification=",
      "ttl": 600
    }
  ]
}
