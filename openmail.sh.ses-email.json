{
  "providerId": "openmail.sh",
  "providerName": "OpenMail",
  "serviceId": "ses-email",
  "serviceName": "Email sending and receiving",
  "version": 1,
  "logoUrl": "https://openmail.sh/bimi/logo.svg",
  "description": "Configure email sending and receiving with OpenMail. Applying inbound records replaces existing MX records at the selected domain or subdomain.",
  "variableDescription": "region: AWS SES region provisioned by OpenMail (for example, eu-north-1). domainKey: base64-encoded RSA public key for the OpenMail omail DKIM selector, without PEM headers or the v=DKIM1; k=rsa; p= prefix.",
  "syncPubKeyDomain": "domainconnect.openmail.sh",
  "syncRedirectDomain": "console.openmail.sh",
  "records": [
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "omail._domainkey",
      "ttl": 3600,
      "data": "v=DKIM1; k=rsa; p=%domainKey%",
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "outbound",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "ttl": 3600,
      "priority": 10
    },
    {
      "groupId": "outbound",
      "type": "SPFM",
      "host": "bounce",
      "ttl": 3600,
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "inbound",
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "ttl": 3600,
      "priority": 10
    }
  ]
}
