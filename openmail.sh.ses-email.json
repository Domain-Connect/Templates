{
  "providerId": "openmail.sh",
  "providerName": "OpenMail",
  "serviceId": "ses-email",
  "serviceName": "OpenMail",
  "version": 1,
  "logoUrl": "https://openmail.sh/bimi/logo.svg",
  "description": "Configure email sending and receiving with OpenMail.",
  "variableDescription": "region: AWS SES region provisioned by OpenMail (for example, eu-north-1). selector: DKIM selector provisioned by OpenMail (currently omail). domainKey: base64-encoded RSA public key for that selector, without PEM headers or the v=DKIM1; k=rsa; p= prefix. dmarcrua: email address for aggregate DMARC reports, without the mailto: prefix.",
  "syncPubKeyDomain": "domainconnect.openmail.sh",
  "syncRedirectDomain": "console.openmail.sh",
  "records": [
    {
      "groupId": "dkim",
      "type": "TXT",
      "host": "%selector%._domainkey",
      "ttl": 3600,
      "data": "v=DKIM1; k=rsa; p=%domainKey%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DKIM1"
    },
    {
      "groupId": "outbound",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "ttl": 3600,
      "priority": 10
    },
    {
      "groupId": "outbound",
      "type": "SPFM",
      "host": "bounce",
      "ttl": 3600,
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "ttl": 3600,
      "data": "v=DMARC1; p=reject; rua=mailto:%dmarcrua%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "inbound",
      "type": "MX",
      "host": "@",
      "pointsTo": "inbound-smtp.%region%.amazonaws.com",
      "ttl": 3600,
      "priority": 10
    }
  ]
}
