{
  "providerId": "globalyos.com",
  "providerName": "GlobalyOS",
  "serviceId": "email",
  "serviceName": "GlobalyOS email sending",
  "version": 1,
  "logoUrl": "https://globalyos.com/favicon.svg",
  "description": "Lets GlobalyOS send email from your domain. Bounces go to send.<your domain>; your inbox and website are not touched.",
  "variableDescription": "dkimkey is the DKIM public key and mxhost the bounce mail server on the send subdomain.",
  "syncPubKeyDomain": "globalyos.com",
  "syncRedirectDomain": "globalyos.com,www.globalyos.com",
  "sharedServiceName": true,
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "p=%dkimkey%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "type": "MX",
      "host": "send",
      "pointsTo": "%mxhost%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "send",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    }
  ]
}
