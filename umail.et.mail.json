{
  "providerId": "umail.et",
  "providerName": "uMail",
  "serviceId": "mail",
  "serviceName": "uMail business email",
  "version": 2,
  "logoUrl": "https://umail.et/brand/umail-wordmark.svg",
  "description": "Sets up business email on uMail for your domain: proves you own the domain, sends your mail to uMail, allows uMail to send for you and adds the signing keys. A starting DMARC policy (p=none, reports only) is added only when the domain has none.",
  "variableDescription": "%verifyToken%: ownership token uMail shows for the domain; %dkimRsaSelector%, %dkimRsaKey%: name and public key of the RSA signing key; %dkimEdSelector%, %dkimEdKey%: name and public key of the Ed25519 signing key",
  "syncBlock": false,
  "syncPubKeyDomain": "umail.et",
  "syncRedirectDomain": "admin.umail.et",
  "records": [
    { "groupId": "main", "type": "TXT", "host": "_umail", "data": "umail-verify=%verifyToken%", "ttl": 3600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "umail-verify=" },
    { "groupId": "main", "type": "MX", "host": "@", "pointsTo": "mx.umail.et", "priority": 10, "ttl": 3600 },
    { "groupId": "main", "type": "SPFM", "host": "@", "spfRules": "mx" },
    { "groupId": "main", "type": "TXT", "host": "%dkimRsaSelector%._domainkey", "data": "v=DKIM1; k=rsa; h=sha256; p=%dkimRsaKey%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "groupId": "main", "type": "TXT", "host": "%dkimEdSelector%._domainkey", "data": "v=DKIM1; k=ed25519; h=sha256; p=%dkimEdKey%", "ttl": 3600, "txtConflictMatchingMode": "All" },
    { "groupId": "dmarc", "type": "TXT", "host": "_dmarc", "data": "v=DMARC1; p=none; rua=mailto:postmaster@%domain%", "ttl": 3600, "txtConflictMatchingMode": "Prefix", "txtConflictMatchingPrefix": "v=DMARC1" }
  ]
}
