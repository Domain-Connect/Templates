{
  "providerId": "synteq.com",
  "providerName": "Synteq",
  "serviceId": "hosting",
  "serviceName": "Synteq Apps & Functions",
  "version": 1,
  "logoUrl": "https://synteq.com/domain-connect/logo.png",
  "description": "Points a domain or subdomain at your Synteq app or function, or verifies an organization's email domain for SSO, by proving you own it.",
  "variableDescription": "ip: the IPv4 address of the Synteq gateway serving the app (apex group). target: the app's or function's Synteq hostname, e.g. my-app.synteq.app (subdomain group). subdomain: the label the customer chose in front of their domain (subdomain group). token: the ownership challenge Synteq generated for this domain (all groups).",
  "syncPubKeyDomain": "synteq.com",
  "syncRedirectDomain": "cloud.synteq.com,staging.cloud.synteq.com",
  "hostRequired": false,
  "records": [
    {
      "type": "A",
      "groupId": "apex",
      "host": "@",
      "pointsTo": "%ip%",
      "ttl": 600,
      "essential": "OnApply"
    },
    {
      "type": "TXT",
      "groupId": "apex",
      "host": "_synteq-challenge",
      "data": "synteq-verify=%token%",
      "ttl": 600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "synteq-verify="
    },
    {
      "type": "CNAME",
      "groupId": "subdomain",
      "host": "%subdomain%",
      "pointsTo": "%target%",
      "ttl": 600,
      "essential": "OnApply"
    },
    {
      "type": "TXT",
      "groupId": "subdomain",
      "host": "_synteq-challenge.%subdomain%",
      "data": "synteq-verify=%token%",
      "ttl": 600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "synteq-verify="
    },
    {
      "type": "TXT",
      "groupId": "sso",
      "host": "@",
      "data": "synteq-verify=%token%",
      "ttl": 600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "synteq-verify="
    }
  ]
}
