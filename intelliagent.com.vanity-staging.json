{
  "providerId": "intelliagent.com",
  "providerName": "IntelliAgent",
  "serviceId": "vanity-staging",
  "serviceName": "IntelliAgent Websites Staging",
  "version": 1,
  "description": "Connect this website address to IntelliAgent using Cloudflare DNS. Other website addresses and email records stay unchanged.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.staging.intelliagent.com",
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "customers.staging.intelliagent.com",
      "ttl": 300,
      "groupId": "traffic"
    },
    {
      "type": "TXT",
      "host": "_cf-custom-hostname",
      "data": "%ownership%",
      "ttl": 300,
      "groupId": "ownership"
    },
    {
      "type": "TXT",
      "host": "_acme-challenge",
      "data": "%certificate%",
      "ttl": 300,
      "groupId": "certificate"
    }
  ],
  "hostRequired": true
}
