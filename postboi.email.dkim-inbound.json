{
	"providerId": "postboi.email",
	"providerName": "Postboi",
	"serviceId": "dkim-inbound",
	"serviceName": "Postboi domain setup (DKIM + MAIL FROM + receiving)",
	"version": 1,
	"logoUrl": "https://postboi.email/logo.svg",
	"description": "Postboi domain setup for domains that already publish a DMARC policy: three Amazon SES DKIM CNAME records, MX and SPF records on the bounce subdomain for an aligned MAIL FROM, and receiving on the reply subdomain (an Amazon SES verification TXT plus its MX).",
	"syncPubKeyDomain": "postboi.email",
	"syncRedirectDomain": "postboi.email",
	"syncBlock": false,
	"shared": false,
	"hostRequired": false,
	"records": [
		{
			"type": "CNAME",
			"host": "%dkim1%._domainkey",
			"pointsTo": "%dkim1%.dkim.amazonses.com",
			"ttl": 3600
		},
		{
			"type": "CNAME",
			"host": "%dkim2%._domainkey",
			"pointsTo": "%dkim2%.dkim.amazonses.com",
			"ttl": 3600
		},
		{
			"type": "CNAME",
			"host": "%dkim3%._domainkey",
			"pointsTo": "%dkim3%.dkim.amazonses.com",
			"ttl": 3600
		},
		{
			"type": "MX",
			"host": "bounce",
			"pointsTo": "feedback-smtp.eu-north-1.amazonses.com",
			"priority": 10,
			"ttl": 3600
		},
		{
			"type": "SPFM",
			"host": "bounce",
			"spfRules": "include:amazonses.com"
		},
		{
			"type": "TXT",
			"host": "_amazonses.reply",
			"data": "%inboundtoken%",
			"ttl": 3600
		},
		{
			"type": "MX",
			"host": "reply",
			"pointsTo": "%inboundmx%",
			"priority": 10,
			"ttl": 3600
		}
	]
}
