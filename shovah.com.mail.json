{
  "providerId": "shovah.com",
  "providerName": "Shovah",
  "serviceId": "mail",
  "serviceName": "Shovah Mail",
  "version": 2,
  "description": "Connects a domain to Shovah mailboxes: MX, SPF (merged), DKIM, which also proves the ownership of the domain, DMARC, the settings records of mail programs and of calendar and contacts programs. Each group applies on its own: DMARC only when the domain has none, and MX only for a domain that receives mail.",
  "variableDescription": "%dnslabel%: the random label of the domain in the names of Shovah (letters and digits).",
  "syncBlock": false,
  "syncPubKeyDomain": "app.shovah.com",
  "syncRedirectDomain": "app.shovah.com",
  "records": [
    {
      "groupId": "mx",
      "type": "MX",
      "host": "@",
      "pointsTo": "mail.shovah.com",
      "ttl": 3600,
      "priority": 10
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "include:spf.shovah.com"
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "shovah1._domainkey",
      "pointsTo": "shovah1.%dnslabel%.dkim.shovah.com",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:%dnslabel%@dmarc.shovah.com",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "autoconfig",
      "type": "CNAME",
      "host": "autoconfig",
      "pointsTo": "mail.shovah.com",
      "ttl": 3600
    },
    {
      "groupId": "autoconfig",
      "type": "CNAME",
      "host": "autodiscover",
      "pointsTo": "mail.shovah.com",
      "ttl": 3600
    },
    {
      "groupId": "autoconfig",
      "type": "SRV",
      "name": "@",
      "service": "_imaps",
      "protocol": "_tcp",
      "target": "mail.shovah.com",
      "ttl": 3600,
      "priority": 0,
      "weight": 1,
      "port": 993
    },
    {
      "groupId": "autoconfig",
      "type": "SRV",
      "name": "@",
      "service": "_submissions",
      "protocol": "_tcp",
      "target": "mail.shovah.com",
      "ttl": 3600,
      "priority": 0,
      "weight": 1,
      "port": 465
    },
    {
      "groupId": "autoconfig",
      "type": "SRV",
      "name": "@",
      "service": "_submission",
      "protocol": "_tcp",
      "target": "mail.shovah.com",
      "ttl": 3600,
      "priority": 0,
      "weight": 1,
      "port": 587
    },
    {
      "groupId": "calendar",
      "type": "SRV",
      "name": "@",
      "service": "_caldavs",
      "protocol": "_tcp",
      "target": "mail.shovah.com",
      "ttl": 3600,
      "priority": 0,
      "weight": 1,
      "port": 443
    },
    {
      "groupId": "calendar",
      "type": "TXT",
      "host": "_caldavs._tcp",
      "data": "path=/.well-known/caldav",
      "ttl": 3600
    },
    {
      "groupId": "calendar",
      "type": "SRV",
      "name": "@",
      "service": "_carddavs",
      "protocol": "_tcp",
      "target": "mail.shovah.com",
      "ttl": 3600,
      "priority": 0,
      "weight": 1,
      "port": 443
    },
    {
      "groupId": "calendar",
      "type": "TXT",
      "host": "_carddavs._tcp",
      "data": "path=/.well-known/carddav",
      "ttl": 3600
    }
  ]
}
