{
  "providerId": "deployvera.com",
  "providerName": "DeployVera",
  "serviceId": "account-domain",
  "serviceName": "DeployVera hesap alan adı",
  "version": 1,
  "logoUrl": "https://deployvera.com/favicon.svg",
  "description": "Alan adını DeployVera hesabına bağlar: sahiplik TXT kaydı ve *.alan joker CNAME.",
  "variableDescription": "token: sahiplik doğrulama değeri; target: yönlendirme hedefi; ip: çıplak alan adı IPv4 adresi",
  "syncPubKeyDomain": "deployvera.com",
  "syncRedirectDomain": "deployvera.com",
  "records": [
    {
      "groupId": "ownership",
      "type": "TXT",
      "host": "_deployvera",
      "data": "%token%",
      "ttl": 300,
      "txtConflictMatchingMode": "None"
    },
    {
      "groupId": "wildcard",
      "type": "CNAME",
      "host": "*",
      "pointsTo": "%target%",
      "ttl": 300
    }
  ]
}
