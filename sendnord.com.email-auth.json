{
  "providerId": "sendnord.com",
  "providerName": "Sendnord",
  "serviceId": "email-auth",
  "serviceName": "Sendnord email authentication",
  "version": 1,
  "logoUrl": "https://app.sendnord.com/SendnordLogo1.png",
  "description": "Authenticates your domain for sending email with Sendnord: two DKIM records and a bounce domain, plus a DMARC policy when you don't have one.",
  "variableDescription": "rpn: the 3 digits of the bounce-domain label nord###; token: the domain's identity in the Sendnord delegation zone",
  "syncBlock": false,
  "shared": true,
  "sharedProviderName": true,
  "syncPubKeyDomain": "dc.sendnord.com",
  "syncRedirectDomain": "sendnord.com,app.sendnord.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "auth",
      "type": "CNAME",
      "host": "nord%rpn%",
      "pointsTo": "%token%.nordsender.se",
      "ttl": 3600
    },
    {
      "groupId": "auth",
      "type": "CNAME",
      "host": "nord1._domainkey",
      "pointsTo": "nord1.domainkey.%token%.nordsender.se",
      "ttl": 3600
    },
    {
      "groupId": "auth",
      "type": "CNAME",
      "host": "nord2._domainkey",
      "pointsTo": "nord2.domainkey.%token%.nordsender.se",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=quarantine; rua=mailto:dmarc@sendnord.com",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    }
  ]
}
