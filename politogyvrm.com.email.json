{
  "providerId": "politogyvrm.com",
  "providerName": "Politogy VRM",
  "serviceId": "email",
  "serviceName": "Politogy VRM email sending",
  "version": 1,
  "logoUrl": "https://politogyvrm.com/assets/logo-vrm-black.png",
  "description": "Lets Politogy VRM send email from your domain (or a subdomain such as mail.yourdomain.com): three DKIM signing CNAMEs, the MX and SPF for the bounce address on bounce.<domain>, and, only when the domain has no DMARC record, a monitoring-only DMARC policy (p=none). Nothing on your main domain's SPF or MX is changed.",
  "variableDescription": "dkim1, dkim2, dkim3: the three DKIM tokens Amazon SES issued for this domain (32 lowercase letters and digits each). Each becomes <token>._domainkey CNAME <token>.dkim.amazonses.com.",
  "syncPubKeyDomain": "politogyvrm.com",
  "syncRedirectDomain": "settings.politogyvrm.com",
  "records": [
    {
      "groupId": "signing",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "signing",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "signing",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "bounce",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.us-east-1.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "bounce",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "policy",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none; rua=mailto:dmarc-reports@politogyvrm.com; fo=1",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply",
      "ttl": 3600
    }
  ]
}
