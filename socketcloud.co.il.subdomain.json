{
  "providerId": "socketcloud.co.il",
  "providerName": "Socket Cloud",
  "serviceId": "subdomain",
  "serviceName": "Socket Cloud web hosting (subdomain)",
  "version": 1,
  "logoUrl": "https://socketcloud.co.il/logo.png",
  "description": "Points a subdomain at a Socket Cloud hosted website and proves it is yours.",
  "variableDescription": "token: the ownership token Socket Cloud shows for this hostname",
  "syncBlock": false,
  "syncPubKeyDomain": "socketcloud.co.il",
  "syncRedirectDomain": "socketcloud.co.il",
  "hostRequired": true,
  "records": [
    {
      "type": "CNAME",
      "host": "@",
      "pointsTo": "edge.socketcloud.co.il",
      "ttl": 3600
    },
    {
      "type": "TXT",
      "host": "_socketcloud",
      "data": "socketcloud-verify=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    }
  ]
}
