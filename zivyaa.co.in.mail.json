{
  "providerId": "zivyaa.co.in",
  "providerName": "Zivyaa",
  "serviceId": "mail",
  "serviceName": "Zivyaa Office and Mail",
  "version": 1,
  "logoUrl": "https://zivyaa.co.in/Zivyaa_logo.png",
  "description": "Connects a company's domain to Zivyaa Mail and Zivyaa Office: ownership, incoming mail (MX), sender policy (SPF), signing keys (DKIM), DMARC, MTA-STS, TLS reports and the company's own letter verification address. Each group is applied only when the service needs it.",
  "variableDescription": "verify: ownership token; mx1..mx3: receiving hosts; spf: SPF include terms; dkimN_host / dkimN: DKIM CNAME name and target; dkim_txt_host / dkim_txt: DKIM TXT key; dmarc: the whole DMARC record (existing report addresses kept); sts_id: MTA-STS policy id; verify_host: the company's verification sub-domain label; tlsrpt: TLS-RPT record.",
  "syncBlock": false,
  "syncPubKeyDomain": "zivyaa.co.in",
  "syncRedirectDomain": "zivyaa.co.in",
  "hostRequired": false,
  "records": [
    {
      "groupId": "verify",
      "type": "TXT",
      "host": "@",
      "data": "zivyaa-verify=%verify%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "zivyaa-verify=",
      "ttl": 3600
    },
    {
      "groupId": "mx1",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mx1%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mx2",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mx2%",
      "priority": 20,
      "ttl": 3600
    },
    {
      "groupId": "mx3",
      "type": "MX",
      "host": "@",
      "pointsTo": "%mx3%",
      "priority": 30,
      "ttl": 3600
    },
    {
      "groupId": "spf",
      "type": "SPFM",
      "host": "@",
      "spfRules": "%spf%"
    },
    {
      "groupId": "dkim1",
      "type": "CNAME",
      "host": "%dkim1_host%._domainkey",
      "pointsTo": "%dkim1%",
      "ttl": 3600
    },
    {
      "groupId": "dkim2",
      "type": "CNAME",
      "host": "%dkim2_host%._domainkey",
      "pointsTo": "%dkim2%",
      "ttl": 3600
    },
    {
      "groupId": "dkim3",
      "type": "CNAME",
      "host": "%dkim3_host%._domainkey",
      "pointsTo": "%dkim3%",
      "ttl": 3600
    },
    {
      "groupId": "dkimtxt",
      "type": "TXT",
      "host": "%dkim_txt_host%._domainkey",
      "data": "%dkim_txt%",
      "txtConflictMatchingMode": "All",
      "ttl": 3600
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "%dmarc%",
      "txtConflictMatchingMode": "All",
      "essential": "OnApply",
      "ttl": 3600
    },
    {
      "groupId": "mtasts",
      "type": "TXT",
      "host": "_mta-sts",
      "data": "v=STSv1; id=%sts_id%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=STSv1",
      "ttl": 3600
    },
    {
      "groupId": "mtasts",
      "type": "CNAME",
      "host": "mta-sts",
      "pointsTo": "domains.zivyaa.co.in",
      "ttl": 3600
    },
    {
      "groupId": "tlsrpt",
      "type": "TXT",
      "host": "_smtp._tls",
      "data": "%tlsrpt%",
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=TLSRPTv1",
      "ttl": 3600
    },
    {
      "groupId": "verifyhost",
      "type": "CNAME",
      "host": "%verify_host%",
      "pointsTo": "domains.zivyaa.co.in",
      "ttl": 3600
    }
  ]
}
